{
  "schemaVersion": 1,
  "id": "ewe.screenshot",
  "name": "Screenshot",
  "version": "1.1.0",
  "apiVersion": 2,
  "description": "A camera in the bar and the Print keys: region, screen or window to ~/Pictures/Screenshots, with a draggable preview stack.",
  "homepage": "https://github.com/prj786/ewe-plugin-screenshot",
  "author": "prj786",
  "kinds": [
    "bar-widget",
    "panel"
  ],
  "entryPoints": {
    "bar-widget": "Widget.qml",
    "panel": "Preview.qml"
  },
  "barWidget": {
    "defaultSection": "right"
  },
  "keybinds": [
    {
      "combo": "Print",
      "ipc": "ewe.screenshot shoot full"
    },
    {
      "combo": "SHIFT + Print",
      "ipc": "ewe.screenshot shoot region"
    },
    {
      "combo": "SUPER + Print",
      "ipc": "ewe.screenshot shoot activewindow"
    }
  ],
  "settings": [
    {
      "key": "copy",
      "type": "bool",
      "default": true,
      "label": "Also copy the shot to the clipboard"
    }
  ]
}
