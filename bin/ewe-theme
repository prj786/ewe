<script>
const T = __TOKENS_JSON__;
document.getElementById("sub").textContent =
  T.input.scheme_name + "  \\u00b7  accent " + T.input.accent + "  \\u00b7  corner " + T.input.corner +
  "  \\u00b7  density " + T.input.density + "  \\u00b7  stroke " + T.input.stroke +
  "  \\u00b7  bar_opacity " + T.input.bar_opacity + (T.adjusted.length ? "  \\u00b7  adjusted: " + T.adjusted.map(a => a.role).join(", ") : "");
const bar = (o) => Object.entries(o).map(([k,v]) =>
  `<span style="background:${v}"><b class="caption">${k}</b></span>`).join("");
document.getElementById("brand").innerHTML = bar(T.brand);
document.getElementById("grey").innerHTML  = bar(T.grey);
document.getElementById("type").innerHTML = Object.keys(T.type.styles).map(n =>
  `<div class="${n}">The quick brown sheep &mdash; ${n} <code class="caption">${T.type.styles[n].size}/${T.type.styles[n].lineHeight} ${T.type.styles[n].weight}</code></div>`).join("");
const roles = Object.keys(T.color);
document.getElementById("all").innerHTML = roles.map(k =>
  `<div><s style="background:${T.color[k]}"></s>--${k}<br>${T.color[k]}</div>`).join("");
document.getElementById("dens").innerHTML =
  Object.entries(Object.assign({}, T.shape, T.size))
    .map(([k,v]) => `<div><b>${v}px</b> --${k}</div>`).join("");
</script>
"""


def cmd_preview(a):
    """A specimen page generated FROM the tokens — what you look at is what
    the shell and the apps render, not a mock-up."""
    cfg, src = read_conf(a.conf)
    t = tokens(cfg)
    css = gen_css(t) + "\n:root { --dur-fast: %dms; }\n" % t["motion"]["durFast"]
    html = (SPECIMEN.replace("__TOKENS__", css)
                    .replace("__TOKENS_JSON__", json.dumps({
                        "input": t["input"], "color": {k: color_css(t, k) for k in t["color"]},
                        "shape": t["shape"], "size": t["size"], "type": t["type"],
                        "brand": t["brand"], "grey": t["grey"], "adjusted": t["adjusted"]})))
    target = a.out or os.path.join(HERE, "design", "specimen.html")
    _write(target, html)
    out({"ok": True, "path": target, "conf": src, "accent": t["input"]["accent"]})


def main():
    p = argparse.ArgumentParser(add_help=True)
    p.add_argument("--conf", help="read ewe.conf from this path")
    sub = p.add_subparsers(dest="cmd")
    # --conf is accepted on either side of the subcommand: `ewe-theme --conf F
    # build` and `ewe-theme build --conf F` both read the same flag, because
    # requiring one order is the kind of thing you get wrong at 2am.
    def add(name, *args):
        s = sub.add_parser(name)
        s.add_argument("--conf")
        for x in args:
            s.add_argument(x)
        return s
    # `show` takes an optional positional, ignored: installed app binaries call
    # `ewe-theme show <look>` from when there were two looks, and an argparse
    # error there would leave them with no tokens at all.
    add("show").add_argument("legacy_look", nargs="?")
    b = add("build", "--json", "--css")
    b.add_argument("--scheme", help="build the CSS for this scheme (design-time; ewe.conf untouched)")
    b.add_argument("--selector", help="wrap the CSS in this selector instead of :root")
    add("check", "--json", "--css")
    add("preview", "--out")
    sp = sub.add_parser("scheme", help="named / imported / wallpaper palettes")
    sp.add_argument("--conf")
    sp.add_argument("--no-hooks", action="store_true", dest="no_hooks",
                    help="write ewe.conf without the colorscheme + reload pokes")
    ss = sp.add_subparsers(dest="scheme_cmd")
    ss.add_parser("list")
    ss.add_parser("show").add_argument("slug", nargs="?")
    ss.add_parser("apply").add_argument("slug", help="ewe-dark, ewe-light or a user scheme slug")
    si = ss.add_parser("import")
    si.add_argument("path", help="base16/base24 YAML, Omarchy colors.toml, Catppuccin palette.json, Gogh yml — file or URL")
    si.add_argument("--name")
    si.add_argument("--slug", dest="slug_opt")
    si.add_argument("--accent")
    si.add_argument("--flavour", help="Catppuccin: latte / frappe / macchiato / mocha")
    si.add_argument("--apply", action="store_true")
    sd = ss.add_parser("duplicate")
    sd.add_argument("slug", help="the scheme to copy (a built-in or a user scheme)")
    sd.add_argument("--name")
    sd.add_argument("--slug", dest="slug_opt")
    sd.add_argument("--apply", action="store_true")
    ss.add_parser("remove").add_argument("slug")
    ss.add_parser("export").add_argument("slug", nargs="?")
    st = ss.add_parser("set")
    st.add_argument("field", help="accent, name, variant, semantic, base00…base17, overrides.<role>")
    st.add_argument("value")
    st.add_argument("--slug", dest="slug_opt")
    sw = ss.add_parser("from-wallpaper")
    sw.add_argument("--path")
    sw.add_argument("--name")
    sw.add_argument("--light", action="store_true")
    sw.add_argument("--apply", action="store_true")
    sw.add_argument("--if-changed", action="store_true", dest="if_changed",
                    help="no-op when the wallpaper scheme already comes from this image")
    a = p.parse_args()
    if getattr(a, "conf", None) is None:
        # The subparser carries its own --conf, and argparse writes its
        # default (None) into the SAME namespace — wiping a value given
        # before the subcommand. Re-reading with `p` cannot recover it: `p`
        # knows the subcommands too, so it wipes the value all over again.
        # A parser that knows only the flag is the one that can.
        pre = argparse.ArgumentParser(add_help=False)
        pre.add_argument("--conf")
        a.conf = pre.parse_known_args()[0].conf
    {"show": cmd_show, "build": cmd_build, "check": cmd_check,
     "preview": cmd_preview, "scheme": cmd_scheme}.get(a.cmd or "show", cmd_show)(a)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
