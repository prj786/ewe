# ═══ the two built-in schemes (design/system/assets/Schemes) ═══════════════
# Plain Base24 records, identical to the shipped YAML/JSON (tests hold them
# to it): palette + accent, nothing else — no overrides, so every role they
# show is the derivation's. They are not written into ewe.conf: the tool
# knows them, so a synced or hand-edited file can never corrupt or lose them.
BUILTIN_SCHEMES = [
    {"slug": "ewe-dark", "name": "Ewe Dark", "author": "ewe", "variant": "dark", "builtin": True,
     "accent": EWELLOW, "semantic": True,
     "palette": {"base00": "#0b0a08", "base01": "#151411", "base02": "#2c2a26", "base03": "#5d5a55",
                 "base04": "#a8a49d", "base05": "#faf9f6", "base06": "#d5d2cb", "base07": "#fefdfc",
                 "base08": "#ffa196", "base09": "#f9a870", "base0A": "#eeb407", "base0B": "#69d6aa",
                 "base0C": "#64d1d7", "base0D": "#76c7ff", "base0E": "#e0a4ee", "base0F": "#805708",
                 "base10": "#020202", "base11": "#020202", "base12": "#febfb7", "base13": "#ffc29a",
                 "base14": "#7deabd", "base15": "#79e5eb", "base16": "#a3d8ff", "base17": "#f1bafe"}},
    {"slug": "ewe-light", "name": "Ewe Light", "author": "ewe", "variant": "light", "builtin": True,
     "accent": EWELLOW, "semantic": True,
     "palette": {"base00": "#f4f2ee", "base01": "#faf9f6", "base02": "#e9e6e0", "base03": "#a8a49d",
                 "base04": "#5d5a55", "base05": "#0b0a08", "base06": "#423f3a", "base07": "#fefdfc",
                 "base08": "#a04038", "base09": "#964d09", "base0A": "#eeb407", "base0B": "#047554",
                 "base0C": "#057176", "base0D": "#026a9d", "base0E": "#814a8d", "base0F": "#805708",
                 "base10": "#e9e6e0", "base11": "#d5d2cb", "base12": "#8c2e28", "base13": "#7f3f02",
                 "base14": "#016245", "base15": "#035e62", "base16": "#025884", "base17": "#6f397b"}},
]
BUILTIN_BY_SLUG = {s["slug"]: s for s in BUILTIN_SCHEMES}
DEFAULT_SCHEME = "ewe-dark"
LEGACY_SCHEME = "accent"    # pre-v3 "derive everything from the accent" = Ewe Dark

# the colour ROLES a scheme may override, in emission order
SURFACES = ["surface-base", "surface-raised", "surface-overlay", "surface-sunken",
            "surface-hover", "surface-pressed", "surface-selected"]
RESTING = [s for s in SURFACES if s != "surface-pressed"]   # text of every kind sits here
STATUS = ["success", "warning", "danger", "info"]
ROLES = (SURFACES + ["border-subtle", "border-strong", "text-primary", "text-secondary",
                     "text-muted", "text-disabled", "accent", "accent-hover", "accent-pressed",
                     "on-accent", "accent-subtle", "accent-text", "focus-ring"]
         + STATUS + [s + "-subtle" for s in STATUS] + ["on-status", "glass-accent"])
TEXT_ROLES = ["text-primary", "text-secondary", "text-muted", "accent-text"] + STATUS
ACCENT_ROLES = ["accent", "accent-hover", "accent-pressed", "on-accent", "accent-subtle",
                "accent-text", "focus-ring", "glass-accent"]


# ═══ one black, one white ══════════════════════════════════════════════════
L_FLOOR = oklch(BLACK)[0]           # nothing emitted is darker than `black`
L_CEIL = oklch(NEUTRAL[0])[0]       # nothing emitted is lighter than `neutral-0`


def in_range(hexv):
    """`hexv`, or `black` / `neutral-0` when it lies beyond them."""
    L = oklch(hexv)[0]
    if L < L_FLOOR - 1e-6:
        return BLACK
    if L > L_CEIL + 1e-6:
        return NEUTRAL[0]
    return hexv


def at_l(hexv, L):
    """`hexv` at lightness L (hue and chroma kept), inside the range."""
    _, C, H = oklch(hexv)
    return in_range(oklch_hex(max(L_FLOOR, min(L_CEIL, L)), C, H))


# ═══ the accent ramp ═══════════════════════════════════════════════════════
def _ramp_profile():
    """The reference ramp as (L, chroma ratio to step 500, hue delta)."""
    L5, C5, H5 = oklch(REF_RAMP[500])
    prof = {}
    for step, hx in REF_RAMP.items():
        L, C, H = oklch(hx)
        prof[step] = (L, C / C5, ((H - H5 + 180) % 360) - 180)
    return prof


PROFILE = _ramp_profile()


def accent_ramp_lch(accent):
    """Every step as OKLCH: the reference ladder re-anchored so the accent
    lands exactly on 500, chroma scaled by the accent's own, hue drifting
    as the reference does."""
    L0, C0, H0 = oklch(accent)
    La = PROFILE[500][0]
    steps = {}
    for step, (L, cr, dh) in PROFILE.items():
        Ls = L0 + (100 - L0) * (L - La) / (100 - La) if L >= La else L0 * L / La
        steps[step] = (Ls, C0 * cr, (H0 + dh) % 360)
    return steps


def accent_ramp(accent):
    steps = accent_ramp_lch(accent)
    ramp = {s: oklch_hex(*v) for s, v in steps.items()}
    ramp[500] = _hex6(accent)              # the anchor is the accent itself
    return ramp


# ═══ SCHEMES — Base24 records ══════════════════════════════════════════════
SCHEME_KEYS = ["base%02X" % i for i in range(0x18)]
SCHEME_REQUIRED = SCHEME_KEYS[:16]


def _hex6(v):
    """'#abc' / 'abcdef' / '#AABBCC' → '#aabbcc', else None."""
    if not isinstance(v, str):
        return None
    h = v.strip().lstrip("#").lower()
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    if len(h) != 6 or any(c not in "0123456789abcdef" for c in h):
        return None
    return "#" + h


def slugify(name):
    out = "".join(c.lower() if c.isalnum() else "-" for c in str(name)).strip("-")
    while "--" in out:
        out = out.replace("--", "-")
    return out or "scheme"


def _truthy(v, default=True):
    if isinstance(v, bool):
        return v
    if v is None:
        return default
    return str(v).strip().lower() not in ("0", "false", "no", "off", "")


def norm_scheme(rec, builtin=False):
    """A scheme record (a [[desktop.theme.schemes]] entry or an imported
    file), validated; None if unusable. `builtin` is only ever set for the
    two shipped schemes — a file that says builtin: true is just a file."""
    pal_in = rec.get("palette") if isinstance(rec.get("palette"), dict) else {}
    pal = {}
    for k in SCHEME_KEYS:
        v = _hex6(pal_in.get(k) or pal_in.get(k.lower()))
        if v:
            pal[k] = v
    if any(k not in pal for k in SCHEME_REQUIRED):
        return None
    name = str(rec.get("name") or "").strip() or "Untitled"
    variant = "light" if str(rec.get("variant", "dark")).lower() == "light" else "dark"
    out = {"name": name, "slug": slugify(rec.get("slug") or name), "variant": variant,
           "palette": pal, "semantic": _truthy(rec.get("semantic"), True)}
    acc = _hex6(rec.get("accent"))
    if acc:
        out["accent"] = acc
    ov_in = rec.get("overrides") if isinstance(rec.get("overrides"), dict) else {}
    ov = {}
    for k, v in ov_in.items():
        hv = _hex6(v)
        if k in ROLES and hv:
            ov[k] = hv
    if ov:
        out["overrides"] = ov
    for k in ("author", "source", "wallpaper"):
        if rec.get(k):
            out[k] = str(rec[k])
    if builtin:
        out["builtin"] = True
    return out


BUILTINS = [norm_scheme(s, builtin=True) for s in BUILTIN_SCHEMES]


def all_schemes(cfg):
    """Built-ins first, then the user's — the order Settings lists them."""
    return BUILTINS + list(cfg.get("schemes") or [])


def find_scheme(cfg, slug):
    if slug == LEGACY_SCHEME:
        slug = DEFAULT_SCHEME
    for sc in all_schemes(cfg):
        if sc["slug"] == slug:
            return sc
    return None


def active_scheme(cfg):
    return find_scheme(cfg, cfg.get("scheme") or DEFAULT_SCHEME) or find_scheme(cfg, DEFAULT_SCHEME)


def scheme_accent(sc, cfg):
    """The accent this scheme wears. A built-in wears the person's
    `desktop.theme.accent` (that is what "pick an accent" means); a user
    scheme wears its own `accent` key, else its base0A."""
    if sc.get("builtin"):
        return _hex6(cfg.get("accent")) or DEFAULTS["accent"]
    return sc.get("accent") or sc["palette"]["base0A"]


# ═══ reading the one config ═══════════════════════════════════════════════
def read_conf(path=None):
    """`[desktop.theme]`, `[desktop.bar]`, `[desktop.accessibility]` and the
    animation speed out of ewe.conf. Missing file, section or key falls
    back to DEFAULTS — a fresh machine still themes."""
    p = path or EWE_CONF
    cfg = dict(DEFAULTS)
    src = "defaults"
    doc = {}
    if os.path.isfile(p):
        try:
            with open(p, "rb") as f:
                doc = tomllib.load(f)
            src = p
        except (tomllib.TOMLDecodeError, OSError):
            doc = {}  # a broken conf must never leave the desktop unthemed
    desk = doc.get("desktop") if isinstance(doc.get("desktop"), dict) else {}
    t = desk.get("theme") if isinstance(desk.get("theme"), dict) else {}
    for k in ("accent", "scheme", "corner", "density", "stroke", "neutral_tint",
              "bar_opacity", "app_blur", "window_transparency"):
        if k in t:
            cfg[k] = t[k]
    bar = desk.get("bar") if isinstance(desk.get("bar"), dict) else {}
    if bar.get("icon_size") in BAR:
        cfg["bar_icon_size"] = bar["icon_size"]
    # the v3 `size = large` (no longer written) reads as icon_size = large
    # unless icon_size says something other than the default
    if bar.get("size") == "large" and cfg["bar_icon_size"] == "normal":
        cfg["bar_icon_size"] = "large"
    a11y = desk.get("accessibility") if isinstance(desk.get("accessibility"), dict) else {}
    for k in ("reduce_motion", "reduce_transparency", "increase_contrast"):
        cfg[k] = _truthy(a11y.get(k), False)
    try:
        cfg["text_scale"] = int(a11y.get("text_scale", 100))
    except (TypeError, ValueError):
        cfg["text_scale"] = 100
    if cfg["text_scale"] not in TEXT_SCALES:
        cfg["text_scale"] = min(TEXT_SCALES, key=lambda s: abs(s - cfg["text_scale"]))
    anim = desk.get("animations") if isinstance(desk.get("animations"), dict) else {}
    try:
        cfg["speed"] = max(0.0, float(anim.get("speed", 1)))
    except (TypeError, ValueError):
        cfg["speed"] = 1.0
    if not _hex6(cfg["accent"]):
        cfg["accent"] = DEFAULTS["accent"]
    cfg["accent"] = _hex6(cfg["accent"])
    cfg["scheme"] = str(cfg.get("scheme") or DEFAULT_SCHEME).strip() or DEFAULT_SCHEME
    raw = t.get("schemes") or []
    user = [x for x in (norm_scheme(r) for r in raw if isinstance(r, dict)) if x]
    cfg["schemes"] = [s for s in user if s["slug"] not in BUILTIN_BY_SLUG]
    if not find_scheme(cfg, cfg["scheme"]):
        cfg["scheme"] = DEFAULT_SCHEME      # a slug nothing matches: Ewe Dark, never unthemed
    cfg["corner"] = CORNER_LEGACY.get(cfg["corner"], cfg["corner"])
    for k, table in (("corner", CORNER), ("density", DENSITY), ("stroke", STROKE)):
        if cfg[k] not in table:
            cfg[k] = DEFAULTS[k]
    try:
        cfg["neutral_tint"] = max(0, min(40, int(cfg["neutral_tint"])))
    except (TypeError, ValueError):
        cfg["neutral_tint"] = DEFAULTS["neutral_tint"]
    try:
        cfg["bar_opacity"] = max(0, min(100, int(cfg["bar_opacity"])))
    except (TypeError, ValueError):
        cfg["bar_opacity"] = DEFAULTS["bar_opacity"]
    cfg["app_blur"] = _truthy(cfg.get("app_blur"), False)
    cfg["window_transparency"] = _truthy(cfg.get("window_transparency"), False)
    # 0.12.8's one-release `surface = "glass"` reads as the Glass preset
    if str(t.get("surface", "solid")) == "glass" and cfg["bar_opacity"] == 100:
        cfg["bar_opacity"] = GLASS_PRESET
    return cfg, src


# ═══ role derivation ═══════════════════════════════════════════════════════
def derive_roles(sc, accent):
    """Every colour role from the scheme's palette and the accent, per the
    role table in 10-color-schemes.md. Returns (colors, alpha): `alpha`
    carries the opacity of the roles that are translucent (scrim)."""
    p = sc["palette"]
    variant = sc["variant"]
    dark = variant == "dark"
    c = {"ewellow": EWELLOW, "black": BLACK}
    ramp = accent_ramp(accent)
    for s in RAMP_STEPS:
        c["ewellow-%d" % s] = ramp[s]
    for k, v in NEUTRAL.items():
        c["neutral-%d" % k] = v
    sunken = p.get("base10") or ok_shift(p["base00"], -SUNKEN_DL)
    pressed = ok_toward(p["base02"], p["base05"], PRESSED_DL[variant])
    if dark:
        c.update({
            "surface-base": p["base00"], "surface-raised": p["base01"],
            "surface-overlay": ok_mix(p["base01"], p["base02"], 0.5),
            "surface-sunken": sunken, "surface-hover": p["base02"],
            "surface-pressed": pressed,
            "surface-selected": p["base02"], "border-subtle": p["base02"],
            "border-strong": ok_mix(p["base03"], p["base04"], 0.5)})
    else:
        # base07 is the lightest surface in Ewe Light's palette. A light
        # scheme in the Base16 convention runs the other way (base07 is its
        # darkest ink, Solarized Light: #002b36), and a black menu is not a
        # menu — then the overlay is the ground lifted toward white instead.
        top = p["base07"] if oklch(p["base07"])[0] >= oklch(p["base00"])[0] else ok_shift(p["base00"], SURFACE_STEP)
        c.update({
            "surface-base": p["base00"], "surface-raised": p["base01"],
            "surface-overlay": top, "surface-sunken": sunken,
            "surface-hover": p["base02"],
            "surface-pressed": pressed,
            "surface-selected": top,
            "border-subtle": ok_mix(p["base02"], p["base03"], BORDER_SUBTLE_MIX),
            "border-strong": ok_mix(p["base03"], p["base04"], 0.5)})
    c.update({"text-primary": p["base05"], "text-secondary": p["base06"],
              "text-muted": p["base04"], "text-disabled": p["base03"]})
    # the accent roles are steps of the ramp generated from the accent
    c["accent"] = ramp[500]
    for role in ("accent-hover", "accent-pressed", "on-accent", "accent-subtle",
                 "accent-text", "focus-ring", "glass-accent"):
        c[role] = ramp[ACCENT_STEP[variant][role]] if role != "on-accent" else None
    if sc.get("semantic", True):
        c.update({"danger": p["base08"], "warning": p["base09"],
                  "success": p["base0B"], "info": p["base0D"]})
    else:
        c.update(EWE_STATUS[variant])
    alpha = {"scrim": SCRIM_ALPHA[variant]}
    c["scrim"] = (p.get("base11") or BLACK) if dark else p["base05"]
    for k in c:                      # one black, one white
        if c[k]:
            c[k] = in_range(c[k])
    c["on-accent"] = on_color(c["accent"])
    return c, alpha


def status_subtle(color, variant):
    """A status colour as a tinted ground: at the subtle L, chroma capped."""
    Ls, Cmax = STATUS_SUBTLE[variant]
    L, C, H = oklch(color)
    return in_range(oklch_hex(Ls, min(C, Cmax), H))


def finish_status(c, variant):
    for s in STATUS:
        c[s + "-subtle"] = status_subtle(c[s], variant)
    # one on-status for the four fills: black or neutral-0, whichever holds
    # best on all four
    c["on-status"] = max((BLACK, NEUTRAL[0]),
                         key=lambda cand: min(contrast(c[s], cand) for s in STATUS))


# ═══ the guarantees ════════════════════════════════════════════════════════
def ensure_contrast(c, role, surfaces, target, adjusted, why):
    """Move `role`'s lightness, hue held, until it reaches `target` against
    every surface named. Direction: away from the surfaces' mean lightness,
    then the other way if that runs out of room. The room ends at `black`
    and `neutral-0`."""
    worst = min(contrast(c[role], c[s]) for s in surfaces)
    if worst >= target - 1e-9:
        return
    L, C, H = oklch(c[role])
    mean = sum(oklch(c[s])[0] for s in surfaces) / len(surfaces)
    first = 1 if L >= mean else -1
    for direction in (first, -first):
        for step in range(1, 101):
            Ln = L + direction * step
            if not L_FLOOR <= Ln <= L_CEIL:
                break
            cand = in_range(oklch_hex(Ln, C, H))
            if min(contrast(cand, c[s]) for s in surfaces) >= target:
                adjusted.append({"role": role, "from": c[role], "to": cand,
                                 "why": "%s (was %.2f:1)" % (why, worst)})
                c[role] = cand
                return
        # the last step inside the range, before turning round
        edge = L_CEIL if direction > 0 else L_FLOOR
        cand = at_l(c[role], edge)
        if min(contrast(cand, c[s]) for s in surfaces) >= target:
            adjusted.append({"role": role, "from": c[role], "to": cand,
                             "why": "%s (was %.2f:1)" % (why, worst)})
            c[role] = cand
            return
    adjusted.append({"role": role, "from": c[role], "to": c[role],
                     "why": "%s — could not be reached by moving lightness alone (%.2f:1)" % (why, worst)})


def guarantees(c, variant, accent, adjusted):
    dark = variant == "dark"
    # 1. surfaces stay apart: each differs from the surface below by 2 L, as
    #    far as the range between black and neutral-0 allows. A surface that
    #    already sits as far off as that range lets it stays where it is —
    #    the rule is met, nothing is invented beyond the range.
    for below, role in (("surface-base", "surface-raised"), ("surface-raised", "surface-overlay"),
                        ("surface-raised", "surface-hover")):
        Lb, L = oklch(c[below])[0], oklch(c[role])[0]
        if abs(L - Lb) >= SURFACE_STEP - 0.05:
            continue
        sign = (1 if L > Lb else -1) if abs(L - Lb) > 1e-6 else (1 if dark else -1)
        want = max(L_FLOOR, min(L_CEIL, Lb + sign * SURFACE_STEP))
        if abs(want - Lb) <= abs(L - Lb) + 0.05:
            continue                 # no room left: as far apart as the palette allows
        new = at_l(c[role], want)
        if new != c[role]:
            adjusted.append({"role": role, "from": c[role], "to": new,
                             "why": "at least %g L from %s" % (SURFACE_STEP, below)})
            c[role] = new
    # 2. warning never looks like the accent
    La, Ca, Ha = oklch(accent)
    Lw, Cw, Hw = oklch(c["warning"])
    if Ca > 0.02 and Cw > 0.02:
        d = ((Hw - Ha + 180) % 360) - 180
        if abs(d) < WARNING_HUE_GAP:
            toward = ((RED_HUE - Ha + 180) % 360) - 180
            sign = 1 if toward >= 0 else -1
            new = in_range(oklch_hex(Lw, Cw, (Ha + sign * WARNING_HUE_GAP) % 360))
            adjusted.append({"role": "warning", "from": c["warning"], "to": new,
                             "why": "hue within %g° of the accent; turned toward red" % WARNING_HUE_GAP})
            c["warning"] = new
    # 3. text reads on every surface role; pressed carries primary/secondary
    for role in TEXT_ROLES:
        ensure_contrast(c, role, RESTING, CONTRAST_TEXT, adjusted,
                        "%g:1 on every surface" % CONTRAST_TEXT)
    for role in ("text-primary", "text-secondary"):
        ensure_contrast(c, role, ["surface-pressed"], CONTRAST_TEXT, adjusted,
                        "%g:1 on surface-pressed" % CONTRAST_TEXT)
    # 4. control outlines and the focus ring are visible on every surface
    for role in ("border-strong", "focus-ring"):
        ensure_contrast(c, role, RESTING, CONTRAST_BORDER, adjusted,
                        "%g:1 on every surface" % CONTRAST_BORDER)


def scheme_colors(sc, accent):
    """derive -> overrides -> guarantees. The finished role set and the list
    of what the guarantees had to move."""
    c, alpha = derive_roles(sc, accent)
    ov = {k: in_range(v) for k, v in (sc.get("overrides") or {}).items()}
    for k, v in ov.items():
        if k not in STATUS_FINISH:
            c[k] = v
    adjusted = []
    guarantees(c, sc["variant"], accent, adjusted)
    # glass-accent is accent-text inside glass: where they are the same
    # ramp step (the dark), it follows accent-text through the guarantees
    steps = ACCENT_STEP[sc["variant"]]
    if "glass-accent" not in ov and steps["glass-accent"] == steps["accent-text"]:
        c["glass-accent"] = c["accent-text"]
    finish_status(c, sc["variant"])
    for k in STATUS_FINISH:
        if k in ov:
            c[k] = ov[k]
    return c, alpha, adjusted


# roles finish_status writes, so an override of them is applied after it
STATUS_FINISH = ["on-status"] + [s + "-subtle" for s in STATUS]


def shadow_color(c, sc):
    """Shadows: `black` in the dark, the scheme's darkest ink (base05) in
    the light."""
    return BLACK if sc["variant"] == "dark" else in_range(sc["palette"]["base05"])


def gradients(c):
    """The four gradients, from the ramp and the surfaces (see GRADIENT_ANGLE)."""
    fa, fb = GRADIENT_EWELLOW_MIX
    _, Cs, Hs = oklch(c["accent-subtle"])
    Lr = oklch(c["surface-raised"])[0]
    ember = in_range(oklch_hex(Lr, Cs * EMBER_TINT, Hs))
    return {
        "gradient-ewellow": {"kind": "linear", "angle": GRADIENT_ANGLE["gradient-ewellow"], "stops": [
            [in_range(ok_mix(c["ewellow-400"], c["accent"], fa)), 1, 0],
            [in_range(ok_mix(c["accent"], c["ewellow-600"], fb)), 1, 100]]},
        "gradient-ember": {"kind": "linear", "angle": GRADIENT_ANGLE["gradient-ember"], "stops": [
            [ember, 1, 0], [c["surface-base"], 1, 100]]},
        "gradient-night": {"kind": "linear", "angle": GRADIENT_ANGLE["gradient-night"], "stops": [
            [c["surface-raised"], 1, 0], [c["surface-base"], 1, 100]]},
        "gradient-glow": {"kind": "radial", "at": "50% 0%", "stops": [
            [c["accent"], GLOW_ALPHA, 0], [c["accent"], 0, 60]]},
    }

# ═══ the token set ═════════════════════════════════════════════════════════
def _scale(px, pct):
    return int(round(px * pct / 100.0))


def tokens(cfg):
    """The whole token set, derived. This is the only place it is decided."""
    cfg = dict(cfg)
    schemes = cfg.pop("schemes", [])
    sc = active_scheme(dict(cfg, schemes=schemes))
    variant = sc["variant"]
    dark = variant == "dark"
    accent = in_range(scheme_accent(sc, cfg))
    color, alpha, adjusted = scheme_colors(sc, accent)
    cfg.update({"accent": accent, "variant": variant, "scheme_name": sc["name"],
                "scheme_slug": sc["slug"]})
    inc, red_t = cfg["increase_contrast"], cfg["reduce_transparency"]

    # ── accessibility: Increase contrast remaps roles (AccessibilityModes) ──
    if inc:
        color["border-subtle"] = color["border-strong"]
        color["text-muted"] = color["text-secondary"]
        color["surface-hover"] = color["surface-pressed"]

    # ── Glass (components/Glass): the bar, dock and lock card's roles ──────
    op = cfg["bar_opacity"]
    glass_solid = inc or red_t
    glass_alpha = 1.0 if glass_solid else (op / 100.0 if op < 100 else OPACITY["opacity-glass"])
    tint = max((in_range(sc["palette"]["base05"]), in_range(sc["palette"]["base07"])),
               key=lambda h: contrast(h, color["surface-base"]))
    ga = GLASS_ALPHA[variant]
    if glass_solid:
        color.update({"glass-base": color["surface-base"], "glass-raised": color["surface-raised"],
                      "glass-border": color["border-subtle"], "glass-hover": color["surface-hover"],
                      "glass-pressed": color["surface-pressed"]})
    else:
        color.update({"glass-base": color["surface-base"], "glass-raised": color["surface-raised"],
                      "glass-border": tint, "glass-hover": tint, "glass-pressed": tint})
        alpha.update({"glass-base": glass_alpha, "glass-raised": glass_alpha,
                      "glass-border": ga["border"], "glass-hover": ga["hover"],
                      "glass-pressed": ga["pressed"]})
    # glass-accent (scheme_colors): accent-text in the dark; ewellow-900 in
    # the light, so it keeps 4.5:1 over a bright wallpaper
    if not glass_solid and op < 100:
        # The Glass contrast rule (Glass card), applied while Glass is in
        # use: at the preset, text-primary, text-secondary and glass-accent
        # hold 4.5:1 and status glyphs 3:1 over the glass fill composited on
        # white AND black (test backgrounds only, never emitted). Lightness
        # moves away from the fill, hue stays, inside black … neutral-0 —
        # the same direction that keeps them readable on the solid surfaces
        # above. (Below the preset Settings warns; nothing is blocked.)
        ga0 = OPACITY["opacity-glass"]
        backs = [over(color[k], ga0, w) for k in ("glass-base", "glass-raised") for w in ("#ffffff", "#000000")]
        direction = 1 if dark else -1
        for role, target in (("text-primary", CONTRAST_TEXT), ("text-secondary", CONTRAST_TEXT),
                             ("glass-accent", CONTRAST_TEXT), ("success", CONTRAST_BORDER),
                             ("warning", CONTRAST_BORDER), ("danger", CONTRAST_BORDER), ("info", CONTRAST_BORDER)):
            worst = min(contrast(color[role], b) for b in backs)
            if worst >= target - 1e-9:
                continue
            L, C, H = oklch(color[role])
            for step in range(1, 101):
                Ln = L + direction * step
                edge = not L_FLOOR <= Ln <= L_CEIL
                cand = at_l(color[role], Ln)          # at the edge: black / neutral-0
                if min(contrast(cand, b) for b in backs) >= target:
                    adjusted.append({"role": role, "from": color[role], "to": cand,
                                     "why": "%g:1 over glass at %d%% (was %.2f:1)" % (target, GLASS_PRESET, worst)})
                    color[role] = cand
                    break
                if edge:
                    break
        for st in STATUS:
            if any(a["role"] == st and "glass" in a["why"] for a in adjusted):
                color[st + "-subtle"] = status_subtle(color[st], variant)

    # ── look presets: a remap of a few tokens, never colours or type ───────
    slight, secondary, primary, rounded, full = CORNER[cfg["corner"]]
    ctrl_md, ctrl_lg = DENSITY[cfg["density"]]
    bw1, bw2 = STROKE[cfg["stroke"]]
    focus_w = 2 if inc else FOCUS_WIDTH
    # A field, checkbox or switch keeps its outline at every stroke preset
    # (Look presets: "Fields, checkboxes and switches always keep a 1px
    # outline"), so it needs a width of its own: never 0, 2 under Increase
    # contrast, and it follows `stroke = thick` up like any other outline.
    field_bw = max(2 if inc else FIELD_BORDER_WIDTH, bw1)
    shape = {"slight": slight, "secondary": secondary, "primary": primary, "rounded": rounded,
             "fully-rounded": full, "border-width-1": bw1, "border-width-2": bw2,
             "focus-width": focus_w, "field-border-width": field_bw}

    # ── sizes, with Text size scaling the type scale ───────────────────────
    # Text size (Accessibility modes): "Type scales; controls grow to fit
    # their text instead of clipping." So everything text SITS IN scales with
    # it, rounded to whole pixels: the control heights (buttons, fields,
    # rows, tabs, segmented controls, the list-row minimums — all of them
    # control-*) and, through line-height-xs, the badge. Icons, spacing,
    # radii, panels and the bar's own steps stay put; the bar answers Text
    # size by moving one icon step up at 130%, and the dock keeps its cells
    # (the `dock` block below), because neither holds text.
    ts = cfg["text_scale"]
    bar_step = cfg["bar_icon_size"] if cfg["bar_icon_size"] in BAR else "normal"
    if ts == 130:                      # Text size 130%: the icons one step up
        bar_step = BAR_STEPS[min(BAR_STEPS.index(bar_step) + 1, len(BAR_STEPS) - 1)]
    size = {}
    for k, v in FONT_SIZE.items():
        size["font-size-" + k] = _scale(v, ts)
    for k, v in LINE_HEIGHT.items():
        size["line-height-" + k] = _scale(v, ts)
    for k, v in SPACING.items():
        size["space-" + k] = v
    size.update({"control-sm": _scale(SIZES["control-sm"], ts), "control-md": _scale(ctrl_md, ts),
                 "control-lg": _scale(ctrl_lg, ts), "control-xl": _scale(SIZES["control-xl"], ts),
                 "control-2xl": _scale(SIZES["control-2xl"], ts)})
    for k in ("icon-xs", "icon-sm", "icon-md", "icon-lg", "icon-xl",
              "icon-2xl", "icon-3xl", "icon-4xl", "panel-sm", "panel-md", "panel-lg", "window-gap",
              "blur-glass"):
        size[k] = SIZES[k]
    # the bar's heights are derived: module + space-s above and below.
    # bar-height is the normal bar (48), bar-height-lg the large one (56 —
    # tokens.json's 64 is the retired v3 large bar)
    pad = size[BAR_PAD]
    size["bar-height"] = BAR_MODULE[BAR["normal"][0]] + 2 * pad
    size["bar-height-lg"] = BAR_MODULE[BAR["large"][0]] + 2 * pad
    # the dock's cell per [desktop.dock] icon_size (Dock card "Sizes"): the
    # unscaled control-xl / control-2xl and icon-4xl, whatever Text size says
    dock = {"cell": {"small": SIZES["control-xl"], "medium": SIZES["control-2xl"],
                     "large": SIZES["icon-4xl"]}}
    b_mod, b_ico = BAR[bar_step]
    bar = {"icon_size": bar_step, "size": bar_step,
           "height": BAR_MODULE[b_mod] + 2 * pad, "module": BAR_MODULE[b_mod],
           "icon": size[b_ico], "padding": pad}

    # ── type: families, weights, tracking and the styles ───────────────────
    styles = {}
    for name, (fam, fs, lh, w, tr, it) in TYPE_STYLES.items():
        styles[name] = {"family": fam, "size": _scale(fs, ts), "lineHeight": _scale(lh, ts),
                        "weight": w, "tracking": tr, "italic": it}
    typ = {"sans": FONT_SANS, "mono": FONT_MONO,
           "css": {"sans": ", ".join('"%s"' % f for f in FONT_SANS) + ", system-ui, sans-serif",
                   "mono": ", ".join('"%s"' % f for f in FONT_MONO) + ", ui-monospace, monospace"},
           "weight": {"font-weight-" + k: v for k, v in FONT_WEIGHT.items()},
           "tracking": {"tracking-" + k: v for k, v in TRACKING.items()},
           "scale": ts, "styles": styles}

    # ── motion: the table, divided by the speed; Reduce motion = fades ─────
    sp = cfg["speed"]
    div = lambda ms: int(round(ms / sp)) if sp > 0 else 0
    motion = {k: div(v) for k, v in MOTION.items()}
    motion["easing"] = dict(EASING)
    motion["speed"] = sp
    motion["reduceMotion"] = bool(cfg["reduce_motion"])
    motion["slideOffset"] = SLIDE_OFFSET
    if cfg["reduce_motion"]:
        motion["durBase"] = motion["durSlow"] = motion["durFast"]
        motion["slideOffset"] = 0
        motion["easing"]["slow"] = EASING["fast"]

    # ── opacity + the surface block the shell and ewe-conf act on ──────────
    opacity = dict(OPACITY)
    app_blur = cfg["app_blur"] and not red_t
    win_t = cfg["window_transparency"] and not red_t
    surface = {"bar_alpha": glass_alpha if op < 100 else 1.0,
               "glass": (op < 100) and not glass_solid,
               "blur": BAR_BLUR_MIN <= op < 100 and not glass_solid,
               "app_blur": app_blur, "app_alpha": opacity["opacity-app"] if app_blur else 1.0,
               "inactive_alpha": opacity["opacity-inactive"] if win_t else 1.0,
               "solid": glass_solid}

    shadow = {"shadow-none": None}
    ink = shadow_color(color, sc)
    for k, ((x, y, blur), a) in SHADOW.items():
        shadow[k] = {"x": x, "y": y, "blur": blur, "color": ink, "alpha": a[variant]}

    presets = {"corner": cfg["corner"], "density": cfg["density"], "stroke": cfg["stroke"]}
    a11y = {k: cfg[k] for k in ("reduce_motion", "reduce_transparency", "increase_contrast", "text_scale")}
    inp = {k: cfg[k] for k in ("accent", "scheme", "scheme_name", "scheme_slug", "variant", "corner",
                               "density", "stroke", "neutral_tint", "bar_opacity", "app_blur",
                               "window_transparency", "bar_icon_size", "reduce_motion",
                               "reduce_transparency", "increase_contrast", "text_scale", "speed")}
    t = {"input": inp, "color": color, "alpha": alpha, "shape": shape, "size": size,
         "type": typ, "motion": motion, "opacity": opacity, "shadow": shadow,
         "gradient": gradients(color), "surface": surface, "bar": bar, "dock": dock, "presets": presets,
         "accessibility": a11y, "adjusted": adjusted,
         "brand": {str(s): color["ewellow-%d" % s] for s in RAMP_STEPS},
         "grey": {str(k): v for k, v in NEUTRAL.items()},
         "scheme": {"slug": sc["slug"], "name": sc["name"], "variant": variant,
                    "builtin": bool(sc.get("builtin")), "accent": accent,
                    "semantic": sc.get("semantic", True), "palette": sc["palette"],
                    "overrides": sc.get("overrides") or {}}}
    return t


# ═══ SCHEMES — import / export / wallpaper ═════════════════════════════════
def _mini_yaml(text):
    """Enough YAML for scheme files: `key: value` lines, one level of nesting,
    quotes, comments. Base16/Base24 and Gogh files are exactly this shape."""
    root, stack = {}, [(-1, None)]
    cur = root
    for raw in text.splitlines():
        line = raw.split(" #", 1)[0].rstrip() if not raw.strip().startswith("#") else ""
        if not line.strip() or line.strip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))
        body = line.strip()
        if body.startswith("- "):
            continue
        if ":" not in body:
            continue
        key, _, val = body.partition(":")
        key, val = key.strip().strip('"\''), val.strip()
        while stack and indent <= stack[-1][0]:
            stack.pop()
        cur = stack[-1][1] if stack and stack[-1][1] is not None else root
        if val == "":
            cur[key] = {}
            stack.append((indent, cur[key]))
        else:
            if (val.startswith('"') and val.endswith('"')) or (val.startswith("'") and val.endswith("'")):
                val = val[1:-1]
            cur[key] = val
    return root


def _from_base16(d, src):
    pal = d.get("palette") if isinstance(d.get("palette"), dict) else d
    rec = {"name": d.get("name") or d.get("scheme") or os.path.basename(src),
           "author": d.get("author", ""), "variant": d.get("variant", ""), "palette": {},
           "slug": d.get("slug"), "accent": d.get("accent"), "semantic": d.get("semantic"),
           "overrides": d.get("overrides")}
    for k in SCHEME_KEYS:
        v = pal.get(k) or pal.get(k.lower())
        if v:
            rec["palette"][k] = v
    if not rec["variant"]:
        rec["variant"] = "light" if hex_to_lch(_hex6(rec["palette"].get("base00", "#000")) or "#000")[0] > 50 else "dark"
    return rec


def _from_omarchy(d, src):
    g = lambda *ks: next((d[k] for k in ks if d.get(k)), None)
    pal = {"base00": g("background"), "base01": g("lighter_background", "background"),
           "base02": g("selection", "lighter_background"), "base03": g("muted"),
           "base04": g("dark_foreground", "muted"), "base05": g("foreground"),
           "base06": g("light_foreground", "foreground"), "base07": g("bright_foreground", "foreground"),
           "base08": g("red"), "base09": g("orange", "yellow"), "base0A": g("yellow"), "base0B": g("green"),
           "base0C": g("cyan"), "base0D": g("blue"), "base0E": g("magenta"), "base0F": g("brown", "orange"),
           "base10": g("dark_background"), "base11": g("darker_background"),
           "base12": g("bright_red"), "base13": g("bright_yellow"), "base14": g("bright_green"),
           "base15": g("bright_cyan"), "base16": g("bright_blue"), "base17": g("bright_magenta")}
    return {"name": os.path.basename(os.path.dirname(os.path.abspath(src))) or "Omarchy theme",
            "variant": d.get("mode", "dark"), "accent": g("accent"), "palette": {k: v for k, v in pal.items() if v}}


def _from_catppuccin(d, flavour):
    flavour = (flavour or "mocha").lower()
    fl = d.get(flavour)
    if not isinstance(fl, dict) or "colors" not in fl:
        raise ValueError("no flavour %r in this palette.json (have: %s)" % (
            flavour, ", ".join(k for k in d if isinstance(d.get(k), dict) and "colors" in d[k])))
    c = {k: v["hex"] for k, v in fl["colors"].items() if isinstance(v, dict) and v.get("hex")}
    dark = bool(fl.get("dark", True))
    pal = {"base00": c["base"], "base01": c["surface0"], "base02": c["surface1"], "base03": c["surface2"],
           "base04": c["subtext0"], "base05": c["text"], "base06": c["subtext1"], "base07": c["text"],
           "base08": c["red"], "base09": c["peach"], "base0A": c["yellow"], "base0B": c["green"],
           "base0C": c["teal"], "base0D": c["blue"], "base0E": c["mauve"], "base0F": c["flamingo"],
           "base10": c["mantle"], "base11": c["crust"], "base12": c["maroon"], "base13": c["yellow"],
           "base14": c["green"], "base15": c["sky"], "base16": c["sapphire"], "base17": c["pink"]}
    if not dark:
        # Latte: panels are the mantle, wells the crust, the overlay (base07)
        # the base itself — the lightest the flavour has
        pal.update({"base01": c["mantle"], "base02": c["surface0"], "base03": c["surface2"],
                    "base07": c["base"], "base10": c["crust"], "base11": c["crust"]})
    return {"name": "Catppuccin " + flavour.capitalize(), "variant": "dark" if dark else "light",
            "accent": c.get("blue"), "palette": pal}


def _from_gogh(d, src):
    bg, fg = d.get("background"), d.get("foreground")
    c = {i: d.get("color_%02d" % i) for i in range(1, 17)}
    if not (bg and fg and all(c[i] for i in range(1, 17))):
        raise ValueError("not a Gogh theme (needs background, foreground, color_01..16)")
    light = hex_to_lch(_hex6(bg) or "#000")[0] > 50
    sgn = 1 if light else -1
    pal = {"base00": bg, "base01": shift_l(_hex6(bg), -4 * sgn), "base02": shift_l(_hex6(bg), -8 * sgn),
           "base03": c[9], "base04": lch_mix(_hex6(fg), _hex6(bg), 0.3), "base05": fg,
           "base06": shift_l(_hex6(fg), 4 * -sgn), "base07": c[16],
           "base08": c[2], "base09": c[4], "base0A": c[12], "base0B": c[3], "base0C": c[7],
           "base0D": c[5], "base0E": c[6], "base0F": c[10],
           "base12": c[10], "base13": c[12], "base14": c[11], "base15": c[15], "base16": c[13], "base17": c[14]}
    return {"name": d.get("name") or os.path.splitext(os.path.basename(src))[0],
            "variant": "light" if light else "dark", "palette": pal}


def read_scheme_file(src, flavour=None):
    """A scheme record from any supported file or URL; the format is sniffed."""
    if src.startswith(("http://", "https://")):
        import urllib.request
        with urllib.request.urlopen(src, timeout=20) as r:
            text = r.read().decode("utf-8", "replace")
    else:
        with open(src, encoding="utf-8") as f:
            text = f.read()
    stripped = text.lstrip()
    rec = None
    if stripped.startswith("{"):
        d = json.loads(text)
        if any(isinstance(d.get(k), dict) and "colors" in d[k] for k in d):
            rec = _from_catppuccin(d, flavour)
        else:
            rec = _from_base16(d, src)
    elif src.endswith(".toml") or ("=" in stripped.splitlines()[0] and ":" not in stripped.splitlines()[0]):
        d = tomllib.loads(text)
        rec = _from_omarchy(d, src)
    else:
        d = _mini_yaml(text)
        if "color_01" in d:
            rec = _from_gogh(d, src)
        else:
            rec = _from_base16(d, src)
    rec["source"] = src
    sc = norm_scheme(rec)
    if not sc:
        raise ValueError("no usable palette in %s (need base00-base0F or an equivalent)" % src)
    return sc


def scheme_yaml(sc):
    """A scheme as a Base24 YAML file — what `export` prints and `import`
    reads back (the shape of design/system/assets/Schemes/*.yaml)."""
    q = lambda s: str(s).replace('"', "'")
    lines = ['system: "base24"', 'name: "%s"' % q(sc["name"]),
             'author: "%s"' % q(sc.get("author", "ewe")),
             'slug: "%s"' % sc["slug"], 'variant: "%s"' % sc["variant"]]
    if sc.get("builtin"):
        lines.append("builtin: true")
    if sc.get("accent"):
        lines.append('accent: "%s"' % sc["accent"])
    lines.append("semantic: %s" % ("true" if sc.get("semantic", True) else "false"))
    lines.append("palette:")
    for k in SCHEME_KEYS:
        if k in sc["palette"]:
            lines.append('  %s: "%s"' % (k, sc["palette"][k]))
    if sc.get("overrides"):
        lines.append("overrides:")
        for k in ROLES:
            if k in sc["overrides"]:
                lines.append('  %s: "%s"' % (k, sc["overrides"][k]))
    return "\n".join(lines) + "\n"


# ── the wallpaper: a palette from an image, no daemon ───────────────────────
def image_colors(path):
    """[(count, '#rrggbb')] — the image's dominant colours. ImageMagick when
    present (a hard dependency of ewe), Pillow as the fallback."""
    import shutil
    import subprocess
    exe = shutil.which("magick") or shutil.which("convert")
    if exe:
        r = subprocess.run([exe, path + "[0]", "-resize", "96x96!", "-depth", "8", "-colors", "32",
                            "-format", "%c", "histogram:info:-"], capture_output=True, text=True, timeout=60)
        cols = []
        for line in r.stdout.splitlines():
            line = line.strip()
            if ":" not in line or "#" not in line:
                continue
            n = line.split(":", 1)[0].strip()
            h = line.split("#", 1)[1][:6]
            if n.isdigit() and _hex6(h):
                cols.append((int(n), _hex6(h)))
        if cols:
            return cols
    try:
        from PIL import Image
        im = Image.open(path).convert("RGB").resize((96, 96))
        q = im.quantize(32)
        pal = q.getpalette()
        return [(n, "#%02x%02x%02x" % tuple(pal[i * 3:i * 3 + 3])) for n, i in q.getcolors()]
    except ImportError:
        raise RuntimeError("no image tool — install imagemagick")


def scheme_from_image(path, light=False, name=None):
    cols = image_colors(path)
    total = sum(n for n, _ in cols) or 1
    lch = [(n / total, h, *hex_to_lch(h)) for n, h in cols]
    # the surface hue: the most present colour that is not shouting
    surf = max(lch, key=lambda x: x[0] * (1.0 if x[3] < 40 else 0.5))
    hue_bg, C_bg = surf[4], min(surf[3], 10)
    # the accent: the most saturated colour with real presence, readable lightness
    cand = [x for x in lch if x[0] >= 0.01 and 30 <= x[2] <= 78 and x[3] >= 18]
    acc = max(cand, key=lambda x: x[3] * (0.6 + x[0])) if cand else max(lch, key=lambda x: x[3])
    accent = lch_to_hex(max(45, min(70, acc[2])), max(30, acc[3]), acc[4])
    sgn = 1 if light else -1
    L0 = 95 if light else 13
    step = lambda dl, c=C_bg, h=hue_bg: lch_to_hex(max(0, min(100, L0 + dl * sgn)), c, h)
    text = lambda L, c=min(C_bg, 4), h=hue_bg: lch_to_hex(L, c, h)
    # base04 muted, base05 primary, base06 secondary (the role table's order);
    # base07 is the brightest text in the dark and the lightest surface in
    # the light, as in the two built-in palettes
    tl = [38, 12, 24] if light else [62, 92, 82]
    top = step(-4) if light else text(96)
    hue = lambda L, C, H: lch_to_hex(L if not light else L - 12, C, H)
    pal = {"base11": step(-4), "base10": step(-2), "base00": step(0), "base01": step(5),
           "base02": step(9), "base03": lch_to_hex(L0 + 28 * sgn, min(C_bg, 6), hue_bg),
           "base04": text(tl[0]), "base05": text(tl[1]), "base06": text(tl[2]), "base07": top,
           "base08": hue(62, 48, 27), "base09": hue(68, 55, 58), "base0A": hue(78, 60, 92),
           "base0B": hue(66, 45, 140), "base0C": hue(70, 32, 205), "base0D": accent,
           "base0E": hue(64, 40, 320), "base0F": hue(52, 30, 50)}
    return norm_scheme({"name": name or "Wallpaper", "slug": "wallpaper", "variant": "light" if light else "dark",
                        "accent": accent, "palette": pal, "source": "wallpaper", "wallpaper": path})


# ── the CLI: `ewe-theme scheme …` ────────────────────────────────────────────
def _ewe_conf_exe():
    import shutil
    sib = os.path.join(HERE, "bin", "ewe-conf")
    return sib if os.path.exists(sib) else shutil.which("ewe-conf")


def conf_set(key, value, hooks=True):
    import subprocess
    exe = _ewe_conf_exe()
    if not exe:
        fail("no-ewe-conf", "ewe-conf not found beside this tool or on PATH")
    cmd = [exe, "set"] + ([] if hooks else ["--no-hooks"]) + [key, json.dumps(value)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    if r.returncode != 0:
        fail("conf-set", "ewe-conf set %s failed: %s" % (key, (r.stderr or r.stdout).strip()))


def _current_wallpaper():
    """The first image in generated/wallpapers.conf (the shell's own record)."""
    conf = os.path.join(CFG_DIR, "hypr", "generated", "wallpapers.conf")
    try:
        with open(conf) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                v = line.split("=", 1)[1].strip().strip('"')
                if v.lower().endswith((".png", ".jpg", ".jpeg", ".webp", ".bmp")) and os.path.isfile(v):
                    return v
    except OSError:
        pass
    return None


def _scheme_summary(sc, cfg, current):
    p = sc["palette"]
    acc = scheme_accent(sc, cfg)
    cur = current == sc["slug"] or (current == LEGACY_SCHEME and sc["slug"] == DEFAULT_SCHEME)
    return {"slug": sc["slug"], "name": sc["name"], "variant": sc["variant"],
            "builtin": bool(sc.get("builtin")), "semantic": sc.get("semantic", True),
            "accent": acc, "current": cur, "source": sc.get("source", ""),
            "overrides": sorted(sc.get("overrides") or {}),
            "swatch": [p["base00"], p["base01"], p["base05"], acc, p["base08"]]}


def _user_record(sc):
    """What goes into ewe.conf: the record minus the built-in mark."""
    return {k: v for k, v in sc.items() if k != "builtin"}


def cmd_scheme(a):
    cfg, src = read_conf(a.conf)
    hooks = not getattr(a, "no_hooks", False)
    schemes, current = cfg["schemes"], cfg["scheme"]
    verb = a.scheme_cmd or "list"

    def save_list(lst):
        conf_set("desktop.theme.schemes", [_user_record(s) for s in lst], hooks=False)

    def user_scheme(slug, what):
        sc = find_scheme(cfg, slug)
        if not sc:
            fail("no-scheme", "no scheme %r (ewe-theme scheme list)" % slug)
        if sc.get("builtin"):
            fail("builtin", "%s is built in and cannot be %s — duplicate it first "
                 "(ewe-theme scheme duplicate %s)" % (sc["name"], what, sc["slug"]))
        return sc

    if verb == "list":
        out({"ok": True, "current": DEFAULT_SCHEME if current == LEGACY_SCHEME else current,
             "schemes": [_scheme_summary(s, cfg, current) for s in all_schemes(cfg)]})
    if verb == "show":
        slug = a.slug or current
        sc = find_scheme(cfg, slug)
        if not sc:
            fail("no-scheme", "no scheme %r (ewe-theme scheme list)" % slug)
        t = tokens(dict(cfg, scheme=sc["slug"]))
        out({"ok": True, "current": DEFAULT_SCHEME if current == LEGACY_SCHEME else current,
             "scheme": sc, "accent": t["input"]["accent"],
             "roles": {k: t["color"][k] for k in ROLES}, "adjusted": t["adjusted"]})
    if verb == "apply":
        slug = DEFAULT_SCHEME if a.slug == LEGACY_SCHEME else a.slug
        if not find_scheme(cfg, slug):
            fail("no-scheme", "no scheme %r — import it first (ewe-theme scheme import FILE)" % slug)
        conf_set("desktop.theme.scheme", slug, hooks=hooks)
        out({"ok": True, "scheme": slug})
    if verb == "import":
        try:
            sc = read_scheme_file(a.path, getattr(a, "flavour", None))
        except Exception as e:  # any parse failure is one message, not a traceback
            fail("import", str(e))
        if a.name:
            sc["name"] = a.name
            sc["slug"] = slugify(a.name)
        if getattr(a, "slug_opt", None):
            sc["slug"] = slugify(a.slug_opt)
        if getattr(a, "accent", None):
            acc = _hex6(a.accent)
            if not acc:
                fail("bad-accent", "accent must be a hex colour")
            sc["accent"] = acc
        if sc["slug"] in BUILTIN_BY_SLUG:
            fail("builtin", "%r is a built-in scheme — import it under another name (--name or --slug), "
                 "or duplicate it (ewe-theme scheme duplicate %s)" % (sc["slug"], sc["slug"]))
        lst = [s for s in schemes if s["slug"] != sc["slug"]] + [sc]
        save_list(lst)
        if a.apply:
            conf_set("desktop.theme.scheme", sc["slug"], hooks=hooks)
        out({"ok": True, "imported": _scheme_summary(sc, cfg, sc["slug"] if a.apply else current),
             "applied": bool(a.apply)})
    if verb == "duplicate":
        sc = find_scheme(cfg, a.slug)
        if not sc:
            fail("no-scheme", "no scheme %r (ewe-theme scheme list)" % a.slug)
        cp = _user_record(sc)
        cp["name"] = a.name or (sc["name"] + " copy")
        cp["slug"] = slugify(getattr(a, "slug_opt", None) or cp["name"])
        if cp["slug"] in BUILTIN_BY_SLUG:
            fail("builtin", "%r is a built-in slug — pick another with --slug" % cp["slug"])
        cp.pop("source", None)
        if sc.get("builtin"):
            cp["accent"] = scheme_accent(sc, cfg)   # the copy wears what the original wore
        cp = norm_scheme(cp)
        lst = [s for s in schemes if s["slug"] != cp["slug"]] + [cp]
        save_list(lst)
        if a.apply:
            conf_set("desktop.theme.scheme", cp["slug"], hooks=hooks)
        out({"ok": True, "duplicated": _scheme_summary(cp, cfg, cp["slug"] if a.apply else current),
             "from": sc["slug"], "applied": bool(a.apply)})
    if verb == "remove":
        sc = user_scheme(a.slug, "removed")
        save_list([s for s in schemes if s["slug"] != sc["slug"]])
        was_current = current == sc["slug"]
        if was_current:
            conf_set("desktop.theme.scheme", DEFAULT_SCHEME, hooks=hooks)
        out({"ok": True, "removed": sc["slug"], "current": DEFAULT_SCHEME if was_current else current})
    if verb == "export":
        slug = a.slug or current
        sc = find_scheme(cfg, slug)
        if not sc:
            fail("no-scheme", "no scheme %r" % slug)
        if sc.get("builtin"):
            sc = dict(sc, accent=scheme_accent(sc, cfg))
        sys.stdout.write(scheme_yaml(sc))
        sys.exit(0)
    if verb == "set":
        sc = user_scheme(a.slug_opt or current, "changed")
        slug = sc["slug"]
        field, value = a.field, a.value
        if field == "accent":
            v = _hex6(value)
            if not v:
                fail("bad-value", "accent must be a hex colour")
            sc["accent"] = v
        elif field.startswith("base") and field.upper().replace("BASE", "base") in SCHEME_KEYS:
            v = _hex6(value)
            if not v:
                fail("bad-value", "%s must be a hex colour" % field)
            sc["palette"][field.upper().replace("BASE", "base")] = v
        elif field == "name":
            sc["name"] = value
        elif field == "variant":
            if value not in ("dark", "light"):
                fail("bad-value", "variant is dark or light")
            sc["variant"] = value
        elif field == "semantic":
            sc["semantic"] = _truthy(value, True)
        elif field.startswith("overrides."):
            role = field[len("overrides."):]
            if role not in ROLES:
                fail("bad-field", "overrides.<role>: one of " + ", ".join(ROLES))
            ov = dict(sc.get("overrides") or {})
            if value.strip().lower() in ("", "none", "null", "-"):
                ov.pop(role, None)          # clear: back to the derived value
            else:
                v = _hex6(value)
                if not v:
                    fail("bad-value", "%s must be a hex colour (or `none` to clear it)" % field)
                ov[role] = v
            if ov:
                sc["overrides"] = ov
            else:
                sc.pop("overrides", None)
        else:
            fail("bad-field", "fields: accent, name, variant, semantic, base00…base17, overrides.<role>")
        save_list(schemes)
        if current == slug:
            conf_set("desktop.theme.scheme", slug, hooks=hooks)   # re-apply so the shell repaints
        out({"ok": True, "scheme": _scheme_summary(sc, cfg, current)})
    if verb == "from-wallpaper":
        path = a.path or _current_wallpaper()
        if not path or not os.path.isfile(path):
            fail("no-wallpaper", "no image wallpaper is set (pass --path FILE)")
        if getattr(a, "if_changed", False):
            prev = next((s for s in schemes if s["slug"] == "wallpaper"), None)
            if prev and prev.get("wallpaper") == path and current == "wallpaper":
                out({"ok": True, "unchanged": True, "wallpaper": path})
        try:
            sc = scheme_from_image(path, light=bool(a.light), name=a.name or "Wallpaper")
        except Exception as e:
            fail("wallpaper", str(e))
        if not sc:
            fail("wallpaper", "could not derive a palette from %s" % path)
        lst = [s for s in schemes if s["slug"] != sc["slug"]] + [sc]
        save_list(lst)
        if a.apply:
            conf_set("desktop.theme.scheme", sc["slug"], hooks=hooks)
        out({"ok": True, "scheme": _scheme_summary(sc, cfg, sc["slug"] if a.apply else current),
             "wallpaper": path, "applied": bool(a.apply)})
    fail("bad-verb", "scheme verbs: list, show, apply, import, duplicate, remove, export, set, from-wallpaper")


# ═══ artefacts ════════════════════════════════════════════════════════════
def _fmt(x):
    return ("%.3f" % x).rstrip("0").rstrip(".") or "0"


def _rgba(hex6, alpha):
    return "rgba(%d, %d, %d, %s)" % (*_rgb(hex6), _fmt(alpha))


def color_css(t, role):
    """A colour as CSS reads it: translucent roles as rgba()."""
    v = t["color"][role]
    if role in t["alpha"]:
        return _rgba(v, t["alpha"][role])
    return v


def color_qml(t, role):
    """The same colour as QML reads it: #AARRGGBB."""
    v = t["color"][role]
    if role in t["alpha"]:
        return "#%02x%s" % (round(t["alpha"][role] * 255), v.lstrip("#"))
    return v


def shadow_css(sh):
    if not sh:
        return "none"
    return "%s %s %s %s" % (_px(sh["x"]), _px(sh["y"]), _px(sh["blur"]), _rgba(sh["color"], sh["alpha"]))


def _px(v):
    return "0" if v == 0 else "%dpx" % v


def gradient_css(g):
    stops = ", ".join("%s %d%%" % (_rgba(c, a) if a < 1 else c, pos) for c, a, pos in g["stops"])
    if g["kind"] == "radial":
        return "radial-gradient(circle at %s, %s)" % (g["at"], stops)
    return "linear-gradient(%ddeg, %s)" % (g["angle"], stops)


def shadow_qml(sh):
    if not sh:
        return None
    return {"x": sh["x"], "y": sh["y"], "blur": sh["blur"],
            "color": "#%02x%s" % (round(sh["alpha"] * 255), sh["color"].lstrip("#"))}


def gen_json(t):
    doc = {
        "version": DS_VERSION,
        "input": t["input"],
        "color": {k: color_qml(t, k) for k in t["color"]},
        "shape": t["shape"], "size": t["size"],
        "type": t["type"], "motion": t["motion"], "opacity": t["opacity"],
        "shadow": {k: shadow_qml(v) for k, v in t["shadow"].items()},
        "gradient": {k: dict(v, css=gradient_css(v)) for k, v in t["gradient"].items()},
        "surface": t["surface"], "bar": t["bar"], "dock": t["dock"], "presets": t["presets"],
        "accessibility": t["accessibility"], "adjusted": t["adjusted"],
        "brand": t["brand"], "grey": t["grey"],
        "scheme": t["scheme"],          # colorscheme.sh reads the palette for kitty's ANSI
        # the Accent picker's swatches, each with the ink its check mark takes
        "accent_presets": accent_presets(),
    }
    return json.dumps(doc, indent=2) + "\n"


def css_vars(t):
    """Every token as a CSS custom property (names = token names), plus
    --accent-default, which the apps' runtime accent falls back to."""
    v = {}
    for k in t["color"]:
        v["--" + k] = color_css(t, k)
    v["--font-sans"] = t["type"]["css"]["sans"]
    v["--font-mono"] = t["type"]["css"]["mono"]
    for k in [x for x in t["size"] if x.startswith("font-size-")]:
        v["--" + k] = "%dpx" % t["size"][k]
    for k in [x for x in t["size"] if x.startswith("line-height-")]:
        v["--" + k] = "%dpx" % t["size"][k]
    for k, val in t["type"]["weight"].items():
        v["--" + k] = str(val)
    for k, val in t["type"]["tracking"].items():
        v["--" + k] = "0" if val == 0 else "%gem" % val
    for k in [x for x in t["size"] if x.startswith("space-") and x[6:] in SPACING]:
        v["--" + k] = "%dpx" % t["size"][k]
    for k in ("slight", "secondary", "primary", "rounded", "fully-rounded"):
        v["--" + k] = "%dpx" % t["shape"][k]
    for k, sh in t["shadow"].items():
        v["--" + k] = shadow_css(sh)
    for k, g in t["gradient"].items():
        v["--" + k] = gradient_css(g)
    for k in ("border-width-1", "border-width-2", "focus-width", "field-border-width"):
        v["--" + k] = "%dpx" % t["shape"][k]
    for k in ("control-sm", "control-md", "control-lg", "control-xl", "control-2xl", "bar-height",
              "bar-height-lg", "icon-xs", "icon-sm", "icon-md", "icon-lg", "icon-xl", "icon-2xl",
              "icon-3xl", "icon-4xl", "panel-sm", "panel-md", "panel-lg", "window-gap", "blur-glass"):
        v["--" + k] = "%dpx" % t["size"][k]
    for k, val in t["opacity"].items():
        v["--" + k] = _fmt(val)
    v["--accent-default"] = t["color"]["accent"]
    return v


def type_css(t):
    """The type styles as classes: .body, .label, .h1 … (40-implementation)."""
    s = []
    for name, st in t["type"]["styles"].items():
        fam = "var(--font-mono)" if st["family"] == "mono" else "var(--font-sans)"
        rule = ["font-family: %s" % fam, "font-size: %dpx" % st["size"],
                "line-height: %dpx" % st["lineHeight"], "font-weight: %d" % st["weight"]]
        if st["tracking"]:
            rule.append("letter-spacing: %gem" % st["tracking"])
        if st["italic"]:
            rule.append("font-style: italic")
        if name == "mono-numeric":
            rule.append("font-variant-numeric: tabular-nums")
        s.append(".%s { %s; }" % (name, "; ".join(rule)))
    return "\n".join(s)


def gen_css(t, selector=":root"):
    sc = t["scheme"]
    s = ["/* AUTO-GENERATED by `ewe-theme build`. Do not edit by hand.",
         " *",
         " * Ewe design system, version %d (design/system/). Every value below is" % DS_VERSION,
         " * DERIVED from the active scheme and accent in ewe.conf [desktop.theme]:",
         " *",
         " *     ewe-theme scheme apply ewe-light",
         " *     ewe-conf set desktop.theme.accent '#7e9cd8'",
         " *",
         " * This file: scheme %s (%s, %s), accent %s." % (sc["slug"], sc["name"], sc["variant"], sc["accent"]),
         " *",
         " * Custom property names are the token names (--surface-raised,",
         " * --control-md); the type styles are classes (.body, .label). A",
         " * component asks for a role and this layer decides the value; no",
         " * component carries a palette literal.",
         " *",
         " * --accent is the person's pick, injected inline at runtime, which",
         " * beats any rule here.",
         " */", "", selector + " {"]
    for k, val in css_vars(t).items():
        s.append("  %s: %s;" % (k, val))
    s.append("  --accent: var(--accent-default);")
    s.append("}")
    s.append("")
    s.append("/* type styles */")
    s.append(type_css(t))
    s.append("")
    return "\n".join(s)


def _write(path, text):
    d = os.path.dirname(path)
    if d and not os.path.isdir(d):
        os.makedirs(d, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def accent_presets():
    """The Accent picker's swatches, each with the ink its check mark takes:
    in theme-tokens.json for the shell and in `show` for the apps."""
    return [{"name": n, "hex": h, "ink": on_color(h)} for n, h in ACCENT_PRESETS]


# ═══ commands ═════════════════════════════════════════════════════════════
def cmd_show(a):
    cfg, src = read_conf(a.conf)
    t = tokens(cfg)
    # css_vars is what the Tauri apps inject at runtime. They ship tokens.css
    # compiled in, built from the DEFAULTS; this is the same map built from
    # THIS machine's ewe.conf, so the apps wear the person's scheme and
    # accent without being rebuilt.
    out({"ok": True, "conf": src, "input": t["input"], "color": t["color"],
         "alpha": t["alpha"], "shape": t["shape"], "size": t["size"], "type": t["type"],
         "motion": t["motion"], "opacity": t["opacity"], "surface": t["surface"], "bar": t["bar"], "dock": t["dock"],
         "presets": t["presets"], "accessibility": t["accessibility"], "brand": t["brand"],
         "scheme": t["scheme"], "adjusted": t["adjusted"], "accent_presets": accent_presets(),
         "css_vars": css_vars(t)})


def design_tokens(cfg, slug=None):
    """The token set the REPO file is built from: the defaults (never the
    machine's own knobs), for the named built-in or user scheme."""
    d = dict(DEFAULTS, schemes=cfg.get("schemes") or [])
    if slug:
        if not find_scheme(d, slug):
            fail("no-scheme", "no scheme %r (ewe-theme scheme list)" % slug)
        d["scheme"] = slug
    return tokens(d)


def cmd_build(a):
    cfg, src = read_conf(a.conf)
    written, skipped = [], []
    scheme = getattr(a, "scheme", None)
    selector = getattr(a, "selector", None) or ":root"
    # `--scheme` is a design-time build (the website, the greeter, a check):
    # both files are that scheme at the DEFAULTS, never this machine's knobs,
    # and it never rewrites this machine's token file unless --json is given
    # explicitly (phase 30 writes the greeter's Ewe Dark roles that way).
    t = design_tokens(cfg, scheme) if scheme else tokens(cfg)
    jp = a.json if a.json is not None else (None if scheme else OUT_JSON)
    if jp is None or jp == "/dev/null":
        skipped.append("json (asked to discard)")
    else:
        _write(jp, gen_json(t))
        written.append(jp)
    cp = a.css if a.css is not None else OUT_CSS
    if cp == "/dev/null":
        skipped.append("css (asked to discard)")
    elif os.path.isdir(os.path.dirname(cp) or "."):
        # The CSS is a REPO file, committed and copied into the apps, so it
        # is built from the DEFAULTS — never from whichever machine ran the
        # build. (The JSON above is the opposite: it is this machine's state.)
        # At runtime the apps re-inject the live token set over the top.
        _write(cp, gen_css(design_tokens(cfg, scheme), selector))
        written.append(cp)
    else:
        # an installed tree has no design/ — the apps ship their CSS compiled in
        skipped.append("css (no %s)" % os.path.dirname(cp))
    out({"ok": True, "conf": src, "accent": t["input"]["accent"], "scheme": t["input"]["scheme_slug"],
         "css_scheme": scheme or DEFAULT_SCHEME, "written": written, "skipped": skipped})


def cmd_check(a):
    cfg, src = read_conf(a.conf)
    t = tokens(cfg)
    drift = []
    for path, want in ((a.json or OUT_JSON, gen_json(t)),
                       (a.css or OUT_CSS, gen_css(design_tokens(cfg)))):
        if path == "/dev/null":
            continue
        try:
            with open(path) as f:
                got = f.read()
        except OSError:
            drift.append({"path": path, "why": "missing — run `ewe-theme build`"})
            continue
        if got != want:
            drift.append({"path": path, "why": "stale — rebuild with `ewe-theme build`"})
    out({"ok": not drift, "conf": src, "drift": drift})


