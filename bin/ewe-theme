      <div style="font-size:12px;color:var(--fg-dim)">scubba@tab.digital</div></div>
    <div class="kv"><span style="color:var(--fg-dim)">Storage</span><span>1.2 GB of 5.0 GB</span></div>
    <div class="kv"><span style="color:var(--fg-dim)">Last synced</span><span>2 Sep, 15:04</span></div>
    <div class="kv"><span style="color:var(--fg-dim)">Link colour</span><span style="color:var(--link)">a link</span></div>
