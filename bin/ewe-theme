<script>
const T = __THEMES__, DEF = "__DEFAULT__";
function apply(name) {
  const t = T[name];
  document.documentElement.className = name === DEF ? "" : "dark " + name;
  document.documentElement.classList.add("dark");
  document.documentElement.style.setProperty("--accent", t.accent);
  document.getElementById("tl").textContent = t.label;
  document.getElementById("tn").textContent = t.note;
  const c = getComputedStyle(document.documentElement);
  document.getElementById("sw").innerHTML = Object.entries(T[name].color)
    .map(([k, v]) => `<div><span style="background:${v}"></span>--${k}<br>${v}</div>`).join("");
  document.querySelectorAll(".picker button").forEach(b =>
    b.className = "btn " + (b.dataset.t === name ? "btn-primary" : "btn-ghost"));
}
document.querySelectorAll(".picker button").forEach(b =>
  b.onclick = () => apply(b.dataset.t));
apply(DEF);
</script>
"""


def cmd_preview(a):
    """A self-contained specimen page, generated FROM the conf — so what you
    look at is what the shell and the apps will render, not a mock-up."""
    doc, path = load(a.conf)
    ts = themes(doc)
    default = (doc.get("meta") or {}).get("default") or next(iter(ts))
    picker = "".join(
        '<button class="btn btn-ghost" data-t="%s">%s</button>' % (n, t.get("label", n))
        for n, t in ts.items())
    html = (SPECIMEN
            .replace("__TOKENS__", gen_css(doc))
            .replace("__PICKER__", picker)
            .replace("__THEMES__", json.dumps(
                {n: {"label": t.get("label", n), "note": t.get("note", ""),
                     "color": t.get("color") or {},
                     "accent": t.get("accent", "#8fbce0")}
                 for n, t in ts.items()}))
            .replace("__DEFAULT__", default))
    target = a.out or os.path.join(HERE, "design", "specimen.html")
    _write(target, html)
    out({"ok": True, "path": target, "conf": path, "themes": list(ts)})


def main():
    p = argparse.ArgumentParser(add_help=True)
    p.add_argument("--conf")
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("list")
    sp = sub.add_parser("show"); sp.add_argument("theme")
    for name in ("build", "check"):
        s = sub.add_parser(name); s.add_argument("--json"); s.add_argument("--css")
    sp = sub.add_parser("preview"); sp.add_argument("--out")
    a = p.parse_args()
    {"list": cmd_list, "show": cmd_show, "build": cmd_build,
     "check": cmd_check, "preview": cmd_preview}.get(a.cmd or "list", cmd_list)(a)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
