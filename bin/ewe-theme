#!/usr/bin/env python3
"""ewe-theme — the ONE writer of what the looks are.

`ewe-theme.conf` says what a theme IS; this turns it into the two artefacts
the desktop actually reads, so a colour is changed in one place and both
halves of ewe follow:

  ~/.config/quickshell/theme-tokens.json   the shell — Theme.qml reads it and
                                           falls back to its built-ins if absent
  design/tokens.css                        the apps — compiled in by Tailwind,
                                           and re-injectable at runtime

Commands (each prints one JSON object and exits 0, like the other ewe tools):
  list                 -> {ok, default, themes:[{name, label, note}]}
  show <theme>         -> {ok, name, css_vars{}, color{}, shape{}, voice{}}
  build [--conf F] [--json F] [--css F]
                       -> {ok, written:[...]}  regenerate both artefacts
  check                -> {ok, drift:[...]}    do the artefacts match the conf?
  preview [--out F]    -> {ok, path}           a self-contained specimen page

Nothing here enumerates theme names: add a [<name>] block to the conf and it
appears everywhere. The DEFAULT theme becomes the CSS `:root` block; every
other theme becomes `.dark.<name>`, which is the class App.svelte toggles.
"""
import argparse
import json
import os
import sys
import tomllib

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CFG_DIR = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
USER_CONF = os.path.join(CFG_DIR, "ewe", "ewe-theme.conf")
SHIPPED = [USER_CONF, os.path.join(HERE, "templates", "ewe-theme.conf"),
           "/usr/share/ewe/templates/ewe-theme.conf"]
OUT_JSON = os.path.join(CFG_DIR, "quickshell", "theme-tokens.json")
OUT_CSS = os.path.join(HERE, "design", "tokens.css")

# px-valued shape keys — emitted as `<n>px` in CSS, as plain ints in JSON
PX = ("radius", "radius-inner", "radius-pill", "border", "border-thin", "shadow-offset")


def out(o):
    print(json.dumps(o))
    sys.exit(0)


def fail(code, msg):
    print(json.dumps({"ok": False, "error": code, "message": msg}))
    sys.exit(0)


def load(path=None):
    for p in ([path] if path else SHIPPED):
        if p and os.path.isfile(p):
            with open(p, "rb") as f:
                return tomllib.load(f), p
    fail("no-conf", "no ewe-theme.conf found (looked in %s)" % ", ".join(x for x in SHIPPED if x))


def themes(doc):
    return {k: v for k, v in doc.items() if k != "meta" and isinstance(v, dict)}


def css_vars(t):
    """One theme -> the {--name: value} map. The derived values (how a button
    hovers, where an input's border sits, what depth looks like) are computed
    from the declarative `voice`/`shape` keys, so the conf stays readable."""
    v = {}
    for k, val in (t.get("color") or {}).items():
        v["--" + k] = val
    shape = t.get("shape") or {}
    for k in PX:
        if k in shape:
            v["--" + k] = "%dpx" % int(shape[k])
    voice = t.get("voice") or {}
    if "label-transform" in voice:
        v["--label-transform"] = voice["label-transform"]
    if "label-tracking" in voice:
        v["--label-tracking"] = voice["label-tracking"]
    if "label-weight" in voice:
        v["--label-weight"] = str(voice["label-weight"])

    # hover: invert empties the fill and moves the accent to the text
    if voice.get("hover") == "invert":
        v["--btn-hover-bg"] = "transparent"
        v["--btn-hover-fg"] = "var(--accent)"
    else:
        v["--btn-hover-bg"] = "color-mix(in srgb, var(--accent) 88%, #ffffff)"
        v["--btn-hover-fg"] = "var(--accent-fg)"

    # inputs: a bottom rule, or a full outline
    b = int(shape.get("border", 1))
    v["--input-border-width"] = "0 0 %dpx 0" % b if voice.get("input-border") == "bottom" else "%dpx" % b

    # The look's DEFAULT accent. Deliberately NOT emitted as --accent: that
    # name belongs to the user's pick, set as an inline style at runtime, and
    # an inline style beats a stylesheet. tokens.css chains
    # `--accent: var(--accent-default)`, so a machine that has never chosen an
    # accent gets the theme's, and a machine that has keeps its own.
    if t.get("accent"):
        v["--accent-default"] = t["accent"]

    # depth: a solid offset block, or ambient blur when shadow-offset is 0
    off = int(shape.get("shadow-offset", 0))
    if off:
        v["--elevation"] = "%dpx %dpx 0 0 #000000" % (off, off)
        v["--elevation-sm"] = "%dpx %dpx 0 0 #000000" % (max(1, off // 2), max(1, off // 2))
    else:
        v["--elevation"] = "0 8px 24px rgba(0, 0, 0, 0.45)"
        v["--elevation-sm"] = "0 2px 8px rgba(0, 0, 0, 0.35)"
    return v


def gen_css(doc):
    ts = themes(doc)
    default = (doc.get("meta") or {}).get("default") or next(iter(ts))
    s = ["/* AUTO-GENERATED by `ewe-theme build` from ewe-theme.conf.",
         " * Do not edit by hand — change the conf and rebuild.",
         " *",
         " * Every name here mirrors a token in dotfiles/quickshell/Theme.qml, so the",
         " * shell and the apps are demonstrably the same system. The default theme is",
         " * :root; every other theme is .dark.<name>, the class App.svelte toggles.",
         " *",
         " * --accent is the user's pick, injected inline at runtime, which beats any",
         " * rule here. What IS themed is --accent-default: the colour a look opens",
         " * with before anyone chooses, chained as `--accent: var(--accent-default)`.",
         " * The font stack is shared by both looks and never themed.",
         " */", ""]
    order = [default] + [n for n in ts if n != default]
    for name in order:
        t = ts[name]
        sel = ":root" if name == default else ".dark.%s" % name
        s.append("/* %s — %s */" % (t.get("label", name), t.get("note", "")))
        s.append("%s {" % sel)
        vars_ = css_vars(t)
        for k, val in vars_.items():
            s.append("  %s: %s;" % (k, val))
        if "--accent-default" in vars_:
            s.append("  --accent: var(--accent-default);")
        s.append("}")
        s.append("")
    return "\n".join(s)


def gen_json(doc):
    ts = themes(doc)
    return json.dumps({
        "version": (doc.get("meta") or {}).get("version", 1),
        "default": (doc.get("meta") or {}).get("default") or next(iter(ts)),
        "themes": {n: {"label": t.get("label", n), "note": t.get("note", ""),
                       "accent": t.get("accent", ""),
                       "color": t.get("color") or {}, "shape": t.get("shape") or {},
                       "voice": t.get("voice") or {}} for n, t in ts.items()},
    }, indent=2) + "\n"


def cmd_list(a):
    doc, path = load(a.conf)
    ts = themes(doc)
    out({"ok": True, "conf": path,
         "default": (doc.get("meta") or {}).get("default"),
         "themes": [{"name": n, "label": t.get("label", n), "note": t.get("note", "")}
                    for n, t in ts.items()]})


def cmd_show(a):
    doc, path = load(a.conf)
    ts = themes(doc)
    if a.theme not in ts:
        fail("no-theme", "no such theme: %s (have: %s)" % (a.theme, ", ".join(ts)))
    t = ts[a.theme]
    out({"ok": True, "name": a.theme, "conf": path, "label": t.get("label", a.theme),
         "css_vars": css_vars(t), "color": t.get("color") or {},
         "shape": t.get("shape") or {}, "voice": t.get("voice") or {}})


def _write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)


def cmd_build(a):
    doc, path = load(a.conf)
    written, skipped = [], []
    j = a.json or OUT_JSON
    _write(j, gen_json(doc)); written.append(j)

    # The CSS is a BUILD-TIME artefact for the app repos, not a runtime one:
    # on an installed system HERE is /usr and design/ does not exist, so write
    # it only where the tree actually is (a dev checkout), or where asked.
    c = a.css or OUT_CSS
    if c == "/dev/null":
        skipped.append("css (asked to discard)")
    elif a.css or os.path.isdir(os.path.dirname(c)):
        _write(c, gen_css(doc)); written.append(c)
    else:
        skipped.append("%s (no design/ here — this is an installed tree)" % c)
    out({"ok": True, "conf": path, "written": written, "skipped": skipped})


def cmd_check(a):
    doc, path = load(a.conf)
    drift = []
    for target, gen in ((a.json or OUT_JSON, gen_json), (a.css or OUT_CSS, gen_css)):
        want = gen(doc)
        try:
            with open(target) as f:
                have = f.read()
        except OSError:
            drift.append({"path": target, "why": "missing"})
            continue
        if have != want:
            drift.append({"path": target, "why": "stale — rebuild with `ewe-theme build`"})
    out({"ok": not drift, "conf": path, "drift": drift})


SPECIMEN = """<!doctype html>
