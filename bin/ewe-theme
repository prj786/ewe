#!/usr/bin/env python3
"""ewe-theme — the ONE writer of what ewe looks like.

There is no theme file to edit. What a look IS — every colour role, the
accent ramp, the type scale, spacing, radii, sizes, shadows, motion — is
DERIVED here, in the repo, from the Ewe design system (design/system/,
version 3). What you can CHANGE lives in `ewe.conf`:

    [desktop.theme]
    scheme       = "ewe-dark"     # ewe-dark | ewe-light | a user scheme slug
    accent       = "#eeb407"      # any colour; the accent roles + ramp follow it
    corner       = "medium"       # none | small | medium | large  (round -> large)
    density      = "comfortable"  # compact | comfortable | roomy
    stroke       = "thin"         # none | thin | thick
    bar_opacity  = 100            # 0-100; the Glass preset is 80
    app_blur     = false          # every window at opacity-app, blurred behind
    window_transparency = false   # unfocused windows at opacity-inactive
    [desktop.bar]            icon_size = "normal" # small | normal | large (44 / 48 / 56)
    [desktop.accessibility]  reduce_motion, reduce_transparency,
                             increase_contrast = false; text_scale = 100|115|130
    [desktop.animations]     speed = 1            # divides the motion durations

One scheme + one accent in, the whole Ewe token set out, written to the two
artefacts the desktop reads:

  ~/.config/quickshell/theme-tokens.json   the shell — Theme.qml reads it
  design/tokens.css                        the apps — copied into each repo

Commands (each prints one JSON object and exits 0, like the other ewe tools):
  show                                  -> {ok, input, color, shape, size, ...}
  build [--json F] [--css F] [--scheme SLUG --selector SEL]  -> {ok, written}
  check                                 -> {ok, drift:[...]}
  preview [--out F]                     -> {ok, path}   a specimen page
  scheme list|show|apply|import|export|set|remove|duplicate|from-wallpaper

THE MODEL (design/system/guidelines/10-color-schemes.md). A scheme is a
Base24 palette (base00..base0F required, base10..base17 optional) plus a few
ewe keys: `slug`, `variant` (dark|light), `accent`, `semantic` (status
colours from the palette), `overrides` (any colour role, applied after
derivation) and `builtin`. Ewe Dark and Ewe Light are two such records,
embedded below and marked built-in. They are DATA only — palette, accent,
variant, semantic — and carry no overrides: every role they show comes out
of exactly the same derivation as an imported Gruvbox or a palette pulled
off the wallpaper:

  1. every ROLE (surface-*, text-*, border-*, status, scrim, glass-*)
     comes from one palette entry or an OKLCH mix of two, per the role table
     in that guide; the accent roles are STEPS of the ramp generated from
     the accent (accent-text = ewellow-400 in the dark, -800 in the light …);
     shadows and gradients are derived from the same roles and ramp;
  2. a user scheme's `overrides` are applied on top;
  3. the GUARANTEES run: text 4.5:1 and border-strong/focus-ring 3:1 on
     every surface role, surfaces at least 2 L apart (as far as the range
     below allows), warning never within 20 degrees of the accent. Only
     lightness moves, hue stays, and every move is recorded so `scheme show`
     (and Settings) can say which role was adjusted and why;
  4. look presets (corner / density / stroke) and accessibility modes are
     applied as REMAPS of the finished set. Components never know which is
     active — they only ever read roles.

WHAT IS FIXED. The design system defines the foundations as values, not
derivations, and they live in the tables below — the one place raw colour
values are allowed: the brand colour `ewellow`, `black`, the warm
`neutral-*` scale, Ewe's default status colours (semantic = false) and the
SHAPE of the accent ramp. Besides colours: the type scale, weights,
tracking, spacing, radii per corner preset, sizes, shadow geometry and
alphas, gradient angles, opacity and the motion table. Everything else is
derived.

ONE BLACK, ONE WHITE. `black` is the floor and `neutral-0` the ceiling of
every colour this tool emits: anything derived darker clamps to `black`,
anything lighter to `neutral-0` (on-accent/on-status candidates, the scrim,
shadows, guarantee moves, an imported palette's #000000 or #ffffff). There
is no second white or black anywhere in the output.

ONLY EWE NAMES. Every token is emitted under its design-system name
(surface-raised, text-muted, control-md …). The Fluent 2 aliases this tool
emitted while the shell and the apps moved over (bg-1, fg-2, brand-bg …)
were deleted in Phase 6 of the v3 rollout; design/system/guidelines/
20-migration.md is the rename table for anything still carrying one.
"""
import argparse
import json
import math
import os
import sys
import tomllib

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CFG_DIR = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
EWE_CONF = os.path.join(CFG_DIR, "ewe", "ewe.conf")
OUT_JSON = os.path.join(CFG_DIR, "quickshell", "theme-tokens.json")
OUT_CSS = os.path.join(HERE, "design", "tokens.css")

DS_VERSION = 3          # design/system/tokens.json "version" — named in every artefact

DEFAULTS = {"accent": "#eeb407", "scheme": "ewe-dark", "corner": "medium",
            "density": "comfortable", "stroke": "thin",
            # neutral_tint drove the pre-v3 accent-tinted grey ramp. The Ewe
            # neutrals are a fixed warm scale now, so the key is read and
            # reported but changes nothing. It stays so old confs round-trip.
            "neutral_tint": 8,
            "bar_opacity": 100, "app_blur": False, "window_transparency": False,
            "bar_icon_size": "normal", "reduce_motion": False, "reduce_transparency": False,
            "increase_contrast": False, "text_scale": 100, "speed": 1}
# bar_opacity: how solid the TOP BAR, DOCK and LOCK CARD are, 0 … 100 (the
# default). Below 100 they are Glass: the compositor blurs what is behind
# them (ewe-conf writes the blur + layer rule into generated/user.lua) —
# except under BAR_BLUR_MIN, where there is too little surface left to
# frost. Every other panel stays solid (Glass card).
BAR_BLUR_MIN = 10
GLASS_PRESET = 80       # the Glass preset (opacity-glass); Settings warns below it


def out(o):
    print(json.dumps(o))
    sys.exit(0)


def fail(code, msg):
    print(json.dumps({"ok": False, "error": code, "message": msg}))
    sys.exit(0)


# ═══ colour math. Stdlib only. ═════════════════════════════════════════════
# Two spaces: OKLCH for every role derivation (the design system's "mixes
# use OKLCH, so hue stays steady") and CIELAB LCH for the palette importers
# and the wallpaper extractor, which were tuned in Lab and produce a PALETTE
# (an input), not roles.
def _lin(c):
    c /= 255.0
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _gam(c):
    return 12.92 * c if c <= 0.0031308 else 1.055 * (c ** (1 / 2.4)) - 0.055


def _rgb(hexv):
    h = hexv.lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def _hex(r, g, b):
    q = lambda c: max(0, min(255, round(c)))
    return "#%02x%02x%02x" % (q(r), q(g), q(b))


def _cbrt(x):
    return math.copysign(abs(x) ** (1 / 3), x)


def oklch(hexv):
    """'#rrggbb' -> (L 0..100, C, h degrees) in OKLCH."""
    r, g, b = (_lin(c) for c in _rgb(hexv))
    l = _cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
    m = _cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
    s = _cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    bb = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return L * 100, math.hypot(a, bb), math.degrees(math.atan2(bb, a)) % 360


def _oklch_rgb(L, C, h):
    L /= 100.0
    a = C * math.cos(math.radians(h))
    b = C * math.sin(math.radians(h))
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (_gam(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s),
            _gam(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s),
            _gam(-0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s))


def _fits(t):
    return all(-0.0005 <= c <= 1.0005 for c in t)


def oklch_hex(L, C, h):
    """OKLCH -> '#rrggbb'. Holds L and h, drops chroma until sRGB fits."""
    L = max(0.0, min(100.0, L))
    if not _fits(_oklch_rgb(L, C, h)):
        lo, hi = 0.0, C
        for _ in range(32):
            mid = (lo + hi) / 2
            if _fits(_oklch_rgb(L, mid, h)):
                lo = mid
            else:
                hi = mid
        C = lo
    r, g, b = _oklch_rgb(L, C, h)
    return _hex(r * 255, g * 255, b * 255)


def ok_mix(h1, h2, f):
    """h1 -> h2 at f in OKLCH, hue along the short arc; a grey takes the
    other's hue so the mix does not swing through an arbitrary angle."""
    L1, C1, H1 = oklch(h1)
    L2, C2, H2 = oklch(h2)
    if C1 < 0.005:
        H1 = H2
    if C2 < 0.005:
        H2 = H1
    d = ((H2 - H1 + 180) % 360) - 180
    return oklch_hex(L1 + (L2 - L1) * f, C1 + (C2 - C1) * f, (H1 + d * f) % 360)


def ok_shift(hexv, dL):
    L, C, H = oklch(hexv)
    return oklch_hex(L + dL, C, H)


def ok_toward(hexv, target, dL):
    """`hexv` moved `dL` in lightness toward `target`, keeping its own hue
    and chroma ("base02 moved 8 L toward base05")."""
    L, C, H = oklch(hexv)
    Lt = oklch(target)[0]
    return oklch_hex(L + (dL if Lt >= L else -dL), C, H)


# ── CIELAB LCH: the importers' and the wallpaper extractor's space ─────────
Xn, Yn, Zn = 0.95047, 1.0, 1.08883


def hex_to_lch(h):
    r, g, b = (_lin(c) for c in _rgb(h))
    X = 0.4124564 * r + 0.3575761 * g + 0.1804375 * b
    Y = 0.2126729 * r + 0.7151522 * g + 0.0721750 * b
    Z = 0.0193339 * r + 0.1191920 * g + 0.9503041 * b
    f = lambda t: t ** (1 / 3) if t > 216 / 24389 else (24389 / 27 * t + 16) / 116
    fx, fy, fz = f(X / Xn), f(Y / Yn), f(Z / Zn)
    L, a, bb = 116 * fy - 16, 500 * (fx - fy), 200 * (fy - fz)
    return L, math.hypot(a, bb), math.degrees(math.atan2(bb, a)) % 360


def lch_to_rgb(L, C, H):
    a = C * math.cos(math.radians(H))
    b = C * math.sin(math.radians(H))
    fy = (L + 16) / 116
    fx, fz = fy + a / 500, fy - b / 200
    g = lambda t: t ** 3 if t ** 3 > 216 / 24389 else (116 * t - 16) / (24389 / 27)
    X = g(fx) * Xn
    Y = (((L + 16) / 116) ** 3 if L > 8 else L / (24389 / 27)) * Yn
    Z = g(fz) * Zn
    return (_gam(3.2404542 * X - 1.5371385 * Y - 0.4985314 * Z),
            _gam(-0.9692660 * X + 1.8760108 * Y + 0.0415560 * Z),
            _gam(0.0556434 * X - 0.2040259 * Y + 1.0572252 * Z))


def lch_to_hex(L, C, H):
    if not _fits(lch_to_rgb(L, C, H)):
        lo, hi = 0.0, C
        for _ in range(32):
            mid = (lo + hi) / 2
            if _fits(lch_to_rgb(L, mid, H)):
                lo = mid
            else:
                hi = mid
        C = lo
    r, g, b = lch_to_rgb(L, C, H)
    return _hex(r * 255, g * 255, b * 255)


def lch_mix(h1, h2, f):
    L1, C1, H1 = hex_to_lch(h1)
    L2, C2, H2 = hex_to_lch(h2)
    if C1 < 2:
        H1 = H2
    if C2 < 2:
        H2 = H1
    d = ((H2 - H1 + 180) % 360) - 180
    return lch_to_hex(L1 + (L2 - L1) * f, C1 + (C2 - C1) * f, (H1 + d * f) % 360)


def shift_l(h, dL):
    L, C, H = hex_to_lch(h)
    return lch_to_hex(max(0, min(100, L + dL)), C, H)


# ── WCAG contrast ──────────────────────────────────────────────────────────
def luminance(hexv):
    r, g, b = (_lin(c) for c in _rgb(hexv))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = luminance(a), luminance(b)
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)


def over(fg, alpha, bg):
    """`fg` at `alpha` composited over `bg` (sRGB, as the compositor does)."""
    f, b = _rgb(fg), _rgb(bg)
    return _hex(*(f[i] * alpha + b[i] * (1 - alpha) for i in range(3)))


def on_color(fill):
    """`black` or `neutral-0` — Ewe's one black and one white — whichever
    contrasts more with `fill`."""
    return BLACK if contrast(fill, BLACK) >= contrast(fill, NEUTRAL[0]) else NEUTRAL[0]


