#!/usr/bin/env python3
"""ewe-auth — one Google identity for every ewe app (RFC-002).

Promoted from the shell's google-auth.py: the same PKCE + loopback flow and
Secret Service keyring, now serving the whole desktop. The shell, Komble and
future apps stop doing their own OAuth and ask this broker instead.

Subcommands (every one prints a single JSON object and exits 0 — callers
never hang on it; `token` prints the bare token unless --json):
  status   -> {configured, client, keyring, signed_in, profile}
  login    -> browser consent -> refresh token into the keyring
  token    -> a valid access token (runtime-cached; refreshes under flock)
  refresh  -> like token, but always JSON and never the runtime cache's copy
              without checking expiry (kept for the shell's existing calls)
  logout   -> revoke at Google + clear keyring + caches
  keyring-reset -> move ~/.local/share/keyrings aside (a keyring made with a
              password other than the login one stays locked forever); PAM
              recreates the login keyring at the next login -> {ok, moved, relogin}

Client config — the fresh "ewe" OAuth client drops in here:
  1. ~/.config/ewe/oauth-client.json      (the ewe client; flat or the
     console's {"installed": {...}} download, verbatim)
  2. ~/.config/quickshell/google-oauth.json   (legacy shell client)
Changing the client invalidates the stored refresh token by definition —
the broker detects the swap (client_id recorded at login) and reports
signed-out with reason "client-changed" so UIs prompt one clean re-login.

Secrets policy unchanged: the refresh token lives ONLY in the keyring; the
access token cache lives in XDG_RUNTIME_DIR (tmpfs, 0600, gone at logout);
a Desktop-app client_secret is explicitly not confidential (Google's own
docs) but still never enters version control.
"""

import base64
import fcntl
import hashlib
import json
import os
import re
import secrets as pysecrets
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer

CFG_DIR = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
EWE_CLIENT = os.path.join(CFG_DIR, "ewe", "oauth-client.json")
LEGACY_CLIENT = os.path.join(CFG_DIR, "quickshell", "google-oauth.json")
# the project-owned "ewe" client, shipped with the OS — a Desktop-app
# client's secret is non-confidential by Google's own definition. Users
# never open a cloud console; a personal client in EWE_CLIENT still wins.
SHIPPED_CLIENT = "/usr/share/ewe/system/oauth-client.json"
AUTH_META = os.path.join(CFG_DIR, "ewe", "auth.json")        # client_id + email, non-secret
PROFILE_CACHE = os.path.join(CFG_DIR, "quickshell", "google-profile.json")
RUN_DIR = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
TOKEN_CACHE = os.path.join(RUN_DIR, "ewe-auth-token.json")
# the consent URL of the login in flight — so a shell/UI can offer "open the
# sign-in page" / "copy the link" when the browser hand-off fails
CONSENT_FILE = os.path.join(RUN_DIR, "ewe-auth-consent-url")

AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URL = os.environ.get("EWE_AUTH_TOKEN_URL", "https://oauth2.googleapis.com/token")
REVOKE_URL = "https://oauth2.googleapis.com/revoke"
USERINFO_URL = "https://openidconnect.googleapis.com/v1/userinfo"
# Scope strategy (docs/GOOGLE-CLIENT.md): the SHIPPED project client signs
# everyone in with the base set — identity + calendar (sensitive: warning
# only) + drive.appdata (non-sensitive). gmail.readonly is a RESTRICTED
# scope: Google hard-blocks it for unverified clients beyond test users, so
# Mail is an OPT-IN extra consent (login --with-mail) that personal clients
# and test-listed accounts can grant; the shell already degrades cleanly
# when the token lacks it (mailState "scope").
BASE_SCOPES = ("openid email profile "
               "https://www.googleapis.com/auth/calendar.readonly "
               "https://www.googleapis.com/auth/drive.appdata")
MAIL_SCOPE = "https://www.googleapis.com/auth/gmail.readonly"
# full Drive is ALSO restricted-tier: needed only for the ~/Google Drive
# mount (ewe-drive setup passes --with-drive); appdata alone stays the
# default for the one-file sync
DRIVE_SCOPE = "https://www.googleapis.com/auth/drive"

KEYRING_ARGS = ["service", "ewe", "account", "google"]
OLD_KEYRING_ARGS = ["service", "hypr-shell", "account", "google"]
FAKE_KEYRING = os.environ.get("EWE_AUTH_FAKE_KEYRING")   # tests only
LOGIN_TIMEOUT = 300
# a bare secret-tool call that needs no prompt answers in milliseconds; a
# short cap keeps `status`/`token` from hanging on a wedged daemon
KEYRING_TIMEOUT = 10


def out(obj):
    print(json.dumps(obj))
    sys.exit(0)


def read_client():
    cid = os.environ.get("EWE_GOOGLE_CLIENT_ID", "")
    csec = os.environ.get("EWE_GOOGLE_CLIENT_SECRET", "")
    which = "env" if cid else ""
    if not cid:
        for path, name in ((EWE_CLIENT, "ewe"), (LEGACY_CLIENT, "legacy"),
                           (SHIPPED_CLIENT, "shipped")):
            try:
                with open(path) as f:
                    j = json.load(f)
                if isinstance(j.get("installed"), dict):
                    j = j["installed"]
                if j.get("client_id"):
                    cid, csec, which = j["client_id"], j.get("client_secret", ""), name
                    break
            except (OSError, ValueError):
                continue
    return cid, csec, which


def keyring_get():
    if FAKE_KEYRING is not None:
        try:
            return open(FAKE_KEYRING).read().strip()
        except OSError:
            return ""
    try:
        r = subprocess.run(["secret-tool", "lookup", *KEYRING_ARGS],
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
        r = subprocess.run(["secret-tool", "lookup", *OLD_KEYRING_ARGS],
                           capture_output=True, text=True, timeout=10)
        tok = r.stdout.strip() if r.returncode == 0 else ""
        if tok and keyring_set(tok):
            subprocess.run(["secret-tool", "clear", *OLD_KEYRING_ARGS],
                           capture_output=True, text=True, timeout=10)
        return tok
    except (OSError, subprocess.TimeoutExpired):
        return ""


def _classify_keyring_failure(stderr, timed_out=False):
    """secret-tool's stderr → (error-code, human message). The first metal
    install taught us the three ways a store fails, and each needs a
    different sentence on screen."""
    if timed_out:
        return ("keyring-timeout",
                "The keyring did not answer in time — if a keyring password "
                "prompt is open, answer it (use your login password) and retry.")
    e = (stderr or "").strip()
    low = e.lower()
    if ("not provided by any .service" in low or "failed to execute" in low
            or "cannot autolaunch" in low or "no such interface" in low
            or "connection refused" in low or "was not provided" in low
            or "not activatable" in low):
        return ("keyring-unavailable",
                "No Secret Service keyring is running — gnome-keyring must be "
                "installed and started for this session.")
    if "cancel" in low or "dismiss" in low:
        return ("keyring-cancelled",
                "The keyring prompt was dismissed — sign in again and unlock "
                "the keyring with your login password.")
    return ("keyring-store-failed",
            "The keyring refused to store the token" + (": " + e if e else "."))


def keyring_store(token, timeout=KEYRING_TIMEOUT):
    """→ (ok, error-code, message). A store can legitimately BLOCK on a
    gcr prompt (no login keyring yet / locked keyring); callers that expect
    a human at the keyboard pass a long timeout — killing secret-tool
    mid-prompt tears the prompt down, which is exactly what looked like
    "the keyring never shows up" on the first real install."""
    if FAKE_KEYRING is not None:
        open(FAKE_KEYRING, "w").write(token)
        return True, "", ""
    try:
        r = subprocess.run(["secret-tool", "store", "--label=ewe Google", *KEYRING_ARGS],
                           input=token, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        code, msg = _classify_keyring_failure("", timed_out=True)
        return False, code, msg
    except OSError as e:
        return False, "keyring-unavailable", "secret-tool is not installed (%s)." % e
    if r.returncode == 0:
        return True, "", ""
    code, msg = _classify_keyring_failure(r.stderr)
    return False, code, msg


def keyring_set(token):
    return keyring_store(token)[0]


def keyring_clear():
    if FAKE_KEYRING is not None:
        try:
            os.remove(FAKE_KEYRING)
        except OSError:
            pass
        return
    try:
        subprocess.run(["secret-tool", "clear", *KEYRING_ARGS],
                       capture_output=True, text=True, timeout=KEYRING_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        pass


def _busctl(args, timeout=5):
    try:
        r = subprocess.run(["busctl", "--user", *args], capture_output=True,
                           text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None, ""
    return r.returncode, (r.stdout or "").strip() + ("\n" + r.stderr.strip() if r.stderr else "")


def keyring_probe():
    """Ask the Secret Service itself, WITHOUT triggering a prompt:
      {"state": "ok" | "missing" | "locked" | "unavailable", "collection": path}
    ok        a default (login) collection exists and is unlocked
    missing   the service is up but no default collection exists yet — the
              first store will pop "Choose password for new keyring"
    locked    the login keyring exists but PAM did not unlock it — the
              first store will pop "Unlock keyring"
    unavailable  no service on the bus and D-Bus could not start one
    The call itself D-Bus-activates gnome-keyring-daemon when it is merely
    not running yet — the same thing secret-tool would have done."""
    if FAKE_KEYRING is not None:
        return {"state": "ok", "collection": "fake"}
    rc, outp = _busctl(["call", "org.freedesktop.secrets", "/org/freedesktop/secrets",
                        "org.freedesktop.Secret.Service", "ReadAlias", "s", "default"])
    if rc is None or rc != 0:
        return {"state": "unavailable", "collection": "", "detail": outp[-200:]}
    # reply looks like:  o "/org/freedesktop/secrets/collection/login"
    m = re.search(r'"(/[^"]*)"', outp)
    path = m.group(1) if m else "/"
    if path == "/":
        return {"state": "missing", "collection": ""}
    rc, outp = _busctl(["get-property", "org.freedesktop.secrets", path,
                        "org.freedesktop.Secret.Collection", "Locked"])
    if rc == 0 and outp.split()[-1:] == ["true"]:
        return {"state": "locked", "collection": path}
    return {"state": "ok", "collection": path}


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, data, mode=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)


def http_post_form(url, fields):
    data = urllib.parse.urlencode(fields).encode()
    req = urllib.request.Request(url, data=data,
                                 headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode()), None
    except urllib.error.HTTPError as e:
        try:
            body = json.loads(e.read().decode())
        except ValueError:
            body = {}
        return None, body.get("error", "http-%d" % e.code)
    except (urllib.error.URLError, OSError) as e:
        return None, "network: %s" % e


def fetch_userinfo(access_token):
    req = urllib.request.Request(USERINFO_URL, headers={"Authorization": "Bearer " + access_token})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            j = json.loads(resp.read().decode())
        return {"name": j.get("name", ""), "email": j.get("email", ""), "picture": j.get("picture", "")}
    except (urllib.error.URLError, OSError, ValueError):
        return {"name": "", "email": "", "picture": ""}


def client_changed(cid):
    meta = read_json(AUTH_META)
    return bool(meta and meta.get("client_id") and meta["client_id"] != cid)


def signed_out(reason):
    keyring_clear()
    for p in (PROFILE_CACHE, TOKEN_CACHE, AUTH_META):
        try:
            os.remove(p)
        except OSError:
            pass
    out({"ok": False, "error": "signed-out", "reason": reason})


def do_refresh(cid, csec):
    """refresh-token → fresh access token; updates the runtime cache.
    Returns (token_dict, None) or (None, error-json-already-printed)."""
    rt = keyring_get()
    if not rt:
        out({"ok": False, "error": "signed-out"})
    if client_changed(cid):
        signed_out("client-changed")
    tok, err = http_post_form(TOKEN_URL, {
        "client_id": cid, "client_secret": csec,
        "refresh_token": rt, "grant_type": "refresh_token",
    })
    if err == "invalid_grant":
        signed_out("invalid_grant")
    if err or "access_token" not in (tok or {}):
        out({"ok": False, "error": err or "no access_token"})
    exp = int(time.time()) + int(tok.get("expires_in", 3600))
    write_json(TOKEN_CACHE, {"access_token": tok["access_token"],
                             "expires_at": exp, "client_id": cid}, mode=0o600)
    return tok["access_token"], exp


def cmd_status():
    cid, _, which = read_client()
    probe = keyring_probe()
    out({"configured": bool(cid), "client": which,
         # truthful now: a Secret Service answered on the bus (the old check
         # only proved the secret-tool BINARY existed)
         "keyring": probe["state"] != "unavailable",
         "keyring_state": probe["state"],
         "keyring_locked": probe["state"] == "locked",
         "signed_in": bool(keyring_get()) and not client_changed(cid),
         "profile": read_json(PROFILE_CACHE)})


def cmd_token(argv):
    as_json = "--json" in argv
    cid, csec, _ = read_client()
    if not cid:
        out({"ok": False, "error": "not-configured"})
    os.makedirs(RUN_DIR, exist_ok=True)
    with open(os.path.join(RUN_DIR, ".ewe-auth.lock"), "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        cache = read_json(TOKEN_CACHE)
        if (cache and cache.get("client_id") == cid
                and cache.get("expires_at", 0) - time.time() > 60):
            at, exp = cache["access_token"], cache["expires_at"]
        else:
            at, exp = do_refresh(cid, csec)
    if as_json:
        out({"ok": True, "access_token": at, "expires_at": exp})
    print(at)
    sys.exit(0)


def cmd_refresh():
    cid, csec, _ = read_client()
    if not cid:
        out({"ok": False, "error": "not-configured"})
    at, exp = do_refresh(cid, csec)
    out({"ok": True, "access_token": at, "expires_at": exp})


def _launch(cmd, settle=2.5):
    """Start a browser hand-off and decide within `settle` seconds whether it
    took: a launcher that exits non-zero quickly has failed; one still running
    (a browser that stays in the foreground when it is the first instance) or
    one that exited 0 has done its job. Never `wait()` unbounded — xdg-open
    runs a fresh browser in the FOREGROUND for its whole life."""
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             stdin=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        return False
    try:
        rc = p.wait(timeout=settle)
    except subprocess.TimeoutExpired:
        return True
    return rc == 0


def open_browser(url):
    """xdg-open first (the user's default browser), then the shipped browser
    by desktop id, then by binary — and say so when none of them worked,
    instead of waiting five silent minutes for a tab that never opened."""
    if os.environ.get("EWE_AUTH_NO_BROWSER"):
        return True
    if _launch(["xdg-open", url]):
        return True
    for desk in ("helium.desktop", "helium-browser.desktop"):
        for base in ("/usr/share/applications", os.path.expanduser("~/.local/share/applications")):
            path = os.path.join(base, desk)
            if os.path.exists(path) and _launch(["gio", "launch", path, url]):
                return True
    for binary in ("helium-browser", "helium", "firefox", "chromium"):
        if _launch([binary, url]):
            return True
    return False


def cmd_login(argv=()):
    cid, csec, which = read_client()
    if not cid:
        out({"ok": False, "error": "not-configured"})
    # personal clients get the full set by default (their owner controls the
    # consent screen); the shipped project client keeps mail opt-in
    with_mail = "--with-mail" in argv or (which in ("ewe", "legacy", "env")
                                          and "--base-only" not in argv)
    scopes = BASE_SCOPES + (" " + MAIL_SCOPE if with_mail else "")
    if "--with-drive" in argv:
        scopes += " " + DRIVE_SCOPE
    # Keyring check WITHOUT a prompt (busctl, never secret-tool): the old
    # probe stored a dummy secret up front, which on a machine with no login
    # keyring popped the gcr prompt, killed it 10 s later and never reached
    # the browser. Only a dead service is fatal here; "missing"/"locked" are
    # HINTS the UI shows ("a keyring prompt will appear — use your login
    # password") and the real store below waits as long as the login does.
    probe = keyring_probe()
    keyring_hint = probe["state"]
    if keyring_hint == "unavailable":
        out({"ok": False, "error": "keyring-unavailable", "keyring": keyring_hint,
             "message": "No Secret Service keyring is running — gnome-keyring must be "
                        "installed and started for this session."})

    verifier = base64.urlsafe_b64encode(pysecrets.token_bytes(48)).decode().rstrip("=")
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).decode().rstrip("=")
    state = pysecrets.token_urlsafe(24)
    result = {}

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            q = urllib.parse.urlparse(self.path)
            params = dict(urllib.parse.parse_qsl(q.query))
            body = "<html><body style='background:#1d1d1d;color:#eee;font-family:sans-serif'>" \
                   "<h2>ewe</h2><p>%s</p></body></html>"
            if q.path != "/callback":
                self.send_response(404); self.end_headers(); return
            if params.get("state") != state:
                result["error"] = "state-mismatch"
                msg = "Sign-in failed (state mismatch) — you can close this tab."
            elif "error" in params:
                result["error"] = params["error"]
                msg = "Sign-in was cancelled — you can close this tab."
            elif "code" in params:
                result["code"] = params["code"]
                msg = "Signed in — you can close this tab and return to ewe."
            else:
                result["error"] = "no-code"
                msg = "Sign-in failed — you can close this tab."
            data = (body % msg).encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

    srv = HTTPServer(("127.0.0.1", 0), Handler)
    port = srv.server_address[1]
    redirect = "http://127.0.0.1:%d/callback" % port

    auth = AUTH_URL + "?" + urllib.parse.urlencode({
        "client_id": cid, "redirect_uri": redirect, "response_type": "code",
        "scope": scopes, "code_challenge": challenge, "code_challenge_method": "S256",
        "access_type": "offline", "prompt": "consent", "state": state,
        "include_granted_scopes": "true",
    })
    # the URL also goes to stderr and to a runtime file: if the browser
    # hand-off fails (headless callers, odd sessions, no default browser),
    # whoever ran us — or the shell's "open / copy the link" — can use it
    sys.stderr.write("consent-url: " + auth + "\n")
    sys.stderr.flush()
    try:
        os.makedirs(RUN_DIR, exist_ok=True)
        with open(CONSENT_FILE, "w") as f:
            f.write(auth + "\n")
        os.chmod(CONSENT_FILE, 0o600)
    except OSError:
        pass

    def fail(err, **extra):
        d = {"ok": False, "error": err, "consent_url": auth, "keyring": keyring_hint}
        d.update(extra)
        srv.server_close()
        out(d)

    if not open_browser(auth):
        fail("browser-failed",
             message="Could not open a browser for the sign-in page — open the link yourself.")

    srv.timeout = 5
    deadline = time.time() + LOGIN_TIMEOUT
    while time.time() < deadline and not result:
        srv.handle_request()
    srv.server_close()

    if "code" not in result:
        out({"ok": False, "error": result.get("error", "timeout"),
             "consent_url": auth, "keyring": keyring_hint})

    tok, err = http_post_form(TOKEN_URL, {
        "client_id": cid, "client_secret": csec, "code": result["code"],
        "code_verifier": verifier, "grant_type": "authorization_code",
        "redirect_uri": redirect,
    })
    if err or "access_token" not in (tok or {}):
        out({"ok": False, "error": "token-exchange: %s" % (err or "no access_token"),
             "consent_url": auth, "keyring": keyring_hint})
    if "refresh_token" not in tok:
        out({"ok": False, "error": "no-refresh-token", "consent_url": auth, "keyring": keyring_hint})
    # THE store that may prompt (new keyring / unlock) — give the human the
    # whole login budget, never the 10 s that killed the prompt on metal
    ok, code, msg = keyring_store(tok["refresh_token"], timeout=LOGIN_TIMEOUT)
    if not ok:
        out({"ok": False, "error": code, "message": msg,
             "consent_url": auth, "keyring": keyring_hint})
    try:
        os.remove(CONSENT_FILE)
    except OSError:
        pass

    profile = fetch_userinfo(tok["access_token"])
    write_json(PROFILE_CACHE, profile)
    write_json(AUTH_META, {"client_id": cid, "client": which,
                           "email": profile.get("email", "")})
    exp = int(time.time()) + int(tok.get("expires_in", 3600))
    write_json(TOKEN_CACHE, {"access_token": tok["access_token"],
                             "expires_at": exp, "client_id": cid}, mode=0o600)
    out({"ok": True, "profile": profile, "access_token": tok["access_token"],
         "expires_at": exp, "consent_url": auth, "keyring": keyring_hint})


def cmd_logout():
    rt = keyring_get()
    if rt:
        try:
            urllib.request.urlopen(
                urllib.request.Request(REVOKE_URL,
                                       data=urllib.parse.urlencode({"token": rt}).encode(),
                                       headers={"Content-Type": "application/x-www-form-urlencoded"}),
                timeout=15)
        except (urllib.error.URLError, OSError):
            pass
    keyring_clear()
    for p in (PROFILE_CACHE, TOKEN_CACHE, AUTH_META):
        try:
            os.remove(p)
        except OSError:
            pass
    out({"ok": True})


def cmd_keyring_reset():
    """A login keyring created with some password other than the login one
    (typed into a prompt that was hidden behind the Welcome overlay, first
    bare-metal install 2026-09-02) can never be unlocked by PAM and rejects
    what the user remembers. The only fix is a fresh one: move the keyring
    files aside (never delete — a `keyrings.bak.<ts>` directory keeps them),
    drop our caches, and let pam_gnome_keyring recreate `login` with the
    login password at the next login. Nothing else on the machine uses the
    ewe keyring entries (NetworkManager keeps Wi-Fi secrets in its own store).
    """
    if FAKE_KEYRING is not None:
        keyring_clear()
        out({"ok": True, "moved": "", "relogin": False})
        return
    data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    kdir = os.path.join(data, "keyrings")
    moved = ""
    if os.path.isdir(kdir):
        moved = "%s.bak.%d" % (kdir, int(time.time()))
        try:
            os.rename(kdir, moved)
        except OSError as e:
            out({"ok": False, "error": "keyring-reset-failed", "message": str(e)})
            return
    for p in (PROFILE_CACHE, TOKEN_CACHE, AUTH_META):
        try:
            os.remove(p)
        except OSError:
            pass
    out({"ok": True, "moved": moved, "relogin": True,
         "message": "Keyring reset. Log out and back in — it is recreated with your login password — then sign in again."})


if __name__ == "__main__":
    argv = sys.argv[1:]
    cmd = argv[0] if argv else "status"
    try:
        if cmd == "token":
            cmd_token(argv[1:])
        elif cmd == "login":
            cmd_login(argv[1:])
        else:
            {"status": cmd_status,
             "refresh": cmd_refresh, "logout": cmd_logout,
             "keyring-reset": cmd_keyring_reset}.get(cmd, cmd_status)()
    except SystemExit:
        raise
    except Exception as e:  # absolute backstop: still emit parseable JSON
        print(json.dumps({"ok": False, "error": "internal: %s" % e}))
