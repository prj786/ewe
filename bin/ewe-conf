#!/usr/bin/env python3
"""ewe-conf — the ONE writer of the ONE file (RFC-001).

The machine is a single declarative document, ~/.config/ewe/ewe.conf (TOML).
Settings UIs, the installer and komble never touch it directly — they call
this tool, and everything the shell/Hyprland actually read is a build
artifact of `ewe-conf apply`.

    ewe-conf path                     canonical file path
    ewe-conf dump                     whole document as JSON on stdout
    ewe-conf get <dotted.key>         value (JSON for structures)
    ewe-conf set <dotted.key> <val>   val parsed as JSON, else string; applies
    ewe-conf unset <dotted.key>       remove a key; applies
    ewe-conf import                   build ewe.conf FROM the live runtime files
    ewe-conf apply [--only DOMAIN] [--no-hooks]
                                      regenerate artifacts (+ colorscheme +
                                      settings-reload poke unless --no-hooks)

Python stdlib only: tomllib reads, the constrained emitter below writes (our
schema is tables, arrays, scalars — nothing exotic). Writes are atomic
(tmp+rename) under an flock, keys are emitted in stable order so diffs are
honest. Phase 1 scope: the JSON-state domains; lua/conf generators join in
RFC Phase 4.
"""
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
import tomllib

SCHEMA = 1

CFG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME")
                       or os.path.join(os.path.expanduser("~"), ".config"))
EWE_DIR = os.path.join(CFG_DIR, "ewe")
CONF = os.path.join(EWE_DIR, "ewe.conf")
QS = os.path.join(CFG_DIR, "quickshell")

HEADER = """\
# ewe.conf — the machine as one file (RFC-001).
# Owned by `ewe-conf`; edit by hand if you like, but every Settings change
# rewrites it wholesale and comments do not survive. `ewe-conf apply` turns
# this document into the runtime files Hyprland and the shell read.
"""

# ── constrained TOML emitter ─────────────────────────────────────────────────

_BARE = re.compile(r"^[A-Za-z0-9_-]+$")


def _key(k):
    return k if _BARE.match(k) else json.dumps(k)


def _scalar(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v)
    if isinstance(v, list):
        return "[" + ", ".join(_scalar(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{" + ", ".join(f"{_key(k)} = {_scalar(x)}" for k, x in v.items()) + "}"
    raise TypeError(f"unsupported value: {type(v).__name__}")


# Section comments — regenerated on every write, so the file explains itself.
SECTION_NOTES = {
    "desktop": "everything the Settings surfaces manage",
    "desktop.theme": "colours + look; colorscheme.sh reapplies these",
    "desktop.dock": "the bottom dock (autohide = intelligent hide)",
    "desktop.animations": "speed multiplies every duration; detail = per-leaf tuning",
    "desktop.displays": "per-monitor-set profiles (Settings → Displays owns this)",
    "desktop.window_rules": "per-app workspace/float rules",
    "desktop.input": "keyboard layouts + mouse/touchpad; devices = per-device overrides",
    "desktop.layout": "gaps/border/corner radius — user.lua is generated from these + theme",
    "desktop.keybinds": "your own launch bindings: {combo, exec} records",
    "desktop.wallpapers": "per-output wallpaper map (image/GIF/video)",
    "desktop.power": "lid/idle/screensaver behaviour",
    "apps": "pins, startup entries, places, and Komble's installed manifest",
    "apps.installed": "what Komble manages here — a fresh machine reinstalls from this",
    "system": "what this MACHINE is — read by the installer/OS tooling only",
    "sync": "account identity for sync; credentials never live in this file",
}

_INLINE_MAX = 96


def _is_record_list(v):
    return isinstance(v, list) and v and all(isinstance(x, dict) for x in v)


def _note(out, path):
    n = SECTION_NOTES.get(".".join(path))
    if n:
        out.append(f"# {n}")


def _emit_table(out, path, table):
    scalars, inlines, records, subs = {}, {}, {}, {}
    for k, v in table.items():
        if isinstance(v, dict):
            flat = not any(isinstance(x, dict) for x in v.values())
            documented = ".".join(path + [k]) in SECTION_NOTES
            if flat and not documented and path and len(_scalar(v)) <= _INLINE_MAX:
                inlines[k] = v          # small leaf dict → one readable line
            else:
                subs[k] = v
        elif _is_record_list(v) and len(_scalar(v)) > _INLINE_MAX:
            records[k] = v              # list of records → [[...]] blocks
        else:
            scalars[k] = v
    plain = {**scalars, **inlines}
    if path and (plain or not (subs or records)):
        _note(out, path)
        out.append("[" + ".".join(_key(p) for p in path) + "]")
    for k, v in plain.items():
        out.append(f"{_key(k)} = {_scalar(v)}")
    if plain or not (subs or records):
        out.append("")
    for k, v in records.items():
        _note(out, path + [k])
        head = "[[" + ".".join(_key(p) for p in path + [k]) + "]]"
        for rec in v:
            out.append(head)
            for rk, rv in rec.items():
                out.append(f"{_key(rk)} = {_scalar(rv)}")
            out.append("")
    for k, v in subs.items():
        _emit_table(out, path + [k], v)


_TOP_ORDER = ["schema", "desktop", "apps", "system", "sync"]


def emit(doc):
    ordered = {k: doc[k] for k in _TOP_ORDER if k in doc}
    ordered.update({k: v for k, v in doc.items() if k not in ordered})
    out = [HEADER]
    _emit_table(out, [], ordered)
    return "\n".join(out).rstrip() + "\n"


# ── document I/O ─────────────────────────────────────────────────────────────

def load():
    try:
        with open(CONF, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        return {"schema": SCHEMA}


def save(doc):
    doc["schema"] = SCHEMA
    os.makedirs(EWE_DIR, exist_ok=True)
    text = emit(doc)
    tomllib.loads(text)  # never persist something we cannot read back
    fd, tmp = tempfile.mkstemp(dir=EWE_DIR, prefix=".ewe.conf.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, CONF)
    except BaseException:
        os.unlink(tmp)
        raise


class locked:
    def __enter__(self):
        os.makedirs(EWE_DIR, exist_ok=True)
        self.f = open(os.path.join(EWE_DIR, ".lock"), "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        self.f.close()


def dig(doc, dotted, create=False):
    *parts, last = dotted.split(".")
    node = doc
    for p in parts:
        if p not in node or not isinstance(node[p], dict):
            if not create:
                return None, last
            node[p] = {}
        node = node[p]
    return node, last


# ── runtime-file mappings (Phase 1 domains) ──────────────────────────────────

def _rj(name, default):
    try:
        with open(os.path.join(QS, name)) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def _wj(name, data):
    path = os.path.join(QS, name)
    os.makedirs(QS, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=QS, prefix=f".{name}.")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


THEME_MAP = [  # ewe.conf key ↔ user-theme.json key (with defaults)
    ("desktop.theme.color_scheme", "colorScheme", "dark"),
    ("desktop.theme.accent", "accent", "#0a84ff"),
    ("desktop.theme.theme_name", "themeName", "flock"),
    ("desktop.theme.tint_borders", "tintBorders", True),
    ("desktop.theme.window_transparency", "windowTransparency", False),
    ("desktop.theme.avatar_shape", "avatarShape", "circle"),
    ("desktop.dock.enabled", "dockEnabled", True),
    ("desktop.dock.autohide", "dockAutohide", False),
    ("desktop.dock.icon_size", "dockIconSize", "medium"),
    ("desktop.animations.speed", "animationSpeed", 1),
    ("desktop.tiling.enabled", "tilingEnabled", True),
    ("desktop.power.low_power", "lowPowerEnabled", True),
    ("desktop.power.lid_docked_suspend", "lidDockedSuspend", False),
    ("desktop.power.saver", "saver",
     {"enabled": True, "lock": False, "lockAfterMin": 5, "min": 5, "style": "clock"}),
]


def do_import():
    doc = load()
    ut = _rj("user-theme.json", {})
    for ck, jk, dflt in THEME_MAP:
        node, last = dig(doc, ck, create=True)
        node[last] = ut.get(jk, dflt)
    an = _rj("animations.json", None)
    if an is not None:
        node, last = dig(doc, "desktop.animations.detail", create=True)
        node[last] = an
    node, last = dig(doc, "apps.pinned", create=True)
    node[last] = _rj("pinned-apps.json", [])
    node, last = dig(doc, "apps.startup", create=True)
    node[last] = _rj("startup-apps.json", {"apps": []}).get("apps", [])
    node, last = dig(doc, "apps.places", create=True)
    node[last] = _rj("places.json", [])
    dp = _rj("display-profiles.json", None)
    if dp is not None:
        node, last = dig(doc, "desktop.displays", create=True)
        node[last] = dp
    wr = _rj("window-rules.json", None)
    if wr is not None:
        node, last = dig(doc, "desktop.window_rules", create=True)
        node[last] = wr.get("rules", [])
    try:
        with open(os.path.join(HYPR_GEN, "keybinds.lua")) as f:
            kb = parse_keybinds_lua(f.read())
        if kb:
            node, last = dig(doc, "desktop.keybinds", create=True)
            node[last] = kb
    except FileNotFoundError:
        pass
    try:
        with open(os.path.join(HYPR_GEN, "user.lua")) as f:
            lay = parse_user_lua(f.read())
        if lay is not None:
            node, last = dig(doc, "desktop.layout", create=True)
            node[last] = lay
    except FileNotFoundError:
        pass
    try:
        with open(os.path.join(HYPR_GEN, "input.lua")) as f:
            parsed = parse_input_lua(f.read())
        if parsed is not None:
            parsed["devices"] = _rj("input-devices.json", {})
            node, last = dig(doc, "desktop.input", create=True)
            node[last] = parsed
    except FileNotFoundError:
        pass
    try:
        with open(os.path.join(HYPR_GEN, "wallpapers.conf")) as f:
            node, last = dig(doc, "desktop.wallpapers", create=True)
            node[last] = parse_wallpapers_conf(f.read())
    except FileNotFoundError:
        # nothing configured → the shipped default (resolved through the
        # config farm so every install type finds its own copy)
        default_wp = os.path.realpath(os.path.join(
            QS, "..", "..", "system", "branding", "wallpapers", "ewe-dark.png"))
        if os.path.exists(default_wp):
            node, last = dig(doc, "desktop.wallpapers", create=True)
            node[last] = {"mode": "fill", "mute": True,
                          "default": default_wp, "outputs": {}}
    # [system] flags reflect what the machine actually has: import must not
    # claim gaming=false on a box with Steam installed (flags only raise)
    import shutil
    sysd = doc.setdefault("system", {})
    if shutil.which("steam"):
        sysd["gaming"] = True
    else:
        sysd.setdefault("gaming", False)
    if shutil.which("mise") and shutil.which("zeditor"):
        sysd["development"] = True
    else:
        sysd.setdefault("development", False)
    doc.setdefault("sync", {}).setdefault("enabled", False)
    save(doc)
    return doc


def do_apply(doc, only=None, hooks=True):
    def want(domain):
        return only is None or only == domain

    if want("theme"):
        ut = _rj("user-theme.json", {})
        for ck, jk, dflt in THEME_MAP:
            node, last = dig(doc, ck)
            ut[jk] = (node or {}).get(last, dflt)
        _wj("user-theme.json", ut)
    if want("animations"):
        node, last = dig(doc, "desktop.animations.detail")
        detail = (node or {}).get(last) if node else None
        if detail:
            _wj("animations.json", detail)
            node, last = dig(doc, "desktop.animations.speed")
            mult = (node or {}).get(last, 1) if node else 1
            # trailing extra \n matches the UIs' write_config, which appends
            # one — byte-identical files or nothing
            _wtext(os.path.join(HYPR_GEN, "animations.lua"),
                   gen_animations_lua(detail, mult) + "\n")
    if want("apps"):
        node, last = dig(doc, "apps.pinned")
        if node and last in node:
            _wj("pinned-apps.json", node[last])
        node, last = dig(doc, "apps.startup")
        if node and last in node:
            _wj("startup-apps.json", {"apps": node[last]})
        node, last = dig(doc, "apps.places")
        if node and last in node:
            _wj("places.json", node[last])
    if want("displays"):
        node, last = dig(doc, "desktop.displays")
        if node and last in node:
            _wj("display-profiles.json", node[last])
    if want("window_rules"):
        node, last = dig(doc, "desktop.window_rules")
        if node and last in node:
            _wj("window-rules.json", {"rules": node[last]})
            _wtext(os.path.join(HYPR_GEN, "windowrules.lua"),
                   gen_windowrules_lua(node[last]))
    if want("wallpapers"):
        node, last = dig(doc, "desktop.wallpapers")
        if node and last in node:
            # trailing extra \n matches the shell's heredoc atomicWrite
            _wtext(os.path.join(HYPR_GEN, "wallpapers.conf"),
                   gen_wallpapers_conf(node[last]) + "\n")
    # user.lua depends on layout AND theme/animations/tiling — any of them
    # changing regenerates it. Gated on desktop.layout existing, so machines
    # that haven't migrated keep their UI-written file untouched.
    if want("theme") or want("animations") or want("layout"):
        node, last = dig(doc, "desktop.layout")
        if node and last in node:
            # trailing extra \n matches the shell's heredoc atomicWrite
            _wtext(os.path.join(HYPR_GEN, "user.lua"), gen_user_lua(doc) + "\n")
    if want("keybinds"):
        node, last = dig(doc, "desktop.keybinds")
        if node and last in node and isinstance(node[last], list):
            # trailing extra \n matches the shell's heredoc atomicWrite
            _wtext(os.path.join(HYPR_GEN, "keybinds.lua"),
                   gen_keybinds_lua(node[last]) + "\n")
    if want("input"):
        node, last = dig(doc, "desktop.input")
        if node and last in node:
            st = dict(node[last])
            devices = st.pop("devices", {}) or {}
            _wj("input-devices.json", devices)
            # trailing extra \n matches the shell's heredoc atomicWrite
            _wtext(os.path.join(HYPR_GEN, "input.lua"),
                   gen_input_lua(st, devices) + "\n")

    if hooks:
        if want("theme"):
            cs = os.path.join(QS, "scripts", "colorscheme.sh")
            node, last = dig(doc, "desktop.theme.color_scheme")
            scheme = (node or {}).get(last, "dark") if node else "dark"
            node, last = dig(doc, "desktop.theme.accent")
            accent = ((node or {}).get(last, "#0a84ff") if node else "#0a84ff").lstrip("#")
            if os.path.exists(cs):
                subprocess.run(["sh", cs, scheme, accent],
                               capture_output=True, timeout=120)
        subprocess.run(["qs", "ipc", "call", "settings", "reload"],
                       capture_output=True, timeout=10)


# ── Phase-4 generators: static lua/conf artifacts derived purely from the ──
# ── file. Runtime-reactive artifacts (hypridle.conf, monitors.lua) stay ────
# ── shell-generated from conf-owned state (battery/hotplug events). ────────

HYPR_GEN = os.path.join(CFG_DIR, "hypr", "generated")

ANIM_CURVES = [  # ported from ewe-settings hypr.js — keep in lockstep
    ("snap", [[0.16, 1], [0.3, 1]], None),
    ("easeOutQuint", [[0.23, 1], [0.32, 1]], None),
    ("quick", [[0.15, 0], [0.1, 1]], None),
    ("easeInOutCubic", [[0.65, 0.05], [0.36, 1]], None),
    ("overshoot", [[0.34, 1.56], [0.64, 1]], None),
    ("linear", [[0, 0], [1, 1]], None),
    ("spring", None, {"mass": 1, "stiffness": 71.2633, "dampening": 15.8273644}),
]
ANIM_LEAVES = ["windows", "windowsOut", "fade", "workspaces", "layers", "border"]
_SPRING = {c[0] for c in ANIM_CURVES if c[2]}


def _n(x):
    """JS-style number: integral floats print without the .0"""
    if isinstance(x, float) and x.is_integer():
        return str(int(x))
    return str(x)


def _bool_lua(b):
    return "true" if b else "false"


def _anim_leaf(leaf, a, mult):
    if not a.get("on"):
        return f'hl.animation({{ leaf = "{leaf}", enabled = false }})'
    sp = max(0.1, a["ms"] / 100 / (mult if mult > 0 else 1))
    s = f'hl.animation({{ leaf = "{leaf}", enabled = true, speed = {sp:.2f}'
    kind = "spring" if a["curve"] in _SPRING else "bezier"
    s += f', {kind} = "{a["curve"]}"'
    style = a.get("style") or ""
    if style == "popin":
        style = f"popin {round(a.get('pct', 88))}%"
    if style:
        s += f', style = "{style}"'
    return s + " })"


def gen_animations_lua(detail, mult):
    lines = []
    for cid, pts, spring in ANIM_CURVES:
        if spring:
            lines.append(
                f'hl.curve("{cid}", {{ type = "spring", mass = {_n(spring["mass"])}, '
                f'stiffness = {_n(spring["stiffness"])}, dampening = {_n(spring["dampening"])} }})')
        else:
            lines.append(
                f'hl.curve("{cid}", {{ type = "bezier", points = {{ '
                f'{{{_n(pts[0][0])}, {_n(pts[0][1])}}}, {{{_n(pts[1][0])}, {_n(pts[1][1])}}} }} }})')
    on = bool(detail.get("enabled", True)) and mult > 0
    lines.append(f"hl.config({{ animations = {{ enabled = {_bool_lua(on)} }} }})")
    if on:
        g = detail.get("global", {"ms": 300, "curve": "snap"})
        lines.append(_anim_leaf("global", {"on": True, "ms": g["ms"], "curve": g["curve"]}, mult))
        for leaf in ANIM_LEAVES:
            a = detail.get("anims", {}).get(leaf)
            if a:
                lines.append(_anim_leaf(leaf, a, mult))
    return ("-- AUTO-GENERATED by Settings → Animations (ewe-settings). Do not edit by hand.\n"
            "-- Sourced after user.lua, so these win over the fallback speed-multiplier block.\n"
            + "\n".join(lines) + "\n")


def _lua_esc(s):
    return str(s).replace("\\", "\\\\").replace('"', '\\"')


def _regex_esc(s):
    return re.sub(r"[.*+?^${}()|\[\]\\]", lambda m: "\\" + m.group(0), str(s))


def gen_windowrules_lua(rules):
    s = "-- AUTO-GENERATED by Settings → Window Rules. Do not edit by hand.\n"
    n = 0
    for r in rules or []:
        klass = str(r.get("class") or "").strip()
        try:
            ws = int(float(r.get("workspace") or 0))
        except (TypeError, ValueError):
            ws = 0
        mode = r.get("mode") if r.get("mode") in ("float", "tile") else ""
        if not klass or (ws <= 0 and not mode):
            continue
        n += 1
        s += "hl.window_rule({\n"
        s += f'    name  = "user-rule-{n}",\n'
        s += f'    match = {{ class = "(?i)^{_lua_esc(_regex_esc(klass))}$" }},\n'
        if ws > 0:
            s += f'    workspace = "{ws}",\n'
        if mode:
            s += f"    {mode} = true,\n"
        s += "})\n"
    return s


def gen_wallpapers_conf(w):
    s = "# AUTO-GENERATED by Settings → Wallpaper. Do not edit by hand.\n"
    s += f"mode={w.get('mode', 'fill')}\n"
    s += f"mute={1 if w.get('mute', True) else 0}\n"
    if w.get("backend"):
        s += f"backend={w['backend']}\n"
    if w.get("default"):
        s += f"*={w['default']}\n"
    for out in sorted(w.get("outputs") or {}):
        s += f"{out}={w['outputs'][out]}\n"
    return s


# ── desktop.input — RFC-001 Phase 4 residue, landed 0.6: the input.lua ─────
# ── generator lives HERE now; both UIs persist through `set desktop.input` ──
# ── and keep only their live-apply (hyprctl eval) strings. ──────────────────

INPUT_DEFAULTS = {
    "kb_layout": "us", "kb_variant": "", "kb_options": "", "repeat_rate": 25,
    "repeat_delay": 600, "numlock_by_default": False, "sensitivity": 0,
    "accel_profile": "", "natural_scroll": False, "left_handed": False,
    "scroll_factor": 1,
    "tp_natural_scroll": True, "tp_tap": True, "tp_dwt": True,
    "tp_clickfinger": False, "tp_scroll_factor": 1, "tp_mbe": False,
    "tp_drag_lock": False, "tp_tap_drag": True,
}


def _lua_esc(s):
    return str(s).replace("\\", "\\\\").replace('"', '\\"')


def _lua_bool(b):
    return "true" if b else "false"


def _lua_num(v):
    # match JS ToString: 1.0 prints as 1, 0.5 as 0.5
    if isinstance(v, float) and v.is_integer():
        return str(int(v))
    return str(v)


def gen_input_lua(inp, devices):
    p = {**INPUT_DEFAULTS, **inp}
    line = ('hl.config({ input = { kb_layout = "%s", kb_variant = "%s", kb_options = "%s"'
            % (_lua_esc(p["kb_layout"]), _lua_esc(p["kb_variant"]), _lua_esc(p["kb_options"])))
    line += ", repeat_rate = %s, repeat_delay = %s" % (_lua_num(p["repeat_rate"]), _lua_num(p["repeat_delay"]))
    line += ", numlock_by_default = " + _lua_bool(p["numlock_by_default"])
    line += ", sensitivity = " + _lua_num(p["sensitivity"])
    if p.get("accel_profile", "") != "":
        line += ', accel_profile = "%s"' % _lua_esc(p["accel_profile"])
    line += ", natural_scroll = %s, left_handed = %s" % (_lua_bool(p["natural_scroll"]), _lua_bool(p["left_handed"]))
    line += ", scroll_factor = " + _lua_num(p["scroll_factor"])
    line += ", touchpad = { natural_scroll = %s, tap_to_click = %s" % (_lua_bool(p["tp_natural_scroll"]), _lua_bool(p["tp_tap"]))
    line += ", disable_while_typing = %s, clickfinger_behavior = %s" % (_lua_bool(p["tp_dwt"]), _lua_bool(p["tp_clickfinger"]))
    line += ", scroll_factor = %s, middle_button_emulation = %s" % (_lua_num(p["tp_scroll_factor"]), _lua_bool(p["tp_mbe"]))
    line += ", drag_lock = %s, tap_and_drag = %s } } })" % (_lua_bool(p["tp_drag_lock"]), _lua_bool(p["tp_tap_drag"]))
    out = "-- AUTO-GENERATED by Settings → Keyboard & Mouse. Do not edit by hand.\n" + line + "\n"
    for name in sorted(devices or {}):
        o = devices[name]
        L = 'hl.device({ name = "%s"' % _lua_esc(name)
        if "sensitivity" in o:
            L += ", sensitivity = " + _lua_num(o["sensitivity"])
        if "natural_scroll" in o:
            L += ", natural_scroll = " + _lua_bool(o["natural_scroll"])
        if "left_handed" in o:
            L += ", left_handed = " + _lua_bool(o["left_handed"])
        if o.get("accel_profile"):
            L += ', accel_profile = "%s"' % _lua_esc(o["accel_profile"])
        out += L + " })\n"
    return out


# ── desktop.layout — user.lua joins the file (0.6): gaps/border/rounding ────
# ── live here; tint/accent/transparency/speed/tiling come from their own ────
# ── domains, so ANY of those changing regenerates the artifact. ─────────────

ANIM_BASE = [  # hyprland.lua's shipped "snappy" block — three-way lockstep
    {"leaf": "global", "s": 3, "bz": "snap"},
    {"leaf": "border", "s": 3, "bz": "easeOutQuint"},
    {"leaf": "windows", "s": 2.8, "bz": "snap", "style": "popin 92%"},
    {"leaf": "windowsOut", "s": 1.8, "bz": "quick", "style": "popin 92%"},
    {"leaf": "fade", "s": 1.8, "bz": "quick"},
    {"leaf": "layers", "s": 2, "bz": "quick", "style": "fade"},
    {"leaf": "workspaces", "s": 2.8, "bz": "snap", "style": "slide"},
]


def _anim_lua_lines(m):
    if m <= 0:
        return ["hl.config({ animations = { enabled = false } })"]
    L = ["hl.config({ animations = { enabled = true } })"]
    for a in ANIM_BASE:
        s = 'hl.animation({ leaf = "%s", enabled = true, speed = %.2f' % (a["leaf"], a["s"] / m)
        if a.get("bz"):
            s += ', bezier = "%s"' % a["bz"]
        if a.get("style"):
            s += ', style = "%s"' % a["style"]
        L.append(s + " })")
    return L


def _hex6(c):
    s = str(c).replace("#", "")
    return s[2:] if len(s) == 8 else s


def gen_user_lua(doc):
    def gv(key, dflt):
        node, last = dig(doc, key)
        return (node or {}).get(last, dflt) if node else dflt

    lay = gv("desktop.layout", {}) or {}
    s = "-- AUTO-GENERATED by the Quickshell Settings app. Do not edit by hand.\n"
    gen = "hl.config({ general = { gaps_in = %s, gaps_out = %s, border_size = %s" % (
        _lua_num(lay.get("gaps_in", 6)), _lua_num(lay.get("gaps_out", 14)),
        _lua_num(lay.get("border_size", 1)))
    if gv("desktop.theme.tint_borders", True):
        gen += ', col = { active_border = "rgba(%sff)" }' % _hex6(gv("desktop.theme.accent", "#0a84ff"))
    s += gen + " } })\n"
    s += "hl.config({ decoration = { rounding = %s } })\n" % _lua_num(lay.get("rounding", 12))
    s += ("hl.config({ decoration = { active_opacity = 1.0, inactive_opacity = %s } })\n"
          % ("0.97" if gv("desktop.theme.window_transparency", False) else "1.0"))
    speed = gv("desktop.animations.speed", 1)
    if abs(speed - 1) >= 0.001:
        s += "\n".join(_anim_lua_lines(speed)) + "\n"
    tiling = gv("desktop.tiling", {}) or {}
    if not tiling.get("enabled", True):
        s += 'hl.window_rule({ name = "float-all", match = { class = ".*" }, float = true })\n'
    return s


def parse_user_lua(text):
    """import: only the four layout numbers live here — everything else in
    the file is derived from domains the import already covers"""
    import re
    m = re.search(r"gaps_in = (\d+), gaps_out = (\d+), border_size = (\d+)", text)
    r = re.search(r"rounding = (\d+)", text)
    if not m:
        return None
    out = {"gaps_in": int(m.group(1)), "gaps_out": int(m.group(2)),
           "border_size": int(m.group(3))}
    if r:
        out["rounding"] = int(r.group(1))
    return out


# ── desktop.keybinds — [[desktop.keybinds]] {combo, exec} records: the ─────
# ── user's own launch bindings, synced like everything else. Exec binds ─────
# ── only — a bind that runs a command is data; arbitrary dispatchers are ────
# ── config surgery and stay in hyprland.lua's territory. ────────────────────


def gen_keybinds_lua(binds):
    s = ("-- AUTO-GENERATED by ewe-conf from [[desktop.keybinds]]. Do not edit by hand.\n"
         "-- Add binds with: ewe-conf set desktop.keybinds "
         "'[{\"combo\": \"SUPER + T\", \"exec\": \"kitty\"}]'\n")
    for b in binds:
        combo = str(b.get("combo", "")).strip()
        exe = str(b.get("exec", "")).strip()
        if not combo or not exe:
            continue
        s += 'hl.bind("%s", hl.dsp.exec_cmd("%s"))\n' % (_lua_esc(combo), _lua_esc(exe))
    return s


def parse_keybinds_lua(text):
    import re
    out = []
    for m in re.finditer(r'hl\.bind\("((?:[^"\\]|\\.)*)", hl\.dsp\.exec_cmd\("((?:[^"\\]|\\.)*)"\)\)', text):
        out.append({"combo": _lua_unesc(m.group(1)), "exec": _lua_unesc(m.group(2))})
    return out


def _lua_unesc(s):
    return s.replace('\\"', '"').replace("\\\\", "\\")


def parse_input_lua(text):
    """the reverse road, for `import` — the file is machine-written, so the
    format is exact; scroll_factor appears twice, split at the touchpad brace"""
    import re
    m = re.search(r"hl\.config\(\{ input = \{ (.*) \} \}\)", text)
    if not m:
        return None
    body = m.group(1)
    top, _, tp = body.partition(", touchpad = {")

    def grab(src, key, kind):
        mm = re.search(key + r' = "((?:[^"\\]|\\.)*)"' if kind == "s"
                       else key + r" = (true|false)" if kind == "b"
                       else key + r" = (-?[0-9.]+)", src)
        if not mm:
            return None
        v = mm.group(1)
        if kind == "s":
            return _lua_unesc(v)
        if kind == "b":
            return v == "true"
        return float(v) if "." in v else int(v)

    inp = {}
    for key, kind in [("kb_layout", "s"), ("kb_variant", "s"), ("kb_options", "s"),
                      ("repeat_rate", "n"), ("repeat_delay", "n"),
                      ("numlock_by_default", "b"), ("sensitivity", "n"),
                      ("accel_profile", "s"), ("natural_scroll", "b"),
                      ("left_handed", "b"), ("scroll_factor", "n")]:
        v = grab(top, key, kind)
        if v is not None:
            inp[key] = v
    for lua_key, our_key, kind in [("natural_scroll", "tp_natural_scroll", "b"),
                                   ("tap_to_click", "tp_tap", "b"),
                                   ("disable_while_typing", "tp_dwt", "b"),
                                   ("clickfinger_behavior", "tp_clickfinger", "b"),
                                   ("scroll_factor", "tp_scroll_factor", "n"),
                                   ("middle_button_emulation", "tp_mbe", "b"),
                                   ("drag_lock", "tp_drag_lock", "b"),
                                   ("tap_and_drag", "tp_tap_drag", "b")]:
        v = grab(tp, lua_key, kind)
        if v is not None:
            inp[our_key] = v
    return inp


def parse_wallpapers_conf(text):
    w = {"mode": "fill", "mute": True, "outputs": {}}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        if k == "mode":
            w["mode"] = v
        elif k == "mute":
            w["mute"] = v not in ("0", "false")
        elif k == "backend":
            w["backend"] = v
        elif k == "*":
            w["default"] = v
        else:
            w["outputs"][k] = v
    return w


def _wtext(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".gen.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


# ── RFC-002: sync of the one file (Drive appDataFolder via ewe-auth) ────────
# Boring by design: push after writes (30s debounce, only when [sync].enabled
# and signed in), pull ONLY on demand, newest-wins with the loser kept as
# ewe.conf.<ts>.bak. appDataFolder is app-scoped hidden storage — the file
# never appears in the user's visible Drive.

# EWE_CONF_DRIVE_BASE: tests point this at a local mock Drive
# (tests/ewe-conf-sync-test.sh) — production never sets it.
_DRIVE_BASE = os.environ.get("EWE_CONF_DRIVE_BASE", "https://www.googleapis.com")
DRIVE_FILES = _DRIVE_BASE + "/drive/v3/files"
DRIVE_UPLOAD = _DRIVE_BASE + "/upload/drive/v3/files"
PUSH_STAMP = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "ewe-conf-push.stamp")


def _auth_token():
    if os.environ.get("EWE_CONF_TEST_TOKEN"):     # tests only — skip ewe-auth
        return os.environ["EWE_CONF_TEST_TOKEN"]
    # realpath, not abspath: this file is reached through the ~/.config
    # symlink farm, and lexical `..` collapsing lands in the wrong directory
    ea = os.path.join(os.path.dirname(os.path.realpath(__file__)), "ewe-auth")
    if not os.path.exists(ea):
        ea = "ewe-auth"
    try:
        r = subprocess.run([ea, "token"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    tok = r.stdout.strip().splitlines()[-1] if r.stdout.strip() else ""
    return tok if r.returncode == 0 and len(tok) > 20 and not tok.startswith("{") else None


def _drive(method, url, token, body=None, ctype="application/json"):
    import urllib.request
    import urllib.error
    req = urllib.request.Request(url, method=method, data=body,
                                 headers={"Authorization": "Bearer " + token,
                                          **({"Content-Type": ctype} if body else {})})
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read()
            return (json.loads(raw) if raw and raw.strip().startswith(b"{") else raw), None
    except urllib.error.HTTPError as e:
        return None, f"http-{e.code}: {e.read().decode()[:160]}"
    except OSError as e:
        return None, f"network: {e}"


def _remote_find(token):
    import urllib.parse
    q = urllib.parse.quote("name='ewe.conf'")
    url = (f"{DRIVE_FILES}?spaces=appDataFolder&q={q}"
           "&fields=files(id,name,modifiedTime,appProperties)")
    j, err = _drive("GET", url, token)
    if err:
        return None, err
    files = j.get("files", [])
    return (files[0] if files else None), None


def _rfc3339_epoch(ts):
    """Drive modifiedTime ('2026-09-01T00:12:34.567Z') → epoch seconds, or 0."""
    import datetime
    try:
        return int(datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp())
    except (ValueError, AttributeError):
        return 0


def _machine():
    import socket
    return socket.gethostname() or "unknown"


def do_push(quiet=False, force=False):
    token = _auth_token()
    if not token:
        return {"ok": False, "error": "not-signed-in"}
    try:
        content = open(CONF, "rb").read()
        local_mtime = int(os.path.getmtime(CONF))
    except OSError:
        return {"ok": False, "error": "no-local-file"}
    remote, err = _remote_find(token)
    if err:
        return {"ok": False, "error": err}
    # Conflict guard (RFC-002 newest-wins): a remote SAVED AFTER our local
    # file was last edited means another machine has the newer document —
    # pushing would clobber it. Refuse; `push --force` overrides, `pull`
    # adopts theirs (and keeps ours as .bak).
    if remote and not force:
        rt = _rfc3339_epoch(remote.get("modifiedTime", ""))
        if rt > local_mtime + 5 and remote.get("appProperties", {}).get("machine") != _machine():
            return {"ok": False, "error": "remote-newer", "remote": remote,
                    "local_mtime": local_mtime}
    props = {"machine": _machine(), "schema": "1"}
    if remote:
        j, err = _drive("PATCH", f"{DRIVE_UPLOAD}/{remote['id']}?uploadType=media",
                        token, content, "application/toml")
        if not err:
            # media upload can't carry metadata — stamp the manifest after
            _drive("PATCH", f"{DRIVE_FILES}/{remote['id']}", token,
                   json.dumps({"appProperties": props}).encode())
    else:
        boundary = "eweconfboundary"
        meta = json.dumps({"name": "ewe.conf", "parents": ["appDataFolder"],
                           "appProperties": props})
        body = (f"--{boundary}\r\nContent-Type: application/json\r\n\r\n{meta}\r\n"
                f"--{boundary}\r\nContent-Type: application/toml\r\n\r\n").encode()                + content + f"\r\n--{boundary}--".encode()
        j, err = _drive("POST", f"{DRIVE_UPLOAD}?uploadType=multipart",
                        token, body, f"multipart/related; boundary={boundary}")
    if err:
        return {"ok": False, "error": err}
    with open(PUSH_STAMP, "w") as f:
        f.write(str(int(__import__("time").time())))
    return {"ok": True, "id": j.get("id", ""), "bytes": len(content),
            "machine": props["machine"]}


def do_pull(out_path=None):
    token = _auth_token()
    if not token:
        return {"ok": False, "error": "not-signed-in"}
    remote, err = _remote_find(token)
    if err:
        return {"ok": False, "error": err}
    if not remote:
        return {"ok": False, "error": "nothing-synced"}
    raw, err = _drive("GET", f"{DRIVE_FILES}/{remote['id']}?alt=media", token)
    if err:
        return {"ok": False, "error": err}
    if isinstance(raw, dict):
        raw = json.dumps(raw).encode()
    tomllib.loads(raw.decode())          # never write a document we can't read
    target = out_path or CONF
    backed_up = ""
    if not out_path and os.path.exists(CONF):
        import time as _t
        backed_up = CONF + "." + _t.strftime("%Y%m%d-%H%M%S") + ".bak"
        os.replace(CONF, backed_up)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with open(target, "wb") as f:
        f.write(raw)
    return {"ok": True, "bytes": len(raw), "modified": remote.get("modifiedTime", ""),
            "backup": backed_up, "written": target}


def maybe_auto_push(doc):
    """fire-and-forget push after a write — only when the user opted in,
    debounced so bursts of Settings changes cost one upload."""
    node, last = dig(doc, "sync.enabled")
    if not (node and node.get(last)):
        return
    try:
        with open(PUSH_STAMP) as f:
            import time as _t
            if _t.time() - int(f.read().strip() or 0) < 30:
                return
    except OSError:
        pass
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "push", "--quiet"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── CLI ──────────────────────────────────────────────────────────────────────

def parse_value(raw):
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return raw


def main(argv):
    # --no-hooks anywhere: suppress the colorscheme + settings-reload pokes.
    # The shell passes it because it live-applies itself and IS the thing the
    # reload poke would target.
    hooks = "--no-hooks" not in argv
    argv = [a for a in argv if a != "--no-hooks"]
    cmd = argv[0] if argv else "help"
    if cmd == "path":
        print(CONF)
    elif cmd == "dump":
        print(json.dumps(load(), indent=2))
    elif cmd == "get" and len(argv) == 2:
        node, last = dig(load(), argv[1])
        if node is None or last not in node:
            return 1
        v = node[last]
        print(json.dumps(v) if isinstance(v, (dict, list, bool)) else v)
    elif cmd == "set" and len(argv) == 3:
        with locked():
            doc = load()
            node, last = dig(doc, argv[1], create=True)
            node[last] = parse_value(argv[2])
            save(doc)
            do_apply(doc, only=_domain(argv[1]), hooks=hooks)
            maybe_auto_push(doc)
    elif cmd == "unset" and len(argv) == 2:
        with locked():
            doc = load()
            node, last = dig(doc, argv[1])
            if node and last in node:
                del node[last]
                save(doc)
                do_apply(doc, only=_domain(argv[1]), hooks=hooks)
    elif cmd == "absorb" and len(argv) == 3 and argv[1] == "user-theme":
        # legacy adapter: a full user-theme.json object from a Settings UI —
        # the jk→conf mapping stays HERE so no caller ever duplicates it
        ut = json.loads(argv[2])
        with locked():
            doc = load()
            for ck, jk, dflt in THEME_MAP:
                if jk in ut:
                    node, last = dig(doc, ck, create=True)
                    node[last] = ut[jk]
            save(doc)
            do_apply(doc, only="theme", hooks=hooks)
    elif cmd == "sync-status":
        token = _auth_token()
        if not token:
            print(json.dumps({"ok": False, "error": "not-signed-in"}))
            return 0
        remote, err = _remote_find(token)
        local_mtime = None
        try:
            local_mtime = int(os.path.getmtime(CONF))
        except OSError:
            pass
        print(json.dumps({"ok": err is None,
                          "error": err,
                          "remote": remote,
                          "local_mtime": local_mtime}))
    elif cmd == "push":
        print(json.dumps(do_push(quiet="--quiet" in argv, force="--force" in argv)))
    elif cmd == "pull":
        outp = None
        if "--out" in argv:
            outp = argv[argv.index("--out") + 1]
        print(json.dumps(do_pull(outp)))
    elif cmd == "import":
        with locked():
            do_import()
        print(CONF)
    elif cmd == "apply":
        only = None
        args = argv[1:]
        while args:
            a = args.pop(0)
            if a == "--only" and args:
                only = args.pop(0)
        with locked():
            do_apply(load(), only=only, hooks=hooks)
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


def _domain(dotted):
    # first meaningful routing segment: desktop.<domain>… or apps.* / system.*
    parts = dotted.split(".")
    if parts[0] == "desktop" and len(parts) > 1:
        return {"theme": "theme", "dock": "theme", "tiling": "theme",
                "power": "theme", "animations": "animations",
                "displays": "displays", "window_rules": "window_rules",
                "wallpapers": "wallpapers", "input": "input",
                "layout": "layout", "keybinds": "keybinds",
                }.get(parts[1], None)
    if parts[0] == "apps":
        return "apps"
    return None


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
