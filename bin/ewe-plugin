#!/usr/bin/env python3
"""ewe-plugin — third-party shell plugins: a git URL in, files on disk, one config bit.

A plugin is a git repository whose root holds a manifest.json:

    {
      "schemaVersion": 1,
      "id": "acme.weather",              <namespace>.<name>, lowercase; "ewe." is reserved
      "name": "Weather",
      "version": "0.1.0",
      "apiVersion": 2,                   the shell's plugin API (PluginHost.apiVersion)
      "kinds": ["panel", "service"],
      "entryPoints": { "panel": "Panel.qml", "service": "Service.qml" },
      "description": "…", "homepage": "…", "author": "…"      (optional)
    }

Installed plugins live in ~/.config/ewe/plugins/<id>/ — OUTSIDE the ewe payload,
so upgrades never touch them. At startup the shell (PluginHost.qml) asks this
tool what is there (`list --json`) and instantiates every enabled entry point
by absolute path; the plugin's QML imports the shell's modules like any
first-party file (`import qs` → Theme, Globals). Which ids are enabled and
where each came from is the [plugins] table of ewe.conf, written only through
ewe-conf (RFC-001) — so it syncs with the rest of the machine, and `list`
points out a plugin that is enabled here but not installed yet.

Trust model (Omarchy's, copied on purpose): installing NEVER runs plugin code —
no hooks, no privileges. It clones, validates the manifest, and flips a config
bit. The code runs unsandboxed inside your shell process the moment it is
enabled, so read it first. Enabling and disabling restart the shell
(ewe.service); there is no QML hot-reload.

    add <git-url> [--enable] [--yes]   clone, validate, record the source (a first-party
                                       URL or id that ships in the payload installs from it)
    list [--json]                      every plugin: enabled, version, kinds; --json also
                                       lists the payload's add-ons (`available`) and `removed`
    info <id> [--json]                 one plugin's manifest + state
    enable <id> [--no-restart]         add to [plugins].enabled, restart the shell
    disable <id> [--no-restart]
    update [id] [--yes]                fast-forward git-managed plugins — the diff is
                                       shown first, and a manifest that stops
                                       validating is rolled back
    remove <id> [--yes]                delete a git clone; a hand-made directory is
                                       moved to <id>.bak.<stamp> instead
    validate <path>                    check a manifest + its entry points (exit 1 on problems)
    restore [--yes]                    clone every plugin ewe.conf knows that is not here
    install <id> [--no-restart]        an ADD-ON from the payload: copy, source bundled, enable (JSON)
    migrate [--no-restart] [--fresh]   one-time: install the add-ons that replace features an
                                       upgrader had built in (ewe-setup/install.sh run it; JSON)
    seed [dir] [--restore <id>]        the payload's default plugins + refresh installed copies
    path                               print the plugins directory
    boot-ok                            (the shell calls this) a start survived a minute

Add-ons (0.25): every first-party plugin ships INSIDE the ewe payload
(plugins/<id>/ + plugins/bundle.json) but is NOT installed on a fresh
machine — Komble's Add-ons page, the Welcome screen and `install` put one in
with one click. `bundle.json` says which ids are `default` (seeded on every
machine) and which `migrate` (installed once for upgraders who had the
feature built in). The migration marker is ~/.local/state/ewe/addons-migrated
— local, never synced (ewe.conf is).

[plugins.sources] IS the installed set: `add` records a plugin there whether or
not it is enabled, `remove` forgets it, and the file syncs — so on another
machine `list` shows every plugin this one had, on, off or "not installed",
and `restore` fetches the missing ones from their git URLs (never automatic).

`add` also takes a plain local directory — your own plugin in progress — and
copies it in as a hand-made plugin (no git, so `update` has nothing to pull;
`remove` parks it as a backup rather than deleting it). Its source is recorded
as "local": there is nothing another machine could fetch, and restore says so.

The crash guard: ewe.service relaunches the shell a second after any crash,
so a plugin that compiles and then crashes is a login loop with no desktop.
Every shell start calls `list --json --boot`; the third start inside a minute
answers "safe mode" — the host loads nothing, tells the user which plugins
were on, and the budget resets so the next deliberate restart tries again.
A start that survives a minute reports `boot-ok`. Deliberate restarts (this
tool's own enable/disable/remove) do not count.

Kinds: service (headless), panel, overlay, menu — the host instantiates all of
them the same way and the plugin owns its windows and IPC. bar-widget is an
Item the bar packs like a built-in indicator; "barWidget": {"defaultSection":
"left" | "center" | "right"} picks the section (right when absent), and the
Settings → Top bar map hides it under the key plugin:<id>. API 3 adds
quick-tile (a Quick settings home tile, "quickTile": {span, order}),
quick-page (a Quick settings page + rail entry, "quickPage": {key, label,
icon, order}), bar-status (a glyph inside the bar's Quick settings pill,
"barStatus": {order}) and dock-item (a static dock button, "dockItem":
{icon, label, action, order} — no entry point; the dock runs the action).

Python stdlib only, like every other ewe tool. Machine-facing verbs print one
JSON object; the rest talk to a person.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
import tomllib

API_VERSION = 3                 # what `create` writes and the host reports
API_VERSIONS = (2, 3)           # what the host (PluginHost.qml) still loads
SCHEMA = 1
KINDS = ("service", "panel", "overlay", "menu", "bar-widget", "desktop-widget",
         "quick-tile", "quick-page", "bar-status", "dock-item")
# the API-3 kinds: a v2 manifest may not use them
V3_KINDS = ("quick-tile", "quick-page", "bar-status", "dock-item")
# a dock item is static (icon + label + action in the manifest) — no QML
NO_ENTRY_KINDS = ("dock-item",)
# Quick settings pages the shell keeps for itself; a plugin page cannot take
# these keys (vpn/ssh/cast/mobile/mail are NOT here: those pages move out)
QS_CORE_KEYS = ("home", "wifi", "bt", "audio", "cal", "notifs")
# icons are Theme property NAMES ("icMusic"), resolved by the host as Theme[icon]
ICON_RE = re.compile(r"^ic[A-Z][A-Za-z0-9]*$")
QS_KEY_RE = re.compile(r"^[a-z][a-z0-9_-]{0,23}$")
ACTION_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
IPC_TARGET_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
PKG_RE = re.compile(r"^[a-z0-9][a-z0-9@._+-]*$")
CMD_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*$")
# a plugin's declared options -- what Komble renders as a form and the shell
# hands the plugin as `settings`; values live in ewe.conf plugins.settings.<id>
SETTING_TYPES = ("bool", "int", "string", "choice", "color")
SETTING_KEY_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
WIDGET_LAYERS = ("desktop", "top")
# a manifest keybind: {"combo": "SUPER + P", "ipc": "passwords toggle"} —
# generated into hypr/generated/plugin-keybinds.lua as `qs ipc call <ipc>`
IPC_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*( [A-Za-z0-9_.:/-]+)*$")

RESERVED_PREFIX = "ewe."
ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}(\.[a-z0-9][a-z0-9_-]{0,31})+$")
SOURCE_RE = re.compile(r"^(https?://|git://|ssh://|git@|file://)")

CFG_DIR = (os.environ.get("XDG_CONFIG_HOME")
           or os.path.join(os.path.expanduser("~"), ".config"))
EWE_DIR = os.path.join(CFG_DIR, "ewe")
CONF = os.path.join(EWE_DIR, "ewe.conf")
PLUGINS_DIR = os.path.join(EWE_DIR, "plugins")
SHELL_UNIT = "ewe.service"
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME")
                         or os.path.join(os.path.expanduser("~"), ".local", "state"), "ewe")
BOOTS = os.path.join(STATE_DIR, "plugin-boots.json")
CRASH_WINDOW = 60     # seconds
CRASH_LIMIT = 3       # shell starts inside the window → safe mode
# first-party plugins ship INSIDE the payload (plugins/<id>/, vendored from
# their own repos, listed in plugins/bundle.json). Only those may use the
# reserved "ewe." namespace. Found through the REAL path of this tool:
# ~/.local/bin/ewe-plugin is a symlink into ~/.local/share/ewe/bin, so
# realpath lands in the deployed payload (abspath used to resolve the LINK's
# directory — ~/.local/plugins — and `seed --restore` seeded nothing). The
# package installs a copy at /usr/bin, hence the fallbacks; EWE_PAYLOAD_PLUGINS
# overrides for tests and the nested harness.
def _payload_plugins():
    env = os.environ.get("EWE_PAYLOAD_PLUGINS")
    if env:
        return os.path.abspath(env)
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    cands = [os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "plugins"),
             os.path.join(data_home, "ewe", "plugins"),
             os.path.join(os.path.expanduser("~"), ".local", "share", "ewe", "plugins"),
             "/usr/share/ewe/plugins"]
    for c in cands:
        if os.path.isdir(c):
            return c
    return cands[0]


PAYLOAD_PLUGINS = _payload_plugins()
BUNDLE = "bundle.json"          # plugins/bundle.json: {"plugins": {id: {repo, commit, version, default, migrate}}}
# the one-time add-on migration's marker (plan D3): a JSON file naming the
# add-ons already CONSIDERED, so an add-on that moves out of the shell in a
# later release is still migrated for the users who had it built in
MIGRATED = os.path.join(STATE_DIR, "addons-migrated")
HYPR_GEN = os.path.join(CFG_DIR, "hypr", "generated")
PLUGIN_KEYBINDS = os.path.join(HYPR_GEN, "plugin-keybinds.lua")


def die(msg, code=1):
    print("ewe-plugin: " + msg, file=sys.stderr)
    sys.exit(code)


def say(msg=""):
    print(msg, flush=True)   # keep order with stderr when piped


# ── the ONE file: read directly (tomllib), write only through ewe-conf ────────

def ewe_conf_exe():
    # The sibling first, PATH second — the same rule ewe-conf itself uses to
    # find ewe-theme: the tool beside this one is the one that matches it.
    sib = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ewe-conf")
    return sib if os.path.exists(sib) else shutil.which("ewe-conf")


def conf_state():
    try:
        with open(CONF, "rb") as f:
            doc = tomllib.load(f)
    except (FileNotFoundError, tomllib.TOMLDecodeError):
        doc = {}
    p = doc.get("plugins") or {}
    enabled = [x for x in (p.get("enabled") or []) if isinstance(x, str)]
    sources = {k: v for k, v in (p.get("sources") or {}).items() if isinstance(v, str)}
    return enabled, sources


def conf_table(dotted):
    """A table out of ewe.conf, {} when absent (read directly, like conf_state)."""
    try:
        with open(CONF, "rb") as f:
            doc = tomllib.load(f)
    except (FileNotFoundError, tomllib.TOMLDecodeError):
        return {}
    node = doc
    for part in dotted.split("."):
        node = node.get(part) if isinstance(node, dict) else None
        if node is None:
            return {}
    return node if isinstance(node, dict) else {}


def poke_shell_reload():
    """Placement and settings change LIVE: the host re-reads `list --json`
    on this poke (PluginHost.reload) -- no shell restart."""
    if shutil.which("qs"):
        subprocess.run(["qs", "ipc", "call", "plugins", "reload"], capture_output=True, timeout=10)


def conf_set(key, value):
    exe = ewe_conf_exe()
    if not exe:
        die("ewe-conf not found — it ships beside this tool; is the ewe payload deployed?")
    # --no-hooks: nothing the shell reads live changes here, and the shell is
    # about to be restarted anyway
    r = subprocess.run([exe, "set", "--no-hooks", key, json.dumps(value)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die("ewe-conf set %s failed: %s" % (key, (r.stderr or r.stdout).strip()))


def set_enabled(ids):
    conf_set("plugins.enabled", sorted(set(ids)))


def set_sources(sources):
    conf_set("plugins.sources", dict(sorted(sources.items())))


def conf_removed():
    """ids of bundled plugins the user removed — seeding must not bring them back."""
    return [x for x in (conf_table("plugins").get("removed") or []) if isinstance(x, str)]


def set_removed(ids):
    conf_set("plugins.removed", sorted(set(ids)))


def _in_payload(d):
    try:
        return os.path.realpath(d).startswith(os.path.realpath(PAYLOAD_PLUGINS) + os.sep)
    except OSError:
        return False


def write_plugin_keybinds():
    """generated/plugin-keybinds.lua from every enabled, valid plugin's
    manifest `keybinds`; Hyprland is reloaded when the file changed. Called
    from restart_shell, so every verb that changes the set regenerates it."""
    lines = ["-- AUTO-GENERATED by ewe-plugin from enabled plugins' manifest keybinds. Do not edit by hand.",
             "-- Each bind calls the plugin's own IPC target: `qs ipc call <target> <verb>`."]
    for e in scan():
        if not (e["enabled"] and e["installed"] and e["valid"]):
            continue
        for kb in e.get("keybinds") or []:
            lines.append('hl.bind("%s", hl.dsp.exec_cmd("qs ipc call %s"))' % (
                kb["combo"].replace("\\", "\\\\").replace('"', '\\"'), kb["ipc"]))
    text = "\n".join(lines) + "\n"
    try:
        with open(PLUGIN_KEYBINDS) as f:
            if f.read() == text:
                return False
    except OSError:
        pass
    os.makedirs(HYPR_GEN, exist_ok=True)
    tmp = PLUGIN_KEYBINDS + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, PLUGIN_KEYBINDS)
    if shutil.which("hyprctl") and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=15)
    return True


# ── manifests ─────────────────────────────────────────────────────────────────

def read_manifest(d):
    path = os.path.join(d, "manifest.json")
    try:
        with open(path) as f:
            m = json.load(f)
    except FileNotFoundError:
        return None, ["no manifest.json"]
    except json.JSONDecodeError as e:
        return None, ["manifest.json is not valid JSON: %s" % e]
    if not isinstance(m, dict):
        return None, ["manifest.json must be a JSON object"]
    return m, []


def validate_manifest(d, m, expect_dirname=None, allow_reserved=False):
    """Every problem, not just the first — a plugin author fixes them in one pass."""
    p = []
    if m.get("schemaVersion") != SCHEMA:
        p.append("schemaVersion must be %d" % SCHEMA)
    pid = m.get("id")
    if not isinstance(pid, str) or not ID_RE.match(pid):
        p.append("id must be <namespace>.<name> in lowercase [a-z0-9_-] (e.g. \"acme.weather\")")
    elif pid.startswith(RESERVED_PREFIX) and not (allow_reserved or _in_payload(d)):
        p.append("the \"%s\" namespace is reserved for ewe's own (bundled) plugins" % RESERVED_PREFIX)
    elif expect_dirname is not None and pid != expect_dirname:
        p.append("id \"%s\" does not match the directory name \"%s\"" % (pid, expect_dirname))
    if not isinstance(m.get("name"), str) or not m["name"].strip():
        p.append("name must be a non-empty string")
    if not isinstance(m.get("version"), str) or not m["version"].strip():
        p.append("version must be a string (e.g. \"0.1.0\")")
    api = m.get("apiVersion", API_VERSION)
    if not isinstance(api, int) or isinstance(api, bool):
        p.append("apiVersion must be an integer")
        api = API_VERSION
    elif api not in API_VERSIONS:
        p.append("apiVersion %d is not supported by this shell (wants one of %s)" % (api, ", ".join(map(str, API_VERSIONS))))
    kinds = m.get("kinds")
    if not isinstance(kinds, list) or not kinds:
        p.append("kinds must be a non-empty list")
        kinds = []
    else:
        for k in kinds:
            if k not in KINDS:
                p.append("unknown kind \"%s\" (one of: %s)" % (k, ", ".join(KINDS)))
            elif k in V3_KINDS and api < 3:
                p.append("kind \"%s\" needs apiVersion 3" % k)
        if len(set(kinds)) != len(kinds):
            p.append("kinds lists the same kind twice")
    eps = m.get("entryPoints")
    if not isinstance(eps, dict):
        p.append("entryPoints must be an object mapping each kind to a .qml file")
        eps = {}
    for k in kinds:
        if k in KINDS and k not in NO_ENTRY_KINDS and k not in eps:
            p.append("kind \"%s\" has no entry point" % k)
    real_dir = os.path.realpath(d)
    for k, rel in eps.items():
        if k not in kinds:
            p.append("entryPoints.%s is not listed in kinds" % k)
        if not isinstance(rel, str) or not rel.endswith(".qml"):
            p.append("entryPoints.%s must be a .qml path" % k)
            continue
        if rel.startswith("/") or ".." in rel.split("/"):
            p.append("entryPoints.%s must be relative and inside the plugin (no / or ..)" % k)
            continue
        full = os.path.join(d, rel)
        if not os.path.isfile(full):
            p.append("entryPoints.%s: %s does not exist" % (k, rel))
        elif not os.path.realpath(full).startswith(real_dir + os.sep):
            # a symlink pointing out of the tree would load code the user
            # never saw in the clone
            p.append("entryPoints.%s: %s resolves outside the plugin directory" % (k, rel))
    bw = m.get("barWidget")
    if bw is not None and not isinstance(bw, dict):
        p.append("barWidget must be an object")
    elif isinstance(bw, dict) and "defaultSection" in bw and bw["defaultSection"] not in ("left", "center", "right"):
        p.append("barWidget.defaultSection must be left, center or right")
    dw = m.get("desktopWidget")
    if dw is not None and not isinstance(dw, dict):
        p.append("desktopWidget must be an object")
    elif isinstance(dw, dict):
        for k in ("x", "y"):
            if k in dw and (not isinstance(dw[k], (int, float)) or isinstance(dw[k], bool)):
                p.append("desktopWidget.%s must be a number" % k)
        if "layer" in dw and dw["layer"] not in WIDGET_LAYERS:
            p.append("desktopWidget.layer must be desktop or top")
    # ── API 3 fields ──────────────────────────────────────────────────────
    def _int(obj, key, where):
        if key in obj and (not isinstance(obj[key], int) or isinstance(obj[key], bool)):
            p.append("%s.%s must be an integer" % (where, key))
    aliases = []
    al = m.get("ipcAliases")
    if al is not None:
        if not isinstance(al, list) or not all(isinstance(a, str) and IPC_TARGET_RE.match(a) for a in al):
            p.append("ipcAliases must be a list of IPC target names (lowercase [a-z0-9._-])")
        elif isinstance(pid, str) and not pid.startswith(RESERVED_PREFIX):
            p.append("ipcAliases: only first-party (\"%s\") plugins may claim legacy IPC targets" % RESERVED_PREFIX)
        else:
            aliases = list(al)
    qt = m.get("quickTile")
    if qt is not None and not isinstance(qt, dict):
        p.append("quickTile must be an object {span, order}")
    elif isinstance(qt, dict):
        if "span" in qt and qt["span"] not in (1, 2):
            p.append("quickTile.span must be 1 or 2")
        _int(qt, "order", "quickTile")
    qp = m.get("quickPage")
    if "quick-page" in kinds and not isinstance(qp, dict):
        p.append("kind quick-page needs \"quickPage\": {key, label, icon, order}")
    elif qp is not None and not isinstance(qp, dict):
        p.append("quickPage must be an object {key, label, icon, order}")
    elif isinstance(qp, dict):
        key = qp.get("key")
        if not isinstance(key, str) or not QS_KEY_RE.match(key):
            p.append("quickPage.key must be lowercase [a-z0-9_-] starting with a letter (e.g. \"vpn\")")
        elif key in QS_CORE_KEYS:
            p.append("quickPage.key \"%s\" belongs to the shell (reserved: %s)" % (key, ", ".join(QS_CORE_KEYS)))
        if not isinstance(qp.get("label"), str) or not qp["label"].strip():
            p.append("quickPage.label must be a non-empty string")
        if "icon" in qp and (not isinstance(qp["icon"], str) or not ICON_RE.match(qp["icon"])):
            p.append("quickPage.icon must be a Theme icon name like \"icShield\"")
        _int(qp, "order", "quickPage")
    bs = m.get("barStatus")
    if bs is not None and not isinstance(bs, dict):
        p.append("barStatus must be an object {order}")
    elif isinstance(bs, dict):
        _int(bs, "order", "barStatus")
    di = m.get("dockItem")
    if "dock-item" in kinds and not isinstance(di, dict):
        p.append("kind dock-item needs \"dockItem\": {icon, label, action, order}")
    elif di is not None and not isinstance(di, dict):
        p.append("dockItem must be an object {icon, label, action, order}")
    elif isinstance(di, dict):
        if not isinstance(di.get("icon"), str) or not ICON_RE.match(di["icon"]):
            p.append("dockItem.icon must be a Theme icon name like \"icMusic\"")
        if not isinstance(di.get("label"), str) or not di["label"].strip():
            p.append("dockItem.label must be a non-empty string")
        if "action" in di and (not isinstance(di["action"], str) or not ACTION_RE.match(di["action"])):
            p.append("dockItem.action must be an action name like \"ewe.media.toggle\"")
        _int(di, "order", "dockItem")
    rq = m.get("requires")
    if rq is not None and not isinstance(rq, dict):
        p.append("requires must be an object {packages: [...], commands: [...]}")
    elif isinstance(rq, dict):
        for key, rx in (("packages", PKG_RE), ("commands", CMD_RE)):
            v = rq.get(key)
            if v is not None and (not isinstance(v, list) or not all(isinstance(x, str) and rx.match(x) for x in v)):
                p.append("requires.%s must be a list of names" % key)
        for key in rq:
            if key not in ("packages", "commands"):
                p.append("requires.%s: unknown (packages, commands)" % key)
    if "icon" in m and (not isinstance(m["icon"], str) or not ICON_RE.match(m["icon"])):
        p.append("icon must be a Theme icon name like \"icStar\"")
    if "category" in m and (not isinstance(m["category"], str) or not m["category"].strip()):
        p.append("category must be a non-empty string")
    kbs = m.get("keybinds")
    if kbs is not None and not isinstance(kbs, list):
        p.append("keybinds must be a list of {combo, ipc}")
    elif isinstance(kbs, list):
        for i, kb in enumerate(kbs):
            if not isinstance(kb, dict) or not isinstance(kb.get("combo"), str) or not kb["combo"].strip():
                p.append("keybinds[%d] needs a combo like \"SUPER + P\"" % i)
            elif not isinstance(kb.get("ipc"), str) or not IPC_RE.match(kb["ipc"]):
                p.append("keybinds[%d].ipc must be \"<target> <verb> [args]\"" % i)
            elif api >= 3 and isinstance(pid, str) and kb["ipc"].split()[0] not in [pid] + aliases:
                # API 3: a keybind reaches the plugin's own target or one of
                # its declared aliases — never another component's
                p.append("keybinds[%d].ipc must target this plugin (%s)" % (i, ", ".join([pid] + aliases)))
    st = m.get("settings")
    if st is not None and not isinstance(st, list):
        p.append("settings must be a list of {key, type, default, label}")
    elif isinstance(st, list):
        seen = set()
        for i, o in enumerate(st):
            if not isinstance(o, dict):
                p.append("settings[%d] must be an object" % i)
                continue
            key = o.get("key")
            if not isinstance(key, str) or not SETTING_KEY_RE.match(key):
                p.append("settings[%d].key must be lowercase [a-z0-9_] starting with a letter" % i)
                continue
            if key in seen:
                p.append("settings.%s is declared twice" % key)
            seen.add(key)
            typ = o.get("type")
            if typ not in SETTING_TYPES:
                p.append("settings.%s.type must be one of %s" % (key, ", ".join(SETTING_TYPES)))
                continue
            if "default" not in o:
                p.append("settings.%s needs a default" % key)
            elif setting_check(o, o["default"]) is not None:
                p.append("settings.%s.default: %s" % (key, setting_check(o, o["default"])))
            if typ == "choice" and not (isinstance(o.get("choices"), list) and o["choices"]):
                p.append("settings.%s (choice) needs a non-empty choices list" % key)
    return p


def setting_check(spec, value):
    """None when `value` fits `spec`, else the reason."""
    t = spec.get("type")
    if t == "bool":
        return None if isinstance(value, bool) else "must be true or false"
    if t == "int":
        if not isinstance(value, int) or isinstance(value, bool):
            return "must be an integer"
        lo, hi = spec.get("min"), spec.get("max")
        if isinstance(lo, (int, float)) and value < lo:
            return "must be at least %s" % lo
        if isinstance(hi, (int, float)) and value > hi:
            return "must be at most %s" % hi
        return None
    if t == "string":
        return None if isinstance(value, str) else "must be a string"
    if t == "choice":
        return None if value in (spec.get("choices") or []) else "must be one of %s" % ", ".join(map(str, spec.get("choices") or []))
    if t == "color":
        ok = isinstance(value, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", value)
        return None if ok else "must be a #rrggbb colour"
    return "unknown type"


def setting_coerce(spec, raw):
    """A CLI string -> the typed value the spec wants (or die)."""
    t = spec.get("type")
    if t == "bool":
        if raw.lower() in ("1", "true", "yes", "on"):
            return True
        if raw.lower() in ("0", "false", "no", "off"):
            return False
        die("%s: must be true or false" % spec["key"])
    if t == "int":
        try:
            v = int(raw)
        except ValueError:
            die("%s: must be an integer" % spec["key"])
        why = setting_check(spec, v)
        if why:
            die("%s: %s" % (spec["key"], why))
        return v
    why = setting_check(spec, raw)
    if why:
        die("%s: %s" % (spec["key"], why))
    return raw


def effective_settings(m, pid):
    """{key: value} -- the manifest's defaults under the user's values (only
    values that still fit the schema count; a stale one falls back)."""
    out = {}
    vals = conf_table("plugins.settings").get(pid) or {}
    for o in (m.get("settings") or []) if isinstance(m.get("settings"), list) else []:
        if not isinstance(o, dict) or not isinstance(o.get("key"), str):
            continue
        v = vals.get(o["key"], o.get("default"))
        out[o["key"]] = v if setting_check(o, v) is None else o.get("default")
    return out


def effective_widget(m, pid):
    """Where a desktop widget sits: the user's placement over the manifest's
    defaults. {x, y, output, layer, visible}"""
    dw = m.get("desktopWidget") if isinstance(m.get("desktopWidget"), dict) else {}
    user = conf_table("plugins.widgets").get(pid) or {}
    w = {"x": dw.get("x", 48), "y": dw.get("y", 64), "output": dw.get("output", ""),
         "layer": dw.get("layer", "desktop"), "visible": True}
    for k in ("x", "y"):
        if isinstance(user.get(k), (int, float)) and not isinstance(user.get(k), bool):
            w[k] = user[k]
    if isinstance(user.get("output"), str):
        w["output"] = user["output"]
    if user.get("layer") in WIDGET_LAYERS:
        w["layer"] = user["layer"]
    if isinstance(user.get("visible"), bool):
        w["visible"] = user["visible"]
    return w


def describe(d, dirname=None, enabled=(), sources=None):
    """One plugin as the shell and `list --json` see it."""
    dirname = dirname or os.path.basename(d.rstrip("/"))
    m, problems = read_manifest(d)
    pid0 = m.get("id") if isinstance(m, dict) and isinstance(m.get("id"), str) else dirname
    if m is not None:
        problems = validate_manifest(d, m, expect_dirname=dirname,
                                     allow_reserved=((sources or {}).get(pid0) == "bundled"))
    else:
        m = {}
    pid = m.get("id") if isinstance(m.get("id"), str) else dirname
    return {
        "id": pid,
        "dir": os.path.abspath(d),
        "dirname": dirname,
        "installed": True,
        "git": os.path.isdir(os.path.join(d, ".git")),
        "source": (sources or {}).get(pid),
        "name": m.get("name"),
        "version": m.get("version"),
        "description": m.get("description"),
        "homepage": m.get("homepage"),
        "author": m.get("author"),
        "apiVersion": m.get("apiVersion", API_VERSION),
        "kinds": m.get("kinds") if isinstance(m.get("kinds"), list) else [],
        "entryPoints": m.get("entryPoints") if isinstance(m.get("entryPoints"), dict) else {},
        "barWidget": m.get("barWidget") if isinstance(m.get("barWidget"), dict) else None,
        # desktop widgets: where it sits (user placement over the manifest's
        # defaults); settings: the declared schema and the effective values
        "widget": effective_widget(m, pid) if "desktop-widget" in (m.get("kinds") or []) else None,
        "settingsSchema": m.get("settings") if isinstance(m.get("settings"), list) else [],
        "settings": effective_settings(m, pid),
        "linked": os.path.islink(d.rstrip("/")),
        "bundled": (sources or {}).get(pid) == "bundled",
        "keybinds": [kb for kb in (m.get("keybinds") or []) if isinstance(kb, dict)] if isinstance(m.get("keybinds"), list) else [],
        # API 3 (docs/PLUGINS.md "Kinds"): the host reads these to place the
        # tile, the page + rail entry, the pill glyph and the dock button
        "quickTile": m.get("quickTile") if isinstance(m.get("quickTile"), dict) else None,
        "quickPage": m.get("quickPage") if isinstance(m.get("quickPage"), dict) else None,
        "barStatus": m.get("barStatus") if isinstance(m.get("barStatus"), dict) else None,
        "dockItem": m.get("dockItem") if isinstance(m.get("dockItem"), dict) else None,
        "requires": _requires(m),
        "ipcAliases": [a for a in (m.get("ipcAliases") or []) if isinstance(a, str)] if isinstance(m.get("ipcAliases"), list) else [],
        "icon": m.get("icon") if isinstance(m.get("icon"), str) else None,
        "category": m.get("category") if isinstance(m.get("category"), str) else None,
        "enabled": pid in enabled,
        "valid": not problems,
        "problems": problems,
    }


def _requires(m):
    rq = m.get("requires") if isinstance(m.get("requires"), dict) else {}
    return {"packages": [x for x in (rq.get("packages") or []) if isinstance(x, str)] if isinstance(rq.get("packages"), list) else [],
            "commands": [x for x in (rq.get("commands") or []) if isinstance(x, str)] if isinstance(rq.get("commands"), list) else []}


def scan():
    enabled, sources = conf_state()
    out = []
    seen = set()
    if os.path.isdir(PLUGINS_DIR):
        for name in sorted(os.listdir(PLUGINS_DIR)):
            d = os.path.join(PLUGINS_DIR, name)
            # .tmp-* clones in flight, *.bak.* from remove, dotfiles
            if name.startswith(".") or ".bak." in name or not os.path.isdir(d):
                continue
            e = describe(d, name, enabled, sources)
            out.append(e)
            seen.add(e["id"])
    # known to ewe.conf (installed on the machine that wrote it, on or off)
    # but not (yet) here — the synced-file case
    for pid in sorted(set(enabled) | set(sources)):
        if pid not in seen:
            src = sources.get(pid)
            why = ("not installed — a local directory on another machine, nothing to fetch"
                   if src == "local" else "not installed")
            out.append({"id": pid, "dir": None, "dirname": None, "installed": False,
                        "git": False, "source": src, "name": None,
                        "version": None, "description": None, "homepage": None,
                        "author": None, "apiVersion": None, "kinds": [],
                        "entryPoints": {}, "barWidget": None, "widget": None,
                        "settingsSchema": [], "settings": {}, "linked": False,
                        "bundled": src == "bundled", "keybinds": [],
                        "quickTile": None, "quickPage": None, "barStatus": None, "dockItem": None,
                        "requires": {"packages": [], "commands": []}, "ipcAliases": [],
                        "icon": None, "category": None,
                        "enabled": pid in enabled, "valid": False, "problems": [why]})
    return out


def missing_ids(plugins):
    """What `restore` would fetch: known, absent, and fetchable."""
    # "local" and "bundled" cannot be fetched: one came from a directory, the
    # other from the ewe package (`restore` installs those from the payload)
    return [p["id"] for p in plugins if not p["installed"] and p["source"] and p["source"] not in ("local", "bundled")]


# ── the payload: plugins/<id>/ + plugins/bundle.json ──────────────────────────

def bundle_meta(src_dir=None):
    """{id: {repo, commit, version, default, migrate}} from bundle.json, {} when
    the payload has none (then nothing is default and nothing migrates)."""
    try:
        with open(os.path.join(src_dir or PAYLOAD_PLUGINS, BUNDLE)) as f:
            j = json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}
    p = j.get("plugins") if isinstance(j, dict) else None
    return {k: v for k, v in (p or {}).items() if isinstance(v, dict)}


def payload_plugins(src_dir=None):
    """Every plugin directory in the payload: [(id, dir, manifest, problems)],
    by id. A directory without a manifest is not a plugin and is skipped;
    one that fails validation is listed with its problems so `available`
    can say why it cannot be installed."""
    d0 = src_dir or PAYLOAD_PLUGINS
    out = []
    if not os.path.isdir(d0):
        return out
    for name in sorted(os.listdir(d0)):
        d = os.path.join(d0, name)
        if name.startswith(".") or not os.path.isdir(d):
            continue
        m, problems = read_manifest(d)
        if m is None:
            continue
        problems = validate_manifest(d, m, expect_dirname=name, allow_reserved=True)
        pid = m.get("id") if isinstance(m.get("id"), str) else name
        out.append((pid, d, m, problems))
    return out


def payload_find(pid, src_dir=None):
    for p, d, m, problems in payload_plugins(src_dir):
        if p == pid:
            return d, m, problems
    return None, None, ["\"%s\" is not in the payload (%s)" % (pid, src_dir or PAYLOAD_PLUGINS)]


_PKG_PRESENT = None


def _packages_present(names):
    """The subset of `names` pacman knows as installed. One `pacman -Q` per
    process; without pacman (a dev host) every name counts as present —
    reporting is honest only where it can be."""
    global _PKG_PRESENT
    names = sorted(set(names))
    if not names:
        return set()
    if _PKG_PRESENT is None:
        _PKG_PRESENT = {}
    todo = [n for n in names if n not in _PKG_PRESENT]
    if todo:
        if not shutil.which("pacman"):
            for n in todo:
                _PKG_PRESENT[n] = True
        else:
            try:
                r = subprocess.run(["pacman", "-Q", *todo], capture_output=True, text=True, timeout=20)
                have = {ln.split()[0] for ln in r.stdout.splitlines() if ln.strip()}
            except (OSError, subprocess.TimeoutExpired):
                have = set(todo)
            for n in todo:
                _PKG_PRESENT[n] = n in have
    return {n for n in names if _PKG_PRESENT.get(n)}


def check_requires(req):
    """{packages: [missing], commands: [missing]} — reported, never installed
    by this tool (Komble offers the packages; plan D7)."""
    pk = req.get("packages") or []
    have = _packages_present(pk)
    return {"packages": [p for p in pk if p not in have],
            "commands": [c for c in (req.get("commands") or []) if not shutil.which(c)]}


def available_list(plugins=None, src_dir=None):
    """`list --json`'s `available`: every add-on the payload carries, with
    its install state — what Komble's Add-ons page and the Welcome screen
    render. `missing` says which declared packages/commands are absent."""
    plugins = plugins if plugins is not None else scan()
    by_id = {p["id"]: p for p in plugins}
    meta = bundle_meta(src_dir)
    removed = set(conf_removed())
    out = []
    for pid, d, m, problems in payload_plugins(src_dir):
        req = _requires(m)
        inst = by_id.get(pid)
        bm = meta.get(pid) or {}
        out.append({
            "id": pid,
            "name": m.get("name"),
            "description": m.get("description"),
            "icon": m.get("icon") if isinstance(m.get("icon"), str) else None,
            "category": m.get("category") if isinstance(m.get("category"), str) else None,
            "version": m.get("version"),
            "apiVersion": m.get("apiVersion", API_VERSION),
            "kinds": m.get("kinds") if isinstance(m.get("kinds"), list) else [],
            "repo": bm.get("repo") if isinstance(bm.get("repo"), str) else (m.get("homepage") if isinstance(m.get("homepage"), str) else None),
            "default": bm.get("default") is True,
            "migrate": bm.get("migrate") is True,
            "installed": bool(inst and inst["installed"]),
            "enabled": bool(inst and inst["enabled"]),
            "source": inst["source"] if inst else None,
            "removed": pid in removed,
            "requires": req,
            "missing": check_requires(req),
            "valid": not problems,
            "problems": problems,
        })
    return out


def install_from_payload(pid, src_dir=None, enable=True):
    """Copy plugins/<id> out of the payload into the user's plugins dir with
    source "bundled" (what `seed` does for defaults), forget a removal, and
    enable it. Returns (manifest, dest) or dies. Never runs plugin code."""
    d, m, problems = payload_find(pid, src_dir)
    if d is None:
        die(problems[0])
    if problems:
        die("%s does not validate:\n%s" % (pid, "".join("  ! %s\n" % x for x in problems).rstrip()))
    dest = os.path.join(PLUGINS_DIR, pid)
    if os.path.islink(dest):
        die("\"%s\" is a linked working copy (ewe-plugin dev) — `ewe-plugin remove %s` first" % (pid, pid))
    enabled, sources = conf_state()
    if os.path.exists(dest):
        if sources.get(pid) not in (None, "bundled"):
            die("\"%s\" is already installed from %s — `ewe-plugin remove %s` first" % (pid, sources[pid], pid))
        cur, _ = read_manifest(dest)
        if (cur or {}).get("version") != m.get("version"):
            tmp = dest + ".tmp-install"
            shutil.rmtree(tmp, ignore_errors=True)
            shutil.copytree(d, tmp, symlinks=False)
            shutil.rmtree(dest)
            os.rename(tmp, dest)
    else:
        os.makedirs(PLUGINS_DIR, exist_ok=True)
        tmp = dest + ".tmp-install"
        shutil.rmtree(tmp, ignore_errors=True)
        shutil.copytree(d, tmp, symlinks=False)
        os.rename(tmp, dest)
    sources[pid] = "bundled"
    set_sources(sources)
    if pid in conf_removed():
        set_removed([x for x in conf_removed() if x != pid])
    if enable and pid not in enabled:
        set_enabled(enabled + [pid])
    return m, dest


def payload_match(src, src_dir=None):
    """The payload id a user-typed `add` argument means: a reserved id itself
    ("ewe.media"), the add-on's repository URL (bundle.json `repo`, or the
    manifest's homepage), or a prj786/ewe-plugin-<name> URL. None when it
    is not one of ours."""
    s = src.strip().rstrip("/")
    if s.endswith(".git"):
        s = s[:-4]
    ids = {pid: (m, problems) for pid, _, m, problems in payload_plugins(src_dir)}
    if ID_RE.match(s) and s in ids:
        return s
    if not SOURCE_RE.match(src):
        return None
    meta = bundle_meta(src_dir)
    for pid, (m, _) in ids.items():
        urls = [meta.get(pid, {}).get("repo"), m.get("homepage")]
        for u in urls:
            if isinstance(u, str) and u.strip().rstrip("/").removesuffix(".git") == s:
                return pid
    # https://github.com/prj786/ewe-plugin-clipboard → ewe.clipboard
    mm = re.search(r"/ewe-plugin-([a-z0-9_-]+)$", s)
    if mm and ("ewe." + mm.group(1)) in ids:
        return "ewe." + mm.group(1)
    return None


def find(pid):
    for e in scan():
        if e["id"] == pid:
            return e
    die("no plugin \"%s\" (see `ewe-plugin list`)" % pid)


# ── helpers ───────────────────────────────────────────────────────────────────

def git(args, cwd=None):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")   # never hang on a password prompt
    return subprocess.run(["git", *args], cwd=cwd, env=env, capture_output=True, text=True)


def confirm(prompt, yes):
    if yes:
        return True
    if not sys.stdin.isatty():
        die("this needs a confirmation; re-run with --yes from a script", 2)
    try:
        ans = input(prompt + " [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        say()
        return False
    return ans in ("y", "yes")


def restart_shell(wanted=True, quiet=False):
    """quiet: the JSON verbs (install, migrate) print one object and nothing
    else on stdout, so the human lines are dropped."""
    tell = (lambda *_: None) if quiet else say
    try:
        write_plugin_keybinds()
    except Exception as e:  # never let a keybind file stop an enable/disable
        tell("(plugin keybinds not written: %s)" % e)
    if not wanted:
        tell("(shell not restarted — the change applies at the next login or `systemctl --user restart %s`)" % SHELL_UNIT)
        return False
    if not shutil.which("systemctl"):
        return False
    r = subprocess.run(["systemctl", "--user", "is-active", "--quiet", SHELL_UNIT])
    if r.returncode != 0:
        tell("shell not running — the change applies at the next login")
        return False
    clear_boots(forget_safe=False)   # a deliberate restart must not count as a crash
    r = subprocess.run(["systemctl", "--user", "restart", SHELL_UNIT], capture_output=True, text=True)
    if r.returncode != 0:
        tell("could not restart the shell: %s" % (r.stderr or r.stdout).strip())
        return False
    tell("shell restarted")
    return True


def stamp():
    return time.strftime("%Y%m%d-%H%M%S")


def problems_block(e):
    return "".join("    ! %s\n" % x for x in e["problems"])


# ── the crash guard ───────────────────────────────────────────────────────────

def _boots_read():
    try:
        with open(BOOTS) as f:
            j = json.load(f)
        if isinstance(j, dict):
            return {"boots": [t for t in j.get("boots", []) if isinstance(t, (int, float))],
                    "last": j.get("last") if isinstance(j.get("last"), dict) else {},
                    "safe": j.get("safe") if isinstance(j.get("safe"), dict) else None}
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    return {"boots": [], "last": {}, "safe": None}


def _boots_write(st):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = BOOTS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f)
    os.replace(tmp, BOOTS)


def _crash_evidence():
    """What says the PREVIOUS shell instance died rather than exited: the
    newest Quickshell crash report (its handler writes one per crash under
    $XDG_CACHE_HOME/quickshell/crashes, also when it relaunches itself) and
    systemd's automatic-restart counter (Restart=on-failure; a SIGKILL/OOM
    the handler never sees). Both stay put across a deliberate restart —
    `systemctl --user restart` resets NRestarts to 0 and writes no report."""
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    newest = 0
    try:
        for d in os.scandir(os.path.join(cache, "quickshell", "crashes")):
            try:
                newest = max(newest, int(d.stat().st_mtime))
            except OSError:
                pass
    except OSError:
        pass
    nrestarts = 0
    if shutil.which("systemctl"):
        try:
            r = subprocess.run(["systemctl", "--user", "show", SHELL_UNIT, "-p", "NRestarts", "--value"],
                               capture_output=True, text=True, timeout=5)
            nrestarts = int((r.stdout or "0").strip() or 0)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
    return {"crash": newest, "nrestarts": nrestarts}


def record_boot(plugins):
    """One shell start. Counts it as a CRASH only when there is evidence the
    previous instance died (see _crash_evidence) — the user re-running the
    unit, a Settings "restart shell", ewe-setup after an upgrade, a dev
    `qs -p` are starts, not crashes, and used to trip safe mode after three
    inside a minute (2026-09-20). Returns the safe-mode record when this is
    the CRASH_LIMIT-th crash inside CRASH_WINDOW seconds and there is a
    plugin to blame; the budget resets then, so a fixed plugin gets a clean
    run."""
    st = _boots_read()
    now = int(time.time())
    ev = _crash_evidence()
    last = st.get("last") or {}
    crashed = ev["crash"] > last.get("crash", 0) or ev["nrestarts"] > last.get("nrestarts", 0)
    st["last"] = ev
    st["boots"] = [t for t in st["boots"] if now - t < CRASH_WINDOW] + ([now] if crashed else [])
    suspects = [p["id"] for p in plugins if p["enabled"] and p["installed"] and p["valid"]]
    if len(st["boots"]) >= CRASH_LIMIT and suspects:
        st = {"boots": [], "last": ev, "safe": {"at": now, "suspects": suspects}}
        _boots_write(st)
        return st["safe"]
    _boots_write(st)
    return None


def clear_boots(forget_safe):
    st = _boots_read()
    st["boots"] = []
    if forget_safe:
        st["safe"] = None
    _boots_write(st)


# ── verbs ─────────────────────────────────────────────────────────────────────

def cmd_add(args):
    yes = "--yes" in args
    enable = "--enable" in args
    rest = [a for a in args if not a.startswith("--")]
    if len(rest) != 1:
        die("usage: ewe-plugin add <git-url> [--enable] [--yes]", 2)
    src = rest[0]
    no_restart = "--no-restart" in args
    # one of ours? The three plugin repos' README and the vault say `add <url>`
    # — that used to be REFUSED (reserved namespace). The payload copy is the
    # same code at the version this ewe was built with: install that.
    ours = payload_match(src) if not os.path.isdir(src) else None
    if ours:
        say("%s ships inside ewe — installing the payload copy (%s)" % (ours, PAYLOAD_PLUGINS))
        m, dest = install_from_payload(ours, enable=enable)
        say("installed %s %s (%s) → %s" % (ours, m.get("version", ""), ", ".join(m.get("kinds") or []), dest))
        if enable:
            restart_shell(not no_restart)
        else:
            say("enable it with: ewe-plugin enable %s" % ours)
        return
    if not (SOURCE_RE.match(src) or os.path.isdir(src)):
        die("\"%s\" is not a git URL (https://, ssh://, git@…) or a local repository" % src)
    if os.path.isdir(src):
        src = os.path.abspath(src)
    if not shutil.which("git"):
        die("git is not installed")
    _, known = conf_state()
    for pid, url in known.items():
        if url == src and os.path.isdir(os.path.join(PLUGINS_DIR, pid)):
            die("that source is already installed as \"%s\" — `ewe-plugin update %s` pulls a newer version" % (pid, pid))
    say("Plugins run as unsandboxed code inside your shell process — the same rights as the desktop itself.")
    say("Source: %s" % src)
    say("Nothing is executed by installing; read the code before you enable it.")
    if not confirm("Clone it?", yes):
        die("cancelled", 1)

    m, dest = fetch(src)
    pid = m["id"]
    enabled, sources = conf_state()
    local = os.path.isdir(src) and not os.path.isdir(os.path.join(src, ".git"))
    sources[pid] = "local" if local else src
    set_sources(sources)
    if pid in conf_removed():
        set_removed([x for x in conf_removed() if x != pid])
    kinds = ", ".join(m.get("kinds") or [])
    say("installed %s %s (%s) → %s" % (pid, m.get("version", ""), kinds, dest))
    if enable:
        cmd_enable([pid] + (["--no-restart"] if no_restart else []))
    else:
        say("enable it with: ewe-plugin enable %s" % pid)


def fetch(src, expect_id=None):
    """Clone (or copy) `src` into the plugins dir, validated. Returns
    (manifest, dest). Dies — with the temp dir gone — on any failure."""
    os.makedirs(PLUGINS_DIR, exist_ok=True)
    tmp = os.path.join(PLUGINS_DIR, ".tmp-%d" % os.getpid())
    shutil.rmtree(tmp, ignore_errors=True)
    if os.path.isdir(src) and not os.path.isdir(os.path.join(src, ".git")):
        # a plain directory — someone's plugin in progress — becomes a
        # hand-made install: copied, never pulled, parked (not deleted) on remove
        shutil.copytree(src, tmp, symlinks=False)
    else:
        r = git(["clone", "--quiet", "--", src, tmp])
        if r.returncode != 0:
            shutil.rmtree(tmp, ignore_errors=True)
            die("git clone failed:\n%s" % r.stderr.strip())
    m, problems = read_manifest(tmp)
    if m is not None:
        problems = validate_manifest(tmp, m)
    if problems:
        shutil.rmtree(tmp, ignore_errors=True)
        die("not a valid ewe plugin:\n" + "".join("  ! %s\n" % x for x in problems).rstrip())
    pid = m["id"]
    if expect_id and pid != expect_id:
        shutil.rmtree(tmp, ignore_errors=True)
        die("%s serves \"%s\", but ewe.conf expected \"%s\"" % (src, pid, expect_id))
    dest = os.path.join(PLUGINS_DIR, pid)
    if os.path.exists(dest):
        shutil.rmtree(tmp, ignore_errors=True)
        die("\"%s\" is already installed — `ewe-plugin update %s` pulls a newer version" % (pid, pid))
    os.rename(tmp, dest)
    return m, dest


def cmd_restore(args):
    yes = "--yes" in args
    plugins = scan()
    todo = missing_ids(plugins)
    local = [p["id"] for p in plugins if not p["installed"] and p["source"] == "local"]
    # add-ons this ewe.conf had (source bundled, or enabled and in the
    # payload) come from the payload, not from git — the synced-file case
    # on a second machine, and the Welcome flow's restore step
    payload_ids = {pid for pid, _, _, problems in payload_plugins() if not problems}
    bundled = [p["id"] for p in plugins if not p["installed"]
               and (p["source"] == "bundled" or (p["enabled"] and not p["source"])) and p["id"] in payload_ids]
    got_bundled = []
    for pid in bundled:
        m, dest = install_from_payload(pid, enable=False)
        say("installed %s %s from the payload → %s" % (pid, m.get("version", ""), dest))
        got_bundled.append(pid)
    if not todo:
        if not got_bundled:
            say("nothing to restore" + (" — %s came from a local directory elsewhere; nothing to fetch" % ", ".join(local) if local else ""))
        elif any(p["enabled"] for p in plugins if p["id"] in got_bundled):
            restart_shell("--no-restart" not in args)
        return
    _, sources = conf_state()
    say("ewe.conf knows %d plugin%s that %s not installed here:" % (len(todo), "" if len(todo) == 1 else "s", "is" if len(todo) == 1 else "are"))
    for pid in todo:
        say("  %-24s %s" % (pid, sources[pid]))
    say("Plugins run as unsandboxed code inside your shell process; nothing is executed by installing.")
    if not confirm("Clone them all?", yes):
        die("cancelled", 1)
    if not shutil.which("git"):
        die("git is not installed")
    enabled, _ = conf_state()
    got = 0
    for pid in todo:
        m, dest = fetch(sources[pid], expect_id=pid)
        say("restored %s %s → %s%s" % (pid, m.get("version", ""), dest, "  (on)" if pid in enabled else "  (off)"))
        got += 1
    if local:
        say("skipped %s: a local directory on another machine — add it from its files if you have them" % ", ".join(local))
    if any(pid in enabled for pid in todo + got_bundled):
        restart_shell("--no-restart" not in args)


def cmd_list(args):
    plugins = scan()
    if "--json" in args:
        safe = record_boot(plugins) if "--boot" in args else None
        print(json.dumps({"ok": True, "apiVersion": API_VERSION, "apiVersions": list(API_VERSIONS),
                          "dir": PLUGINS_DIR, "payload": PAYLOAD_PLUGINS,
                          "plugins": plugins, "missing": missing_ids(plugins),
                          # the add-ons catalogue (Komble, Welcome) and the
                          # bundled ids the user removed — offered back from there
                          "available": available_list(plugins),
                          "removed": conf_removed(),
                          "safeMode": bool(safe),
                          "suspects": safe["suspects"] if safe else []}))
        return
    safe = _boots_read()["safe"]
    if safe:
        say("! safe mode: the shell crashed %d times within a minute (%s) and loaded no plugins that session."
            % (CRASH_LIMIT, time.strftime("%Y-%m-%d %H:%M", time.localtime(safe.get("at", 0)))))
        say("  enabled at the time: %s — `ewe-plugin disable <id>` the culprit; a start that stays up a minute clears this."
            % ", ".join(safe.get("suspects", [])))
        say()
    if not plugins:
        say("no plugins installed (%s)" % PLUGINS_DIR)
        say("add one with: ewe-plugin add <git-url> --enable")
        return
    rows = []
    for e in plugins:
        state = "on" if e["enabled"] else "off"
        if not e["installed"]:
            hint = " — ewe-plugin restore" if e["source"] and e["source"] != "local" else ""
            rows.append((e["id"], state, "—", "—", e["problems"][0] + hint))
        elif not e["valid"]:
            rows.append((e["id"], state, e["version"] or "—", ",".join(e["kinds"]) or "—", "INVALID: " + e["problems"][0]))
        else:
            rows.append((e["id"], state, e["version"], ",".join(e["kinds"]), e["name"] or ""))
    w = [max(len(r[i]) for r in rows + [("ID", "ON", "VERSION", "KINDS", "NAME")]) for i in range(4)]
    fmt = "%%-%ds  %%-%ds  %%-%ds  %%-%ds  %%s" % tuple(w)
    say(fmt % ("ID", "ON", "VERSION", "KINDS", "NAME"))
    for r in rows:
        say(fmt % r)


def cmd_info(args):
    rest = [a for a in args if not a.startswith("--")]
    if len(rest) != 1:
        die("usage: ewe-plugin info <id> [--json]", 2)
    e = find(rest[0])
    if "--json" in args:
        print(json.dumps({"ok": True, "plugin": e}))
        return
    say("%s — %s %s" % (e["id"], e["name"] or "(no name)", e["version"] or ""))
    if e["description"]:
        say("  %s" % e["description"])
    say("  state:    %s%s" % ("enabled" if e["enabled"] else "disabled",
                              "" if e["installed"] else " (not installed)"))
    if e["installed"]:
        say("  dir:      %s%s" % (e["dir"], " (git)" if e["git"] else " (hand-made)"))
    if e["source"]:
        say("  source:   %s" % e["source"])
    if e["homepage"]:
        say("  homepage: %s" % e["homepage"])
    if e["author"]:
        say("  author:   %s" % e["author"])
    for k in e["kinds"]:
        say("  %-9s %s" % (k + ":", e["entryPoints"].get(k, "?")))
    if e["problems"]:
        say("  problems:")
        sys.stdout.write(problems_block(e))


def cmd_enable(args):
    rest = [a for a in args if not a.startswith("--")]
    if len(rest) != 1:
        die("usage: ewe-plugin enable <id> [--no-restart]", 2)
    e = find(rest[0])
    if not e["installed"]:
        die("\"%s\" is not installed here%s" % (e["id"], (" — ewe-plugin add %s" % e["source"]) if e["source"] else ""))
    if not e["valid"]:
        die("\"%s\" does not validate:\n%s" % (e["id"], problems_block(e).rstrip()))
    enabled, _ = conf_state()
    if e["id"] in enabled:
        say("%s is already enabled" % e["id"])
        return
    set_enabled(enabled + [e["id"]])
    say("enabled %s" % e["id"])
    restart_shell("--no-restart" not in args)


def cmd_disable(args):
    rest = [a for a in args if not a.startswith("--")]
    if len(rest) != 1:
        die("usage: ewe-plugin disable <id> [--no-restart]", 2)
    pid = rest[0]
    enabled, _ = conf_state()
    if pid not in enabled:
        say("%s is not enabled" % pid)
        return
    set_enabled([x for x in enabled if x != pid])
    say("disabled %s" % pid)
    restart_shell("--no-restart" not in args)


def cmd_update(args):
    yes = "--yes" in args
    rest = [a for a in args if not a.startswith("--")]
    if len(rest) > 1:
        die("usage: ewe-plugin update [id] [--yes]", 2)
    targets = [find(rest[0])] if rest else [e for e in scan() if e["installed"]]
    need_restart = False
    for e in targets:
        pid, d = e["id"], e["dir"]
        if not e["installed"]:
            say("%s: not installed" % pid)
            continue
        if not e["git"]:
            say("%s: hand-made (no .git) — nothing to pull" % pid)
            continue
        if git(["fetch", "--quiet"], cwd=d).returncode != 0:
            say("%s: fetch failed (offline? remote gone?)" % pid)
            continue
        old = git(["rev-parse", "HEAD"], cwd=d).stdout.strip()
        up = git(["rev-parse", "@{u}"], cwd=d)
        if up.returncode != 0:
            say("%s: no upstream branch — nothing to pull" % pid)
            continue
        new = up.stdout.strip()
        if old == new:
            say("%s: up to date (%s)" % (pid, old[:7]))
            continue
        say("%s: %s → %s" % (pid, old[:7], new[:7]))
        for line in git(["log", "--oneline", "HEAD..@{u}"], cwd=d).stdout.splitlines():
            say("    " + line)
        for line in git(["diff", "--stat", "HEAD..@{u}"], cwd=d).stdout.splitlines():
            say("    " + line)
        if not confirm("Apply?", yes):
            say("%s: skipped" % pid)
            continue
        r = git(["merge", "--ff-only", "--quiet", "@{u}"], cwd=d)
        if r.returncode != 0:
            say("%s: local changes block a fast-forward — resolve them in %s" % (pid, d))
            continue
        m, problems = read_manifest(d)
        if m is not None:
            problems = validate_manifest(d, m, expect_dirname=e["dirname"])
        if problems:
            git(["reset", "--hard", "--quiet", old], cwd=d)
            say("%s: the update does not validate — rolled back to %s" % (pid, old[:7]))
            sys.stdout.write("".join("    ! %s\n" % x for x in problems))
            continue
        say("%s: updated to %s (%s)" % (pid, m.get("version", "?"), new[:7]))
        need_restart = need_restart or e["enabled"]
    if need_restart:
        restart_shell()


def cmd_remove(args):
    yes = "--yes" in args
    rest = [a for a in args if not a.startswith("--")]
    if len(rest) != 1:
        die("usage: ewe-plugin remove <id> [--yes]", 2)
    e = find(rest[0])
    pid = e["id"]
    enabled, sources = conf_state()
    if e["installed"]:
        if e.get("bundled"):
            # a first-party plugin: delete the seeded copy and REMEMBER the
            # choice, or the next login would seed it right back
            shutil.rmtree(e["dir"])
            set_removed(conf_removed() + [pid])
            say("removed %s (bundled — it stays gone until `ewe-plugin add <its url>` or `ewe-plugin seed --restore %s`)" % (e["dir"], pid))
        elif e.get("linked"):
            # `ewe-plugin dev` linked a working copy: forget the link, the code stays
            os.unlink(e["dir"].rstrip("/"))
            say("unlinked %s (your working copy is untouched)" % e["dir"])
        elif e["git"]:
            if not confirm("Delete %s (a git clone; re-add it later from %s)?" % (e["dir"], e["source"] or "its source"), yes):
                die("cancelled", 1)
            shutil.rmtree(e["dir"])
            say("removed %s" % e["dir"])
        else:
            # hand-made: someone's work, never deleted — parked like install.sh's backups
            bak = e["dir"] + ".bak." + stamp()
            os.rename(e["dir"], bak)
            say("moved %s → %s (hand-made directory, kept as a backup)" % (e["dir"], bak))
    if pid in enabled:
        set_enabled([x for x in enabled if x != pid])
    if pid in sources:
        del sources[pid]
        set_sources(sources)
    say("forgot %s" % pid)
    if e["enabled"]:
        restart_shell()


def cmd_validate(args):
    rest = [a for a in args if not a.startswith("--")]
    if len(rest) != 1:
        die("usage: ewe-plugin validate <path>", 2)
    d = rest[0]
    if not os.path.isdir(d):
        die("%s is not a directory" % d)
    m, problems = read_manifest(d)
    if m is not None:
        problems = validate_manifest(d, m, allow_reserved="--first-party" in args)
    if "--json" in args:
        print(json.dumps({"ok": not problems, "problems": problems, "manifest": m}))
    elif problems:
        say("%s: %d problem%s" % (d, len(problems), "" if len(problems) == 1 else "s"))
        sys.stdout.write("".join("  ! %s\n" % x for x in problems))
    else:
        say("%s: ok — %s %s (%s)" % (d, m["id"], m["version"], ", ".join(m["kinds"])))
    sys.exit(1 if problems else 0)


# ── create / dev: the plugin author's side ────────────────────────────────────

