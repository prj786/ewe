def _opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    for a in args:
        if a.startswith(name + "="):
            return a[len(name) + 1:]
    return default


def cmd_create(args):
    rest = [a for a in args if not a.startswith("--")]
    for flag in ("--name", "--kinds", "--section", "--dir", "--author"):
        v = _opt(args, flag)
        if v is not None and v in rest:
            rest.remove(v)
    if len(rest) != 1:
        die("usage: ewe-plugin create <namespace.name> [--name \"Title\"] [--kinds bar-widget,panel] [--section right] [--dir PATH] [--no-git]", 2)
    pid = rest[0]
    if not ID_RE.match(pid) or (pid.startswith(RESERVED_PREFIX) and "--first-party" not in args):
        die("id must be <namespace>.<name> in lowercase [a-z0-9_-], not under \"ewe.\" (e.g. acme.weather)")
    kinds = [k.strip() for k in (_opt(args, "--kinds") or "bar-widget").split(",") if k.strip()]
    for k in kinds:
        if k not in KINDS:
            die("unknown kind \"%s\" (one of: %s)" % (k, ", ".join(KINDS)))
    name = _opt(args, "--name") or pid.split(".")[-1].replace("-", " ").replace("_", " ").title()
    section = _opt(args, "--section") or "right"
    if section not in ("left", "center", "right"):
        die("--section must be left, center or right")
    dest = os.path.abspath(_opt(args, "--dir") or os.path.join(os.getcwd(), pid))
    if os.path.exists(dest) and os.listdir(dest):
        die("%s exists and is not empty" % dest)
    author = _opt(args, "--author")
    if not author and shutil.which("git"):
        r = subprocess.run(["git", "config", "--get", "user.name"], capture_output=True, text=True)
        author = r.stdout.strip() or None
    author = author or os.environ.get("USER", "you")
    os.makedirs(dest, exist_ok=True)
    manifest = {"schemaVersion": SCHEMA, "id": pid, "name": name, "version": "0.1.0",
                "apiVersion": API_VERSION, "description": "%s for the ewe desktop." % name,
                "author": author, "icon": "icStar", "category": "Other", "kinds": kinds,
                "entryPoints": {k: ENTRY_FILE[k] for k in kinds if k in ENTRY_FILE}}
    if "bar-widget" in kinds:
        manifest["barWidget"] = {"defaultSection": section}
    if "quick-tile" in kinds:
        manifest["quickTile"] = {"span": 1, "order": 0}
    if "quick-page" in kinds:
        manifest["quickPage"] = {"key": pid.split(".")[-1].replace("_", "-"), "label": name, "icon": "icStar", "order": 0}
    if "bar-status" in kinds:
        manifest["barStatus"] = {"order": 0}
    if "dock-item" in kinds:
        manifest["dockItem"] = {"icon": "icStar", "label": name, "action": pid + ".toggle", "order": 0}
    if "desktop-widget" in kinds:
        manifest["desktopWidget"] = {"x": 48, "y": 64, "layer": "desktop"}
        manifest["settings"] = [{"key": "seconds", "type": "bool", "default": False, "label": "Show seconds"}]
    else:
        manifest["settings"] = [{"key": "label", "type": "string", "default": name, "label": "Label"}]
    with open(os.path.join(dest, "manifest.json"), "w") as f:
        json.dump(manifest, f, indent=2)
        f.write("\n")
    for k in kinds:
        if k in ENTRY_FILE:
            with open(os.path.join(dest, ENTRY_FILE[k]), "w") as f:
                f.write(TEMPLATES[k].format(id=pid, name=name))
    with open(os.path.join(dest, "README.md"), "w") as f:
        f.write(README_TPL.format(id=pid, name=name, url_hint="https://github.com/%s/%s.git" % (pid.split(".")[0], pid.split(".")[-1])))
    with open(os.path.join(dest, "LICENSE"), "w") as f:
        f.write(LICENSE_MIT.format(year=time.strftime("%Y"), author=author))
    with open(os.path.join(dest, ".gitignore"), "w") as f:
        f.write("*.bak.*\n.DS_Store\n")
    m, problems = read_manifest(dest)
    problems = validate_manifest(dest, m, expect_dirname=None, allow_reserved="--first-party" in args) if m else problems
    if problems:
        die("the scaffold did not validate (a bug):\n" + "".join("  ! %s\n" % x for x in problems))
    if "--no-git" not in args and shutil.which("git"):
        subprocess.run(["git", "init", "-q", "-b", "main"], cwd=dest, capture_output=True)
        subprocess.run(["git", "add", "-A"], cwd=dest, capture_output=True)
        # a machine with no git identity yet still gets its first commit
        ident = []
        if not subprocess.run(["git", "config", "--get", "user.email"], cwd=dest, capture_output=True, text=True).stdout.strip():
            ident = ["-c", "user.name=%s" % author, "-c", "user.email=%s@localhost" % re.sub(r"[^a-z0-9]+", "-", author.lower()).strip("-")]
        subprocess.run(["git", *ident, "commit", "-q", "-m", "%s: ewe plugin scaffold" % name], cwd=dest, capture_output=True)
    say("created %s (%s) -> %s" % (pid, ", ".join(kinds), dest))
    say("  next:  cd %s && ewe-plugin dev .     # link it, enable it, watch the log" % dest)
    say("  ship:  push this repo, then anyone can `ewe-plugin add <url> --enable`")


def cmd_dev(args):
    rest = [a for a in args if not a.startswith("--")]
    src = os.path.abspath(rest[0] if rest else ".")
    m, problems = read_manifest(src)
    if m is not None:
        problems = validate_manifest(src, m, expect_dirname=None, allow_reserved="--first-party" in args)
    if problems:
        die("not a valid ewe plugin:\n" + "".join("  ! %s\n" % x for x in problems).rstrip())
    pid = m["id"]
    os.makedirs(PLUGINS_DIR, exist_ok=True)
    dest = os.path.join(PLUGINS_DIR, pid)
    if "--first-party" in args:
        # the bundled copy (if seeded) gives way to the working copy
        if os.path.isdir(dest) and not os.path.islink(dest):
            shutil.rmtree(dest)
        enabled0, sources0 = conf_state()
        if sources0.get(pid) == "bundled":
            sources0[pid] = "local"
            set_sources(sources0)
    if os.path.islink(dest):
        if os.path.realpath(dest) != os.path.realpath(src):
            os.unlink(dest)
            os.symlink(src, dest)
    elif os.path.exists(dest):
        die("\"%s\" is installed as a real copy at %s -- `ewe-plugin remove %s` first" % (pid, dest, pid))
    else:
        os.symlink(src, dest)          # a LINK: edits in your folder are what the shell loads
    enabled, sources = conf_state()
    sources[pid] = "local"
    set_sources(sources)
    if pid not in enabled:
        set_enabled(enabled + [pid])
    say("linked %s -> %s, enabled%s" % (dest, src, "" if "--no-restart" in args else "; restarting the shell..."))
    restart_shell("--no-restart" not in args)
    if "--no-follow" in args or "--no-restart" in args:
        return
    say("following the shell's log for \"%s\" (Ctrl-C stops following; the plugin stays enabled)" % pid)
    try:
        subprocess.run(["sh", "-c", "journalctl --user -u %s -f -n 30 2>/dev/null | grep --line-buffered -iE 'plugins|%s|error|warn'"
                        % (SHELL_UNIT, re.escape(pid))])
    except KeyboardInterrupt:
        say()


# ── place / set / get: what ewe decides for a plugin ──────────────────────────

def cmd_place(args):
    rest = [a for a in args if not a.startswith("--")]
    for flag in ("--x", "--y", "--output", "--layer", "--visible"):
        v = _opt(args, flag)
        if v is not None and v in rest:
            rest.remove(v)
    if len(rest) != 1:
        die("usage: ewe-plugin place <id> [--x N] [--y N] [--output NAME] [--layer desktop|top] [--visible on|off] [--reset]", 2)
    e = find(rest[0])
    pid = e["id"]
    if "desktop-widget" not in (e.get("kinds") or []):
        die("%s has no desktop-widget entry point -- only desktop widgets are placed" % pid)
    table = conf_table("plugins.widgets")
    cur = dict(table.get(pid) or {})
    if "--reset" in args:
        cur = {}
    for k in ("x", "y"):
        v = _opt(args, "--" + k)
        if v is not None:
            try:
                cur[k] = int(float(v))
            except ValueError:
                die("--%s must be a number" % k)
    v = _opt(args, "--output")
    if v is not None:
        cur["output"] = v
    v = _opt(args, "--layer")
    if v is not None:
        if v not in WIDGET_LAYERS:
            die("--layer must be desktop or top")
        cur["layer"] = v
    v = _opt(args, "--visible")
    if v is not None:
        cur["visible"] = v.lower() in ("1", "true", "yes", "on")
    # the whole table, not a dotted per-id key: an id has a dot in it, and
    # ewe-conf would split "plugins.widgets.acme.clock" into nested tables
    table[pid] = cur
    conf_set("plugins.widgets", table)
    poke_shell_reload()
    print(json.dumps({"ok": True, "id": pid, "widget": effective_widget(read_manifest(e["dir"])[0] or {}, pid)}))


def cmd_set(args):
    rest = [a for a in args if not a.startswith("--")]
    if len(rest) != 3:
        die("usage: ewe-plugin set <id> <key> <value>", 2)
    e = find(rest[0])
    pid = e["id"]
    m, _ = read_manifest(e["dir"])
    schema = {o["key"]: o for o in (m or {}).get("settings", []) if isinstance(o, dict) and isinstance(o.get("key"), str)}
    if rest[1] not in schema:
        die("%s declares no setting \"%s\" (has: %s)" % (pid, rest[1], ", ".join(schema) or "none"))
    val = setting_coerce(schema[rest[1]], rest[2])
    table = conf_table("plugins.settings")
    cur = dict(table.get(pid) or {})
    cur[rest[1]] = val
    table[pid] = cur
    conf_set("plugins.settings", table)     # whole table: ids carry a dot
    poke_shell_reload()
    print(json.dumps({"ok": True, "id": pid, "settings": effective_settings(m or {}, pid)}))


def cmd_get(args):
    rest = [a for a in args if not a.startswith("--")]
    if not rest:
        die("usage: ewe-plugin get <id> [key]", 2)
    e = find(rest[0])
    m, _ = read_manifest(e["dir"])
    vals = effective_settings(m or {}, e["id"])
    if len(rest) > 1:
        if rest[1] not in vals:
            die("%s has no setting \"%s\"" % (e["id"], rest[1]))
        print(json.dumps(vals[rest[1]]))
    else:
        print(json.dumps({"ok": True, "id": e["id"], "settings": vals,
                          "schema": (m or {}).get("settings", []), "widget": e.get("widget")}))


# ── seed: the first-party plugins that ship inside the payload ────────────────

def cmd_seed(args):
    """The payload's plugins into the user's plugins dir: an id bundle.json
    marks `default: true` is copied in (source "bundled", enabled) unless
    the user removed it; an already-installed bundled copy is refreshed
    when the payload carries another version (add-ons included — that is
    how an upgrade moves them along). Everything else in the payload is an
    add-on: listed by `list --json` as available, put in by `install`.
    ewe-setup runs this at every deploy. --restore <id> forgets a removal
    and installs that id whether or not it is a default."""
    rest = [a for a in args if not a.startswith("--")]
    restore_id = None
    if "--restore" in args:
        i = args.index("--restore")
        if i + 1 < len(args):
            restore_id = args[i + 1]
            if restore_id in rest:
                rest.remove(restore_id)
            set_removed([x for x in conf_removed() if x != restore_id])
    src_dir = rest[0] if rest and os.path.isdir(rest[0]) else PAYLOAD_PLUGINS
    if not os.path.isdir(src_dir):
        print(json.dumps({"ok": True, "seeded": [], "refreshed": [], "skipped": [], "note": "no bundled plugins in %s" % src_dir}))
        return
    meta = bundle_meta(src_dir)
    removed = set(conf_removed())
    enabled, sources = conf_state()
    seeded, refreshed, skipped = [], [], []
    os.makedirs(PLUGINS_DIR, exist_ok=True)
    for pid, d, m, problems in payload_plugins(src_dir):
        if problems:
            skipped.append({"id": pid, "why": problems[0]})
            continue
        dest = os.path.join(PLUGINS_DIR, pid)
        if pid in removed:
            skipped.append({"id": pid, "why": "removed by the user"})
            continue
        if os.path.islink(dest):
            skipped.append({"id": pid, "why": "a linked working copy (ewe-plugin dev)"})
            continue
        if not os.path.exists(dest):
            if not (meta.get(pid, {}).get("default") is True or pid == restore_id):
                skipped.append({"id": pid, "why": "an add-on — ewe-plugin install %s" % pid})
                continue
            shutil.copytree(d, dest, symlinks=False)
            sources[pid] = "bundled"
            if pid not in enabled:
                enabled.append(pid)
            seeded.append(pid)
        elif sources.get(pid) == "bundled":
            cur, _ = read_manifest(dest)
            if (cur or {}).get("version") != m.get("version"):
                bak = dest + ".tmp-seed"
                shutil.rmtree(bak, ignore_errors=True)
                shutil.copytree(d, bak, symlinks=False)
                shutil.rmtree(dest)
                os.rename(bak, dest)
                refreshed.append(pid)
        else:
            skipped.append({"id": pid, "why": "installed from %s" % (sources.get(pid) or "elsewhere")})
    set_sources(sources)
    set_enabled(enabled)
    print(json.dumps({"ok": True, "seeded": seeded, "refreshed": refreshed, "skipped": skipped}))
    if (seeded or refreshed) and "--no-restart" not in args:
        restart_shell()
    else:
        try:
            write_plugin_keybinds()
        except Exception:
            pass


# ── install / migrate: the add-ons model (plan D1–D3) ─────────────────────────

def _json_fail(msg):
    """The machine-facing failure: one JSON object, exit 1 (the `validate
    --json` precedent — Komble reads `ok`, a script sees the status)."""
    print(json.dumps({"ok": False, "error": msg}))
    sys.exit(1)


def cmd_install(args):
    """ewe-plugin install <id> [--no-restart] — an add-on out of the payload:
    copied in with source "bundled", any removal forgotten, enabled, the
    keybinds regenerated, the shell restarted. One JSON object."""
    rest = [a for a in args if not a.startswith("--")]
    if len(rest) != 1:
        _json_fail("usage: ewe-plugin install <id> [--no-restart]")
    pid = rest[0]
    d, m, problems = payload_find(pid)
    if d is None or problems:
        _json_fail(problems[0])
    dest = os.path.join(PLUGINS_DIR, pid)
    _, sources = conf_state()
    if os.path.islink(dest):
        _json_fail("\"%s\" is a linked working copy (ewe-plugin dev) — remove it first" % pid)
    if os.path.exists(dest) and sources.get(pid) not in (None, "bundled"):
        _json_fail("\"%s\" is already installed from %s — remove it first" % (pid, sources[pid]))
    was = os.path.isdir(dest)
    m, dest = install_from_payload(pid, enable=True)
    restarted = restart_shell("--no-restart" not in args, quiet=True)
    print(json.dumps({"ok": True, "id": pid, "version": m.get("version"), "dir": dest,
                      "installed": True, "enabled": True, "refreshed": was,
                      "missing": check_requires(_requires(m)), "restarted": restarted}))


def _migrated_read():
    """{considered: [ids], at: epoch} — an older empty marker (a touch) means
    every add-on of that day was considered."""
    try:
        with open(MIGRATED) as f:
            txt = f.read()
    except OSError:
        return None
    try:
        j = json.loads(txt)
        if isinstance(j, dict) and isinstance(j.get("considered"), list):
            return {"considered": [x for x in j["considered"] if isinstance(x, str)], "at": j.get("at")}
    except json.JSONDecodeError:
        pass
    return {"considered": None, "at": None}      # legacy marker: all considered


def _migrated_write(considered):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = MIGRATED + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"considered": sorted(set(considered)), "at": int(time.time())}, f)
    os.replace(tmp, MIGRATED)


def cmd_migrate(args):
    """ewe-plugin migrate [--no-restart] [--fresh] — plan D3. For every
    bundle.json id with `migrate: true` that this machine has not CONSIDERED
    yet: install + enable it, so an upgrader keeps the feature that used to
    be built in; skipped when the user removed it, when the id is not in
    the payload, when it is installed already, and the dock (ewe.dock) when
    [desktop.dock] enabled = false. --fresh (a machine with no previous ewe)
    records every id as considered and installs nothing. Idempotent: the
    marker ~/.local/state/ewe/addons-migrated (local, never synced) names
    the ids; a later release's new add-on is still migrated once."""
    fresh = "--fresh" in args
    meta = bundle_meta()
    todo = sorted(pid for pid, bm in meta.items() if bm.get("migrate") is True)
    st = _migrated_read()
    considered = set(st["considered"]) if st and st["considered"] is not None else (set(todo) if st else set())
    pending = [pid for pid in todo if pid not in considered]
    migrated, skipped = [], []
    if not pending:
        _migrated_write(considered | set(todo))
        print(json.dumps({"ok": True, "migrated": [], "skipped": [], "fresh": fresh,
                          "note": "nothing to migrate" + (" (already migrated)" if st else "")}))
        return
    if fresh:
        _migrated_write(considered | set(pending))
        print(json.dumps({"ok": True, "migrated": [], "fresh": True,
                          "skipped": [{"id": pid, "why": "fresh install — add-ons are opt-in"} for pid in pending]}))
        return
    removed = set(conf_removed())
    enabled, sources = conf_state()
    dock = conf_table("desktop.dock")
    for pid in pending:
        if pid in removed:
            skipped.append({"id": pid, "why": "removed by the user"})
            continue
        if pid == "ewe.dock" and dock.get("enabled") is False:
            skipped.append({"id": pid, "why": "desktop.dock.enabled is false"})
            continue
        d, m, problems = payload_find(pid)
        if d is None or problems:
            skipped.append({"id": pid, "why": problems[0]})
            continue
        dest = os.path.join(PLUGINS_DIR, pid)
        if os.path.exists(dest) or os.path.islink(dest):
            skipped.append({"id": pid, "why": "already installed"})
            continue
        install_from_payload(pid, enable=True)
        migrated.append(pid)
    _migrated_write(considered | set(pending))
    restarted = restart_shell(bool(migrated) and "--no-restart" not in args, quiet=True)
    print(json.dumps({"ok": True, "migrated": migrated, "skipped": skipped, "fresh": False, "restarted": restarted}))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0 if argv else 2
    verb, args = argv[0], argv[1:]
    verbs = {"add": cmd_add, "list": cmd_list, "info": cmd_info, "enable": cmd_enable,
             "disable": cmd_disable, "update": cmd_update, "remove": cmd_remove,
             "validate": cmd_validate, "restore": cmd_restore,
             "create": cmd_create, "new": cmd_create, "dev": cmd_dev,
             "place": cmd_place, "set": cmd_set, "get": cmd_get, "seed": cmd_seed,
             "install": cmd_install, "migrate": cmd_migrate}
    if verb == "path":
        print(PLUGINS_DIR)
        return 0
    if verb == "boot-ok":
        clear_boots(forget_safe=True)
        return 0
    if verb not in verbs:
        die("unknown verb \"%s\" — try `ewe-plugin help`" % verb, 2)
    verbs[verb](args)
    if verb in ("add", "enable", "disable", "update", "remove", "restore", "dev", "seed", "install", "migrate"):
        # the keybinds file follows the enabled set — even on a no-op verb
        # (an already-enabled plugin, a seed with nothing new), so a shell
        # that lost the file gets it back
        try:
            write_plugin_keybinds()
        except Exception as e:
            say("(plugin keybinds not written: %s)" % e)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
