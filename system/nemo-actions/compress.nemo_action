[Nemo Action]
# Right-click → "Compress…" — opens engrampa's create-archive dialog with the
# selected files/folders, lets you name the archive and pick the format.
Name=Compress…
Comment=Create an archive from the selected items
Exec=engrampa --add %F
# archive-insert: a box with a + (pairs with Extract's box with an arrow out);
# package-x-generic drew a full-colour software-package box (0.43)
Icon-Name=archive-insert
Selection=NotNone
Extensions=any;
