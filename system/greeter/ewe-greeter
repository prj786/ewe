#!/bin/sh
# ewe-greeter — the greeter session wrapper greetd runs (system/greetd/
# config.toml: command = "/usr/local/bin/ewe-greeter"). install.sh phase 30
# installs it there; the ewe pacman package REFRESHES it from the payload on
# every upgrade (packaging/ewe.install) — so this file is the source, and
# /usr/local/bin/ewe-greeter is never edited by hand. It used to be generated
# inline by phase 30 with printf, which is why a packaged machine kept its
# install-day wrapper forever and the 2026-09-20 fix below never reached an
# upgraded box (the "random texts" before the desktop, 2026-10-04).
#
# A real script (not an `env …` prefix, which greetd word-splits and
# mis-parses, nor a service drop-in, whose env greetd may not pass through)
# is the place to set env:
#   WLR_NO_HARDWARE_CURSORS     fixes the inverted virtio-gpu / flaky `xe` cursor
#   WLR_RENDERER_ALLOW_SOFTWARE cage's software-GL fallback, VMs only —
#                               decided at RUN time (systemd-detect-virt, the
#                               same test lib/detect.sh uses) so one file
#                               serves every machine
#   XDG_CONFIG_DIRS/XDG_CACHE_HOME  so `qs -c` finds the config and has a
#                               writable cache as the greeter user
#   QT_QPA_PLATFORM + QT_WAYLAND_DISABLE_WINDOWDECORATION  cage offers no
#                               server-side decorations, so Qt would draw its
#                               OWN titlebar (min/max/close) around the greeter
#                               — "in a window"; no CSD = borderless/fullscreen
# Runs the QML greeter, falling back to ReGreet if qs exits nonzero (a QML
# error must never lock you out of login).
export WLR_NO_HARDWARE_CURSORS=1
if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -q 2>/dev/null; then
    export WLR_RENDERER_ALLOW_SOFTWARE=1
fi
export XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/ewe-greeter}"
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1

# greetd points the greeter's stdio at its VT (tty1), and cage runs wlroots at
# INFO: every backend/EGL line lands on tty1 in bold blue — visible while the
# greeter "loads" (before cage is DRM master) and again the instant cage exits
# on login, until Hyprland takes the screen (the blue text of 2026-09-20). Wipe
# the VT while stdout still is it, then keep the chatter in a file. A failed
# open falls back to /dev/null: under `sh` a failed `exec >` ends the script,
# and that would lock the login out.
printf '\033[H\033[2J\033[3J'
mkdir -p "$XDG_CACHE_HOME" 2>/dev/null
_log="$XDG_CACHE_HOME/greeter.log"
if : >"$_log" 2>/dev/null; then exec >"$_log" 2>&1; else exec >/dev/null 2>&1; fi
exec cage -s -- sh -c "qs -c ewe-greeter || regreet"
