// Zed defaults for the ewe desktop. The "ewe" theme is GENERATED by
// scripts/colorscheme.sh into themes/ewe.json (gitignored) — it follows the
// shell's style (flock/blacksheep) and accent. Zed tolerates comments here.
{
  "theme": "ewe",
  "ui_font_family": "Ubuntu",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "auto_update": false, // pacman owns the binary
  "restore_on_startup": "none"
}
