# zathura — the DE's document viewer, in the flock look. Colours live in
# flock-colors (GENERATED by quickshell/scripts/colorscheme.sh so the accent
# follows Settings → Theme); everything static stays here.

set selection-clipboard clipboard
set adjust-open width
set statusbar-home-tilde true
set window-title-home-tilde true
set font "SF Pro Text 10"
set guioptions ""
# open documents recoloured to the dark palette (toggle live with Ctrl-r)
set recolor true
set recolor-keephue true

include flock-colors
