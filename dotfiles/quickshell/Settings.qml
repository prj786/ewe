        stdout: StdioCollector { onStreamFinished: { var d = {}, ls = this.text.split("\n"); for (var i = 0; i < ls.length; i++) { var t = ls[i].split("\t"); if (t.length === 2 && t[1]) { if (!d[t[0]]) d[t[0]] = []; d[t[0]].push(t[1]) } } root.appChoices = d } }
