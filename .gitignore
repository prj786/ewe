# user/machine state that shouldn't be committed (re-seeded at install)
dotfiles/hypr/generated/user.lua
dotfiles/hypr/generated/monitors.lua
dotfiles/hypr/generated/input.lua
dotfiles/hypr/generated/wallpapers.conf
dotfiles/hypr/generated/kb-per-window.disabled
dotfiles/hypr/generated/hypridle.conf
dotfiles/hypr/generated/windowrules.lua
dotfiles/hypr/generated/animations.lua
dotfiles/hypr/hyprpaper.conf
dotfiles/quickshell/display-profiles.json
dotfiles/quickshell/window-rules.json
dotfiles/quickshell/input-devices.json
dotfiles/quickshell/user-theme.json
dotfiles/quickshell/pinned-apps.json
dotfiles/quickshell/places.json
dotfiles/quickshell/ssh-browse/
# Google account runtime state (OAuth client config, cached profile/events,
# sync meta, restore bundles + captured package lists). The refresh token
# itself is in the system keyring, never in files.
dotfiles/quickshell/google-*
# KDE Connect UI state (seen phone-notification ids, chosen device)
dotfiles/quickshell/kdeconnect-state.json
# user startup applications (Settings → Startup; seeded from the .default)
dotfiles/quickshell/startup-apps.json
*.bak.*

# accent-follow colours generated by colorscheme.sh into symlinked config dirs
dotfiles/kitty/flock.conf
dotfiles/zathura/flock-colors
dotfiles/fresh/themes/ewe.json

# the Fresh editor regenerates these inside its (symlinked) config dir at
# runtime; init.ts is the user's own plugin file (seed a .default if we ever
# ship one — see the *.default convention above)
dotfiles/fresh/tsconfig.json
dotfiles/fresh/types/
dotfiles/fresh/init.ts

# python bytecode from syntax checks
__pycache__/

# release artefacts built by release.sh
dist/
