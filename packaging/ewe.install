# alpm scriptlet for the ewe package. pacman can never touch $HOME, so the
# per-user deploy is a separate step — pointed at here, and run automatically
# at login by the session wrapper once a user is set up.

# L2TP/IPsec VPNs need IKEv1, which libreswan (a dependency) ships disabled
# by a runtime policy in /etc/ipsec.conf. install.sh phase 30 sets it, but the
# pacman path never re-runs install.sh on upgrade — so set it here too, as
# root, idempotently. Same edit as phase 30 (keep the two in step).
_ewe_ikev1_accept() {
    [ -f /etc/ipsec.conf ] || return 0
    ipsec --version 2>/dev/null | grep -qi libreswan || return 0
    grep -qE '^[[:space:]]*ikev1-policy[[:space:]]*=[[:space:]]*accept' /etc/ipsec.conf && return 0
    if grep -qE '^[[:space:]]*#?[[:space:]]*ikev1-policy[[:space:]]*=' /etc/ipsec.conf; then
        sed -i -E 's/^[[:space:]]*#?[[:space:]]*ikev1-policy[[:space:]]*=.*/\tikev1-policy=accept/' /etc/ipsec.conf
    elif grep -qE '^config setup' /etc/ipsec.conf; then
        sed -i -E '/^config setup/a\\tikev1-policy=accept' /etc/ipsec.conf
    else
        printf 'config setup\n\tikev1-policy=accept\n' >> /etc/ipsec.conf
    fi
    echo ":: ewe: enabled IKEv1 in /etc/ipsec.conf (L2TP/IPsec VPNs)"
}

# The greeter stack belongs to install.sh phase 30 (root-owned files under
# /etc/xdg/quickshell and /usr/local/bin — the package must not OWN them: that
# would make the optional greeter a hard dependency and fight any other display
# manager the user keeps). But a machine that ran phase 30 once kept THAT DAY's
# files forever: pacman upgraded the payload and nothing re-copied the wrapper,
# the greeter QML or its theme tokens. The 2026-09-20 fix for the blue wlroots
# text on tty1 shipped in three releases and reached no upgraded machine; the
# greeter QML was the pre-v3 file with no tokens beside it (2026-10-04).
#
# So: refresh them here — as root, non-interactively — ONLY where they already
# exist (= phase 30 installed them on this machine), from the payload. Same
# three files, same sources as phase 30: keep the two in step. Fonts, greetd's
# config.toml and PAM are deliberately NOT touched: those are the user's to
# re-run install.sh for (they change rarely and config.toml may carry edits).
_ewe_refresh_greeter() {
    _p=/usr/share/ewe
    _g=/etc/xdg/quickshell/ewe-greeter
    _n=0
    if [ -f /usr/local/bin/ewe-greeter ] && [ -r "$_p/system/greeter/ewe-greeter" ]; then
        install -m 755 "$_p/system/greeter/ewe-greeter" /usr/local/bin/ewe-greeter && _n=$((_n + 1))
    fi
    if [ -d "$_g" ]; then
        if [ -r "$_p/system/greeter/shell.qml" ]; then
            install -m 644 "$_p/system/greeter/shell.qml" "$_g/shell.qml" && _n=$((_n + 1))
        fi
        # Ewe Dark's roles for the greeter, derived by the payload's own
        # ewe-theme (the greeter user reads no ewe.conf: --conf /dev/null is
        # the defaults), written beside the QML atomically so a half-written
        # file never reaches a login screen.
        if [ -x "$_p/bin/ewe-theme" ] && command -v python3 >/dev/null 2>&1; then
            if "$_p/bin/ewe-theme" --conf /dev/null build --scheme ewe-dark \
                    --json "$_g/theme-tokens.json.tmp" --css /dev/null >/dev/null 2>&1 \
               && [ -s "$_g/theme-tokens.json.tmp" ]; then
                chmod 644 "$_g/theme-tokens.json.tmp" \
                    && mv -f "$_g/theme-tokens.json.tmp" "$_g/theme-tokens.json" && _n=$((_n + 1))
            else
                rm -f "$_g/theme-tokens.json.tmp"
                echo ":: ewe: could not rebuild the greeter's theme tokens — run: bash /usr/share/ewe/install.sh --no-packages"
            fi
        fi
    fi
    [ "$_n" -gt 0 ] && echo ":: ewe: refreshed the greeter from the payload ($_n file(s): wrapper, QML, Ewe Dark tokens)"
    return 0
}

# Machine settings from phases 30/60 that matter too much to wait for a
# manual `install.sh --no-packages` (2026-11-01 — the owner's work desktop):
#  * 20-ewe-wired.conf: a plugged-in cable keeps asking for an address instead
#    of failing into NetworkManager's 5-minute block (refreshed when it
#    differs — the file is ewe's; read on the next activation, so no reload
#    and no connection drop during an upgrade);
#  * 30-ewe-wifi.conf: Wi-Fi keeps its radio awake, so an SSH session from a
#    laptop isn't sticky (2026-11-04; applies when a network next connects);
#  * zram for every chassis: a desktop with no swap at all was OOM-killed.
#    Written only when NO zram-generator.conf exists (an admin's own is
#    never touched); active after the next boot.
# Same files and contents as the phases — keep the three in step.
_ewe_network_defaults() {
    _src=/usr/share/ewe/system/networkmanager/20-ewe-wired.conf
    _dst=/etc/NetworkManager/conf.d/20-ewe-wired.conf
    if [ -r "$_src" ] && [ -d /etc/NetworkManager ] && ! cmp -s "$_src" "$_dst"; then
        install -d /etc/NetworkManager/conf.d \
            && install -m 644 "$_src" "$_dst" \
            && echo ":: ewe: a plugged-in cable now keeps asking for an address (NetworkManager, next connection)"
    fi
    _src=/usr/share/ewe/system/networkmanager/30-ewe-wifi.conf
    _dst=/etc/NetworkManager/conf.d/30-ewe-wifi.conf
    if [ -r "$_src" ] && [ -d /etc/NetworkManager ] && ! cmp -s "$_src" "$_dst"; then
        install -d /etc/NetworkManager/conf.d \
            && install -m 644 "$_src" "$_dst" \
            && { nmcli general reload conf >/dev/null 2>&1 || true; } \
            && echo ":: ewe: Wi-Fi now keeps its radio awake while connected (from the next connection)"
    fi
    if [ ! -e /etc/systemd/zram-generator.conf ] \
       && [ -x /usr/lib/systemd/system-generators/zram-generator ]; then
        printf '[zram0]\nzram-size = min(ram, 8192)\ncompression-algorithm = zstd\n' > /etc/systemd/zram-generator.conf \
            && echo ":: ewe: compressed swap in RAM (zram) configured — active after the next boot"
    fi
    return 0
}

# Desktop defaults from phase 30 that a pacman or ISO install never got
# (0.43 — the Ubuntu-parity audit found them missing on package installs):
#  * the GSettings system db (system/dconf): Nemo's "Open in Terminal" opens
#    kitty where you are (ewe-terminal-here, /usr/bin; Cinnamon's schema
#    default is a terminal ewe does not install — `velocitty` since
#    cinnamon-desktop 6.8 — so the item did nothing; 0.43 wrote the key to a
#    path nothing reads, fixed in 0.43.1), no
#    "Delete" next to "Move to Trash", thumbnails for photos over 1 MiB, the
#    broken "Mount archive" item hidden, Compress… makes a .zip. The profile
#    is written only when absent or already ours (it orders every GSettings
#    read on the machine), then `dconf update`.
#  * the logind drop-in: the power button opens ewe's shutdown dialog instead
#    of switching the machine off at once, and the shell owns the lid. Only
#    when no 10-ewe-lid.conf exists yet (an install.sh machine has it); logind
#    reads it at the next boot — restarting logind under a live session can
#    black-screen the desktop.
# Same files and rules as phase 30 — keep the two in step.
_ewe_system_defaults() {
    _p=/usr/share/ewe/system
    if command -v dconf >/dev/null 2>&1 && [ -d "$_p/dconf/ewe.d" ]; then
        install -d /etc/dconf/db/ewe.d /etc/dconf/profile
        for _f in "$_p/dconf/ewe.d/"*; do
            [ -f "$_f" ] && install -m 644 "$_f" "/etc/dconf/db/ewe.d/${_f##*/}"
        done
        if [ ! -e /etc/dconf/profile/user ] || grep -q '^system-db:ewe$' /etc/dconf/profile/user 2>/dev/null; then
            install -m 644 "$_p/dconf/profile-user" /etc/dconf/profile/user \
                && dconf update \
                && echo ":: ewe: desktop defaults installed (Files: Open in Terminal, thumbnails, Compress → .zip)"
        else
            echo ":: ewe: /etc/dconf/profile/user belongs to something else — add 'system-db:ewe' to it for ewe's defaults"
        fi
    fi
    if [ -r "$_p/logind/10-ewe-lid.conf" ] && [ ! -e /etc/systemd/logind.conf.d/10-ewe-lid.conf ]; then
        install -d /etc/systemd/logind.conf.d \
            && install -m 644 "$_p/logind/10-ewe-lid.conf" /etc/systemd/logind.conf.d/10-ewe-lid.conf \
            && echo ":: ewe: the power button now asks before shutting down (from the next boot)"
    fi
    return 0
}

# More phase-30 files a pacman/ISO install never got, and that an install.sh
# machine only had as of the day it last ran phase 30 (0.43 audit; this very
# box lacked the gnome-software stand-in). Installed, or refreshed when the
# payload's copy differs:
#  * /usr/local/bin/gnome-software — GTK's "Find New Applications" in Open
#    With runs a binary of that name; the stand-in opens Komble on a search
#    (skipped when the real GNOME Software is installed);
#  * NetworkManager dispatchers: Cast keeps the Wi-Fi radio awake during a
#    Miracast session; the time zone follows the network's location
#    (opt out: /etc/ewe/no-auto-timezone);
#  * udev: the battery charge ceiling is writable from Settings → Power
#    (only on batteries that have one); dock USB-LAN adapters cannot power
#    the machine back on after shutdown;
#  * the poweroff hook that unloads Wi-Fi/dock-LAN drivers before ACPI S5.
# Same files as phase 30 — keep the two in step. DNS (systemd-resolved) and
# the bluetooth main.conf tuning stay install.sh's: they rewrite config a
# user may own.
_ewe_put() {   # SRC DST MODE — 0 when it installed something
    [ -r "$1" ] || return 1
    cmp -s "$1" "$2" && return 1
    install -d "${2%/*}" && install -m "$3" "$1" "$2"
}
_ewe_system_files() {
    _p=/usr/share/ewe/system
    _n=0; _u=0
    if [ ! -x /usr/bin/gnome-software ]; then
        _ewe_put "$_p/bin/gnome-software" /usr/local/bin/gnome-software 755 && _n=$((_n + 1))
    fi
    if [ -d /etc/NetworkManager ]; then
        _ewe_put "$_p/networkmanager/50-ewe-cast-powersave" /etc/NetworkManager/dispatcher.d/50-ewe-cast-powersave 755 && _n=$((_n + 1))
        _ewe_put "$_p/networkmanager/60-ewe-auto-timezone" /etc/NetworkManager/dispatcher.d/60-ewe-auto-timezone 755 && _n=$((_n + 1))
    fi
    if ls /sys/class/power_supply/BAT*/charge_control_end_threshold >/dev/null 2>&1; then
        _ewe_put "$_p/udev/99-ewe-charge-threshold.rules" /etc/udev/rules.d/99-ewe-charge-threshold.rules 644 && { _n=$((_n + 1)); _u=1; }
    fi
    _ewe_put "$_p/udev/99-ewe-usb-lan-no-wake.rules" /etc/udev/rules.d/99-ewe-usb-lan-no-wake.rules 644 && { _n=$((_n + 1)); _u=1; }
    if [ "$_u" = 1 ] && command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload >/dev/null 2>&1
        udevadm trigger --subsystem-match=power_supply >/dev/null 2>&1
    fi
    _ewe_put "$_p/shutdown/ewe-unload-nics.shutdown" /usr/lib/systemd/system-shutdown/ewe-unload-nics.shutdown 755 && _n=$((_n + 1))
    [ "$_n" -gt 0 ] && echo ":: ewe: $_n system file(s) installed or refreshed (Find New Applications, Cast, time zone, charge limit, clean poweroff)"
    return 0
}

# Memory/journal/file-index tuning (2026-11-08): zswap off + swappiness 180
# next to zram, transparent huge pages on request only, a 1 GB journal, no
# plocate scan while the desktop starts. The same script phase 60 runs; it
# changes only what differs and never fails the transaction.
_ewe_tuning() {
    [ -r /usr/share/ewe/system/tuning/apply.sh ] && sh /usr/share/ewe/system/tuning/apply.sh
    return 0
}

post_install() {
    _ewe_ikev1_accept
    _ewe_network_defaults
    _ewe_system_defaults
    _ewe_system_files
    _ewe_tuning
    cat <<'EOF'
:: ewe is installed. Two steps remain:
::   1. per user:  ewe-setup            (deploys the dotfiles into your home)
::   2. system:    bash /usr/share/ewe/install.sh --no-packages
::      (as your user, NOT sudo — it escalates where needed: greeter, services,
::      plymouth; skips anything already configured; safe to re-run)
EOF
}

post_upgrade() {
    _ewe_ikev1_accept
    _ewe_refresh_greeter
    _ewe_network_defaults
    _ewe_system_defaults
    _ewe_system_files
    _ewe_tuning
    cat <<'EOF'
:: ewe payload updated. Each user's desktop refreshes itself at next login
:: (or run `ewe-setup` now and restart the shell).
EOF
}

pre_remove() {
    # the payload (and apply.sh with it) is gone by post_remove
    [ -r /usr/share/ewe/system/tuning/apply.sh ] && sh /usr/share/ewe/system/tuning/apply.sh --remove
    return 0
}
