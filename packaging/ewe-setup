#!/usr/bin/env bash
# ewe-setup — deploy or refresh the ewe desktop for the CURRENT user from the
# packaged payload at /usr/share/ewe (installed by the `ewe` pacman package).
#
# The model is unchanged from get.sh: the user runs the desktop from a
# writable tree at ~/.local/share/ewe (runtime state — user-theme.json,
# generated/*.lua, wallpapers — lives inside it), with ~/.config/* symlinked
# into it. This script refreshes that tree from the read-only payload,
# overwriting only the files the payload ships (user state survives, exactly
# like the tarball flow), then re-runs the standard dotfile deploy from the
# payload's own lib/deploy.sh.
#
#   ewe-setup                  deploy/refresh now
#   ewe-setup --sync-if-newer  refresh only when the payload VERSION is newer;
#                              exit 0 if a sync ran, 3 if already current
#                              (the session wrapper uses this at login)
#
# Never run as root: everything here is per-user.
set -uo pipefail

PAYLOAD="${EWE_PAYLOAD:-/usr/share/ewe}"
DEST="${EWE_HOME:-$HOME/.local/share/ewe}"

say() { printf '\033[1;36m::\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] && die "run as your normal user, not root (this deploys into \$HOME)."
[ -d "$PAYLOAD" ] || die "no payload at $PAYLOAD — is the 'ewe' package installed?"

if [ "${1:-}" = "--sync-if-newer" ]; then
    if [ -r "$DEST/VERSION" ] && [ "$(cat "$PAYLOAD/VERSION")" = "$(cat "$DEST/VERSION")" ]; then
        exit 3
    fi
fi

# First deploy on this account? Then default appearance must be applied below
# (a refresh must never re-theme a user who changed their look).
FIRST=0
[ -e "$DEST/VERSION" ] || FIRST=1

say "syncing $PAYLOAD -> $DEST ($(cat "$PAYLOAD/VERSION"))"
mkdir -p "$DEST"
cp -a "$PAYLOAD/." "$DEST/" || die "copy failed"
# exec bits survive cp -a, but belt-and-braces after any transport
chmod +x "$DEST/dotfiles/hypr/start-hyprland.sh" \
         "$DEST"/dotfiles/hypr/scripts/*.sh \
         "$DEST"/dotfiles/quickshell/scripts/*.sh 2>/dev/null || true

# lib/deploy.sh expects the installer's logging + choke point; provide the
# minimal real-run equivalents (no dry-run mode here).
RUN_STAMP="$(date +%Y%m%d-%H%M%S)"
DOTREPO="$DEST"
info() { printf '   %s\n' "$*"; }
ok()   { printf '\033[1;32mok\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
run()  { "$@"; }
# shellcheck source=/dev/null
source "$DEST/lib/deploy.sh" || die "payload is missing lib/deploy.sh"
deploy_dotfiles

# RFC-001: make ewe-conf reachable for tarball installs too (the package
# already owns /usr/bin/ewe-conf; ~/.local/bin shadows consistently) and make
# sure the ONE file exists — first deploy imports it from the runtime state
# seed_state just created.
if [ -x "$DEST/bin/ewe-conf" ]; then
    mkdir -p "$HOME/.local/bin"
    ln -sf "$DEST/bin/ewe-conf" "$HOME/.local/bin/ewe-conf"
    [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/ewe/ewe.conf" ] \
        || "$DEST/bin/ewe-conf" import >/dev/null \
        || warn "ewe-conf import failed — the one file will be created on first Settings change."
fi

# Default appearance on FIRST deploy — the phase-60 equivalent. Without this a
# fresh account (live ISO included) runs with no icon/cursor/GTK/Qt theming at
# all: Adwaita icon lookups miss half the apps and every launcher tile shows
# the broken-image checkerboard. colorscheme.sh writes gtk settings.ini,
# qt6ct, gsettings (best-effort without a bus) and the Mocu cursor link.
if [ "$FIRST" = 1 ] && [ -r "$DEST/dotfiles/quickshell/scripts/colorscheme.sh" ]; then
    say "applying the default appearance (dark, blue accent)"
    sh "$DEST/dotfiles/quickshell/scripts/colorscheme.sh" dark 0a84ff >/dev/null 2>&1 \
        || warn "colorscheme.sh reported errors — theming may be incomplete until Settings → Theme is used."
fi

say "done — the refreshed shell loads at the next login (or: systemctl --user restart ewe.service)"
say "first install on this machine? run $DEST/install.sh for the system side (greeter, services)."
