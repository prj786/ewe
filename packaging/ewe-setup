#!/usr/bin/env bash
# ewe-setup — deploy or refresh the ewe desktop for the CURRENT user from the
# packaged payload at /usr/share/ewe (installed by the `ewe` pacman package).
#
# The model is unchanged from get.sh: the user runs the desktop from a
# writable tree at ~/.local/share/ewe (runtime state — user-theme.json,
# generated/*.lua, wallpapers — lives inside it), with ~/.config/* symlinked
# into it. This script refreshes that tree from the read-only payload,
# overwriting only the files the payload ships (user state survives, exactly
# like the tarball flow), then re-runs the standard dotfile deploy from the
# payload's own lib/deploy.sh.
#
#   ewe-setup                  deploy/refresh now
#   ewe-setup --sync-if-newer  refresh only when the payload VERSION is newer;
#                              exit 0 if a sync ran, 3 if already current
#                              (the session wrapper uses this at login)
#
# Never run as root: everything here is per-user.
set -uo pipefail

PAYLOAD="${EWE_PAYLOAD:-/usr/share/ewe}"
DEST="${EWE_HOME:-$HOME/.local/share/ewe}"

say() { printf '\033[1;36m::\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] && die "run as your normal user, not root (this deploys into \$HOME)."
[ -d "$PAYLOAD" ] || die "no payload at $PAYLOAD — is the 'ewe' package installed?"

if [ "${1:-}" = "--sync-if-newer" ]; then
    if [ -r "$DEST/VERSION" ] && [ "$(cat "$PAYLOAD/VERSION")" = "$(cat "$DEST/VERSION")" ]; then
        exit 3
    fi
fi

# First deploy on this account? Then default appearance must be applied below
# (a refresh must never re-theme a user who changed their look).
FIRST=0
[ -e "$DEST/VERSION" ] || FIRST=1

say "syncing $PAYLOAD -> $DEST ($(cat "$PAYLOAD/VERSION"))"
mkdir -p "$DEST"
cp -a "$PAYLOAD/." "$DEST/" || die "copy failed"
# exec bits survive cp -a, but belt-and-braces after any transport
chmod +x "$DEST/dotfiles/hypr/start-hyprland.sh" \
         "$DEST"/dotfiles/hypr/scripts/*.sh \
         "$DEST"/dotfiles/quickshell/scripts/*.sh 2>/dev/null || true

# lib/deploy.sh expects the installer's logging + choke point; provide the
# minimal real-run equivalents (no dry-run mode here).
RUN_STAMP="$(date +%Y%m%d-%H%M%S)"
DOTREPO="$DEST"
info() { printf '   %s\n' "$*"; }
ok()   { printf '\033[1;32mok\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
run()  { "$@"; }
# shellcheck source=/dev/null
source "$DEST/lib/deploy.sh" || die "payload is missing lib/deploy.sh"
deploy_dotfiles

# RFC-001: make ewe-conf reachable for tarball installs too (the package
# already owns /usr/bin/ewe-conf; ~/.local/bin shadows consistently) and make
# sure the ONE file exists — first deploy imports it from the runtime state
# seed_state just created.
if [ -x "$DEST/bin/ewe-conf" ]; then
    mkdir -p "$HOME/.local/bin"
    ln -sf "$DEST/bin/ewe-conf" "$HOME/.local/bin/ewe-conf"
    [ -x "$DEST/bin/ewe-auth" ] && ln -sf "$DEST/bin/ewe-auth" "$HOME/.local/bin/ewe-auth"
    [ -x "$DEST/bin/ewe-drive" ] && ln -sf "$DEST/bin/ewe-drive" "$HOME/.local/bin/ewe-drive"
    [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/ewe/ewe.conf" ] \
        || "$DEST/bin/ewe-conf" import >/dev/null \
        || warn "ewe-conf import failed — the one file will be created on first Settings change."
fi

# Default appearance on FIRST deploy — the phase-60 equivalent. Without this a
# fresh account (live ISO included) runs with no icon/cursor/GTK/Qt theming at
# all: Adwaita icon lookups miss half the apps and every launcher tile shows
# the broken-image checkerboard. colorscheme.sh writes gtk settings.ini,
# qt6ct, gsettings (best-effort without a bus) and the Mocu cursor link.
if [ "$FIRST" = 1 ] && [ -r "$DEST/dotfiles/quickshell/scripts/colorscheme.sh" ]; then
    say "applying the default appearance (dark, blue accent)"
    sh "$DEST/dotfiles/quickshell/scripts/colorscheme.sh" dark 0a84ff >/dev/null 2>&1 \
        || warn "colorscheme.sh reported errors — theming may be incomplete until Settings → Theme is used."
fi

# Default applications — SEED, never clobber (the phase-60 rule, lifted here
# because an ISO install runs ewe-setup and never phase 60). Without this a
# fresh install has no x-scheme-handler/https at all and `xdg-open` — which
# is how ewe-auth hands the Google consent page to a browser — only worked
# by luck of the mimeinfo cache having a single claimant. A default is
# written only when the current handler is unset or points at a desktop
# file that no longer exists; the user's own choices always survive.
_desktop_ok() { [ -n "$1" ] && { [ -r "/usr/share/applications/$1" ] || [ -r "$HOME/.local/share/applications/$1" ]; }; }
if command -v xdg-settings >/dev/null 2>&1; then
    cur_browser="$(xdg-settings get default-web-browser 2>/dev/null)"
    if ! _desktop_ok "$cur_browser"; then
        for b in helium.desktop firefox.desktop firefox-esr.desktop org.mozilla.firefox.desktop; do
            [ -r "/usr/share/applications/$b" ] && { xdg-settings set default-web-browser "$b" >/dev/null 2>&1 && break; }
        done
    fi
fi
# Zed's shipped desktop entry declares only text/plain; the override carries
# the full text/code MimeType list so "Open With" offers it for JSON/YAML/…
if [ -r "$DEST/system/applications/dev.zed.Zed.desktop" ]; then
    mkdir -p "$HOME/.local/share/applications"
    cp -f "$DEST/system/applications/dev.zed.Zed.desktop" "$HOME/.local/share/applications/dev.zed.Zed.desktop"
fi
# what the user EXPLICITLY chose in ~/.config/mimeapps.list — never the
# mimeinfo-cache fallback `xdg-mime query default` would report
_user_default() {
    awk -F= -v m="$1" '/^\[/{s=($0=="[Default Applications]")} s && $1==m {sub(/;.*/,"",$2); print $2; exit}' \
        "${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list" 2>/dev/null
}
_mime() {
    local d="$1"; shift
    [ -r "/usr/share/applications/$d" ] || [ -r "$HOME/.local/share/applications/$d" ] || return 0
    local m cur; for m in "$@"; do
        cur="$(_user_default "$m")"
        _desktop_ok "$cur" && continue
        xdg-mime default "$d" "$m" >/dev/null 2>&1 || true
    done
}
if command -v xdg-mime >/dev/null 2>&1; then
    _mime helium.desktop            x-scheme-handler/http x-scheme-handler/https text/html
    _mime nemo.desktop              inode/directory
    _mime dev.zed.Zed.desktop text/plain text/markdown text/css text/javascript \
          application/json application/javascript application/xml text/xml application/x-yaml \
          text/x-python text/x-csrc text/x-chdr text/x-c++src application/x-shellscript \
          text/x-rust text/x-go
    _mime imv.desktop               image/png image/jpeg image/gif image/webp image/bmp image/tiff
    _mime org.pwmt.zathura.desktop  application/pdf application/epub+zip
    _mime mpv.desktop               video/mp4 video/x-matroska video/webm video/quicktime audio/mpeg audio/flac
    _mime engrampa.desktop          application/zip application/x-tar application/gzip application/x-xz \
          application/x-bzip2 application/x-7z-compressed application/x-rar application/zstd application/x-compressed-tar
    _mime komble.desktop            application/vnd.appimage application/x-iso9660-appimage application/x-appimage
fi
command -v update-desktop-database >/dev/null 2>&1 \
    && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true

# ewe-sync (RFC-006), the account app, runs as a tray app of the graphical
# session: its unit is WantedBy=graphical-session.target, which autostart.sh
# brings up through hyprland-session.target at every login. Enabling it here
# is therefore the whole autostart — no run_once line in autostart.sh, that
# would start it twice. Idempotent: enable only when not enabled yet.
if command -v systemctl >/dev/null 2>&1 && systemctl --user cat ewe-sync.service >/dev/null 2>&1; then
    systemctl --user is-enabled ewe-sync.service >/dev/null 2>&1 \
        || systemctl --user enable ewe-sync.service >/dev/null 2>&1 || true
fi

say "done — the refreshed shell loads at the next login (or: systemctl --user restart ewe.service)"
say "first install on this machine? run $DEST/install.sh for the system side (greeter, services)."
