# Maintainer: scubba
#
# The ewe desktop environment as a pacman package, served from the [ewe]
# repository (github.com/prj786/ewe-repo). The payload — the whole release
# tree — lands read-only at /usr/share/ewe; per-user deployment stays exactly
# the get.sh model (a writable copy in ~/.local/share/ewe behind the ~/.config
# symlink farm), done by `ewe-setup` and refreshed automatically at login by
# the session wrapper when pacman has delivered a newer payload. System-level
# setup (greeter, plymouth, hibernate, GPU) remains install.sh's job — those
# phases edit files owned by other packages and machine state a package must
# not touch.
#
# depends is computed in package() from packages/common.list + aur.list (the
# aur.list names are served prebuilt from the [ewe] repo), so the lists stay
# the single source of truth. gaming.list becomes optdepends.

pkgname=ewe
# NOTE: ewe-repo's publish workflow REWRITES this line from the latest release
# tag (`sed -i "s/^pkgver=.*/pkgver=${ver#v}/"`), so it is a placeholder kept in
# step with VERSION rather than the value that ships — which is why it had
# drifted to 0.9.4. pkgrel is NOT rewritten, so it matters: it resets to 1 here
# because pkgver moved, and 0.11.0-1 sorts above the published 0.10.2-2.
# _tag is the GIT TAG; pkgver is what pacman sees. They differ for a
# pre-release: a tag may read v0.12.0-beta, but an Arch pkgver may not contain
# a hyphen, and of the legal spellings only 0.12.0beta sorts BELOW the eventual
# 0.12.0 under vercmp. GitHub's archive is addressed by the TAG and extracts to
# <repo>-<tag without the leading v>, so both the source URL and the directory
# below follow _tag, never pkgver. ewe-repo's publish workflow rewrites both.
_tag=v0.12.0-beta
pkgver=0.12.0beta
pkgrel=1
pkgdesc="ewe — a clean, dark Hyprland + Quickshell desktop environment"
arch=('any')
url="https://github.com/prj786/ewe"
license=('GPL-2.0-only')
# PROVIDER PINS COME FIRST: pacman resolves depends in array order, and an
# unpinned virtual is claimed by whichever provider a DEEP dependency reaches
# first — that is exactly how a fresh `pacman -S ewe` once resolved jack2
# AND pipewire-jack into the same transaction (unresolvable conflict).
# reversal/mocu are served from the [ewe] repo (ewe-repo pkgbuilds/);
# phase 20's source install is only the non-repo fallback.
depends=('pipewire-jack'            # claims 'jack' before ffmpeg/mpv/portaudio ask
         'tesseract-data-eng'       # claims 'tessdata' before libmupdf asks (else: Afrikaans)
         'komble-arch' 'ewe-settings' 'ewe-cast'
         'ewe-sync'                 # the account app (RFC-006), served from [ewe]
         'reversal-icon-theme' 'mocu-cursor-theme'
         'python')   # ewe-conf; + the lists, appended in package()
install=ewe.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz"
        'ewe-setup')
sha256sums=('SKIP'
            'SKIP')

package() {
    cd "$pkgname-${_tag#v}"

    # Dependency lists → package metadata. Comments stripped, first word only.
    # (mapfile, not depends+= in a loop: makepkg's linter extracts +=-lines
    # from package() and evaluates them out of context, seeing empty values.)
    # skip entries already front-pinned above — no duplicate depends
    mapfile -t -O "${#depends[@]}" depends \
        < <(sed 's/#.*//' packages/common.list packages/aur.list | awk 'NF{print $1}' \
            | grep -vxF -e pipewire-jack -e tesseract-data-eng)
    mapfile -t optdepends \
        < <(sed 's/#.*//' packages/gaming.list | awk 'NF{print $1": gaming stack (install.sh --gaming)"}')

    # The payload: everything a user-side deploy or a system setup needs.
    # (.claude/.github are dev tooling; dist/ is build output and untracked.)
    install -d "$pkgdir/usr/share/ewe"
    cp -a dotfiles systemd system packages phases lib templates docs bin \
          install.sh update.sh uninstall.sh VERSION VERSIONS README.md LICENSE \
          "$pkgdir/usr/share/ewe/"

    install -Dm755 "$srcdir/ewe-setup" "$pkgdir/usr/bin/ewe-setup"
    # RFC-001: the ONE writer of the ONE file
    install -Dm755 bin/ewe-conf "$pkgdir/usr/bin/ewe-conf"
    # RFC-005: the ONE account — Nextcloud identity, its calendar, any inbox,
    # and the account as a folder. A tool that is not installed here does not
    # exist on an installed system (the publish assertion caught exactly that).
    install -Dm755 bin/ewe-cloud "$pkgdir/usr/bin/ewe-cloud"
    # the ONE writer of what the look is (ewe.conf [desktop.theme] -> the shell's
    # theme-tokens.json + the apps' tokens.css)
    install -Dm755 bin/ewe-theme "$pkgdir/usr/bin/ewe-theme"
    install -Dm755 bin/ewe-caldav "$pkgdir/usr/bin/ewe-caldav"
    install -Dm755 bin/ewe-mail "$pkgdir/usr/bin/ewe-mail"
    install -Dm755 bin/ewe-files "$pkgdir/usr/bin/ewe-files"
    # RFC-002, now optional: Google mail + Drive with the user's own client
    install -Dm755 bin/ewe-auth "$pkgdir/usr/bin/ewe-auth"
    install -Dm755 bin/ewe-drive "$pkgdir/usr/bin/ewe-drive"
}
