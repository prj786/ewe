# common.list — official-repo (pacman) packages, real Arch names, one per line.
# AUR packages live in aur.list. GPU/Vulkan drivers are installed per-vendor by
# phase 40, not here. Comments (#) and blank lines are ignored.

# ── core session ─────────────────────────────────────────────────────────────
hyprland
quickshell
hypridle
hyprlock
xdg-desktop-portal
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
polkit
gnome-keyring
libsecret               # secret-tool — Google refresh token lives in the keyring
kdeconnect              # phone integration daemon (Quick Settings "Mobile" card drives it over D-Bus)
accountsservice         # user icon store (greeter avatar; Settings writes it via busctl)
plocate                 # launcher file search (Super+D); phase 30 enables the updatedb timer
python-dbus             # kdeconnect-bridge.py + logind-bridge.py (D-Bus side)
python-gobject          # those two bridges' GLib loop (also the optional EDS helper)
qt5-wayland
qt6-wayland
qt6-svg
qt6-5compat
qt6-multimedia-ffmpeg
xdg-user-dirs
xdg-utils

# ── greeter / welcome screen — FULLY WAYLAND, zero Xorg. greetd is the login
#    daemon; ReGreet (gtk4-layer-shell, Wayland-native) is the graphical greeter,
#    rendered by `cage` (a one-shot kiosk Wayland compositor). All three are in
#    the official extra repo. No xorg-server anywhere. ──────────────────────────
greetd
greetd-regreet
cage
plymouth                # graphical boot splash (Arch logo + spinner); wired by phase 35

# ── audio (PipeWire, low-latency-ready) ──────────────────────────────────────
pipewire
pipewire-pulse
pipewire-alsa
pipewire-jack
pipewire-audio          # SPA codec/bluetooth plugins — BT speakers/headsets expose a sink
wireplumber
pavucontrol
# Audio FIRMWARE — modern Intel (Lunar Lake / Arc) and recent AMD laptops route
# audio through the on-die SOF DSP; without sof-firmware the codec never loads and
# there is NO sound on real hardware (a VM's virtio audio needs no firmware, which
# is exactly why it works in a VM but is silent on metal).
sof-firmware
alsa-ucm-conf           # UCM routing profiles (speakers / headphone jack / mic)
alsa-utils              # alsactl (restore mixer @ boot) + alsamixer / aplay -l diagnostics

# ── network / bluetooth / power ──────────────────────────────────────────────
networkmanager
networkmanager-openvpn  # OpenVPN profiles (the most common VPN type)
networkmanager-l2tp     # L2TP/IPsec profiles (needs strongswan below)
strongswan              # IPsec for networkmanager-l2tp
# Cast to TV (the control-centre "Cast" tile → gnome-network-displays, aur.list):
iw                      # `iw list` — cast-check.sh verifies the Wi-Fi card does Wi-Fi Direct (P2P), which Miracast needs
avahi                   # mDNS — Chromecast / Google TV discovery (phase 30 enables avahi-daemon)
wireless-regdb          # regulatory database; phase 30 sets the country. Without it the kernel runs the
                        # "world" domain: 5 GHz is receive-only, so hotspot / Wi-Fi Direct (Miracast) are
                        # pinned to crowded 2.4 GHz — the "laggy / frozen mirror" of 2026-08-21
gst-plugin-va           # vah264enc — hardware H.264 for Cast to TV (gnome-network-displays prefers it over
                        # x264); Intel iHD + AMD Mesa both expose it via VA-API
bluez
bluez-utils
blueman
power-profiles-daemon
upower                  # battery/AC state for the bar, control centre and display re-asserts
fwupd                   # firmware/BIOS updates from Linux (LVFS) — stale vendor BIOS is the
                        # root cause behind ACPI poweroff/suspend bugs on thin laptops

# ── terminal (single, fast, GPU-accelerated) ─────────────────────────────────
# kitty is the one terminal (foot/ghostty dropped). No multiplexer: the prompt
# is oh-my-posh (packages/aur.list) and Hyprland already does windows/workspaces.
kitty

# ── file manager + utility apps = traditional GTK (NOT libadwaita) ────────────
#    Nemo/Engrampa/Zathura use a normal menubar/toolbar + server-side decorations,
#    so under Hyprland (no titlebar) they render with ONLY our accent border — the
#    no-titlebar borderless look — while theming via GTK (adw-gtk3 + gsettings, see
#    scripts/colorscheme.sh). Unlike GNOME/libadwaita apps they have no unhideable
#    client-side headerbar. Defaults are managed the standard way: ONE
#    ~/.config/mimeapps.list, read natively by GIO — no KDE ksycoca cache, so
#    "Open With" always sees the installed apps. ──────────────────────────────
nemo                    # file manager (GTK3; custom right-click via .nemo_action)
engrampa                # archive manager (GTK3, no headerbar) — create / extract
imv                     # image viewer (Wayland-native, decorationless)
zathura                 # PDF / document viewer (keyboard-driven, fully themeable)
zathura-pdf-mupdf
tesseract-data-eng      # libmupdf → tesseract needs A data pack; unpinned, pacman's
                        # resolver picks the first provider alphabetically — which is
                        # AFRIKAANS. Pin English; users add languages via Komble.       # PDF backend for zathura
mpv                     # video player (decorationless, themeless — ideal)
mpv-mpris               # mpv → MPRIS bridge, so the dock's now-playing popup sees it
guvcview                # camera app (photos + video) — tiny traditional GTK,
                        # the cheese-shaped hole in the default set
galculator              # calculator (GTK3, menubar — follows adw-gtk3 + accent)
mate-system-monitor     # task manager / resources (GTK3, menubar, no headerbar)
ffmpegthumbnailer       # video thumbnails in Nemo
# mounting + filesystem access for GTK apps (trash, network, MTP; cloud via GOA later)
gvfs
gvfs-mtp
gvfs-smb
rclone                  # ~/Google Drive mount (ewe-drive: one sign-in, files too)
fuse3                   # rclone mount's engine
udisks2
unzip
7zip                     # provides 7z (p7zip was dropped from the Arch repos)

# ── browser + editor ──────────────────────────────────────────────────────────
# Zed (official repo) is THE editor/IDE — GUI, default handler for every text
# mime, themed by colorscheme.sh (~/.config/zed/themes/ewe.json). micro covers
# $EDITOR in a TTY (git commit, visudo, ssh) — a GUI editor can't. neovim/vim
# stay dropped.
firefox
zed
micro

# ── desktop utilities ────────────────────────────────────────────────────────
swaybg
awww       # swww's Arch package name — animated GIF wallpapers + transitions
gpu-screen-recorder   # GPU-encoded capture + replay buffer — moved here from the AUR
grim
slurp
satty
cliphist
wl-clipboard
hyprpicker
brightnessctl
playerctl
libnotify                # notify-send — used by the low-battery watcher (Battery.qml)
jq
socat

# ── theming (GTK primary) + fonts ────────────────────────────────────────────
adw-gtk-theme
gnome-themes-extra
# GTK is the primary toolkit now, so theming flows through adw-gtk3 + gsettings.
# qt6ct just gives a dark Fusion palette to any stray Qt app you install (the shell
# itself is Quickshell/Qt but themed by Theme.qml). No more plasma-integration / kde
# platform theme — we ship no KDE apps.
qt6ct
librsvg                  # rsvg-convert — builds the Mocu cursor (phase 20 source step)
xorg-xcursorgen          # xcursorgen — builds the Mocu cursor
xmlstarlet               # cursor hotspot extraction for the Mocu build
noto-fonts
noto-fonts-emoji
ttf-jetbrains-mono-nerd
ttf-nerd-fonts-symbols-mono
inter-font
ttf-ubuntu-font-family  # THE DE face (Theme.fontText/Display + GTK font); Georgian
                        # falls back to Noto Sans Georgian via dotfiles/fontconfig

# ── version control (always) ─────────────────────────────────────────────────
# The front-end dev toolchain (git-delta, lazygit, github-cli, mise + the Node/LSP
# stack, ripgrep, fd, fzf, bat, cmake, meson) is OPT-IN — see packages/dev.list,
# installed only with `install.sh --dev` (which also runs `mise install`, phase 60).
git                     # VCS — user-facing + the AUR (paru) bootstrap needs it

# ── core GPU userspace (ALWAYS — the whole shell is GPU-accelerated) ──────────
# 64-bit Mesa + the Vulkan loader are mandatory; the per-vendor ICDs/VAAPI are
# added by phase 40. The gaming stack and ALL 32-bit (lib32-*) graphics are
# opt-in — see packages/gaming.list, installed only with `install.sh --gaming`.
mesa
vulkan-icd-loader
pciutils                # lspci — GPU/driver introspection (phase 40 'in use: xe' guard)
libva-utils             # vainfo — VAAPI verification (phase 90 postcheck, real HW)
vulkan-tools            # vulkaninfo — Vulkan device verification (phase 90 postcheck)

# ── system tuning ────────────────────────────────────────────────────────────
zram-generator

# ── build deps (AUR builds; paru bootstrap) ──────────────────────────────────
# base-devel is required by makepkg/paru. cmake/meson moved to dev.list (--dev) —
# paru pulls them as makedepends on demand for any AUR build that needs them.
base-devel
pacman-contrib          # checkupdates — the only safe update listing (Komble Updates view needs it)
expac                   # fast sync-DB dump — Komble's Browse descriptions come from it
